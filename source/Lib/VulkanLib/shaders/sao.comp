#version 460
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"

// Sample adaptive offset without clipping, a port of SampleAdaptiveOffset::offsetCTUnoClip / offsetBlockNoClip.
// One invocation per sample of one component. The CPU's sign-line recurrences reduce to two sign comparisons per
// sample; the start and end of each line follow the neighbour availability of the CTU exactly as on the CPU.
// Samples that SAO leaves alone keep their value in dst, which holds the same picture as src.

layout( local_size_x = 16, local_size_y = 16 ) in;

// SAO parameters of one CTU and component: type -1 (off), 0-3 (edge offset 0, 90, 135, 45 degrees) or 4 (band
// offset); avail is SampleAdaptiveOffset::ctuAvailability; offset holds 5 edge classes or 32 bands.
struct SaoCtu
{
  int     type;
  uint    avail;
  int16_t offset[32];
};
layout( buffer_reference, scalar, buffer_reference_align = 4 ) buffer SaoCtus { SaoCtu c[]; };

layout( push_constant, scalar ) uniform Push
{
  I16Buf  src;          // the picture before SAO
  I16Buf  dst;          // the picture being filtered, same layout as src
  SaoCtus params;       // [ctu * numComp + comp]
  int     origin;       // index of sample (0, 0) of the component
  int     stride;
  int     width;        // component size
  int     height;
  int     ctuW;         // CTU size in component samples
  int     ctuH;
  int     widthInCtus;
  int     numComp;
  int     comp;
  int     bitDepth;
  int     scaleX;       // component subsampling
  int     scaleY;
  int     numHorVb;     // virtual boundaries in luma samples
  int     numVerVb;
  int     horVb[3];
  int     verVb[3];
} pc;

int S( int x, int y ) { return int( pc.src.v[pc.origin + y * pc.stride + x] ); }

// SampleAdaptiveOffset::isCrossedByVirtualBoundaries and isProcessDisabled for a sample at (x, y) of a CTU whose
// luma area starts at (lumaX, lumaY). The boundary positions are converted to the component's CTU-local coordinates.
bool vbDisabled( int x, int y, int lumaX, int lumaY, int lumaW, int lumaH, bool checkVer, bool checkHor, int ctuX0, int ctuY0 )
{
  if( checkVer )
  {
    for( int i = 0; i < pc.numVerVb; i++ )
    {
      const int v = pc.verVb[i];
      if( lumaX <= v && v <= lumaX + lumaW )
      {
        const int p = ( v >> pc.scaleX ) - ctuX0;
        if( x == p || x == p - 1 )
        {
          return true;
        }
      }
    }
  }
  if( checkHor )
  {
    for( int i = 0; i < pc.numHorVb; i++ )
    {
      const int v = pc.horVb[i];
      if( lumaY <= v && v <= lumaY + lumaH )
      {
        const int p = ( v >> pc.scaleY ) - ctuY0;
        if( y == p || y == p - 1 )
        {
          return true;
        }
      }
    }
  }
  return false;
}

void main()
{
  const int gx = int( gl_GlobalInvocationID.x ), gy = int( gl_GlobalInvocationID.y );
  if( gx >= pc.width || gy >= pc.height )
  {
    return;
  }
  const int ctuX = gx / pc.ctuW, ctuY = gy / pc.ctuH;
  const SaoCtu p = pc.params.c[( ctuY * pc.widthInCtus + ctuX ) * pc.numComp + pc.comp];
  if( p.type < 0 )
  {
    return;
  }
  const int x0 = ctuX * pc.ctuW, y0 = ctuY * pc.ctuH;
  const int w  = min( pc.ctuW, pc.width - x0 ), h = min( pc.ctuH, pc.height - y0 );
  const int x  = gx - x0, y = gy - y0;
  const int cur = S( gx, gy );

  if( p.type == 4 )
  {
    const int shiftBits = pc.bitDepth - 5;
    pc.dst.v[pc.origin + gy * pc.stride + gx] = int16_t( cur + int( p.offset[cur >> shiftBits] ) );
    return;
  }

  const bool L = ( p.avail & 1u ) != 0u, R = ( p.avail & 2u ) != 0u, A = ( p.avail & 4u ) != 0u, B = ( p.avail & 8u ) != 0u;
  const bool AL = ( p.avail & 16u ) != 0u, AR = ( p.avail & 32u ) != 0u, BL = ( p.avail & 64u ) != 0u, BR = ( p.avail & 128u ) != 0u;
  const int startX = L ? 0 : 1, endX = R ? w : w - 1;
  // the CTU's luma area, for the virtual boundary test
  const int lumaX = x0 << pc.scaleX, lumaY = y0 << pc.scaleY, lumaW = w << pc.scaleX, lumaH = h << pc.scaleY;

  bool inRange;
  int  dxA, dyA, dxB, dyB;   // the two neighbours compared with the sample
  bool checkVer = true, checkHor = true;
  if( p.type == 0 )
  {
    inRange = x >= startX && x < endX;
    dxA = -1; dyA = 0; dxB = 1; dyB = 0;
    checkHor = false;
  }
  else if( p.type == 1 )
  {
    inRange = y >= ( A ? 0 : 1 ) && y < ( B ? h : h - 1 );
    dxA = 0; dyA = -1; dxB = 0; dyB = 1;
    checkVer = false;
  }
  else if( p.type == 2 )
  {
    if( y == 0 )
    {
      inRange = x >= ( AL ? 0 : 1 ) && x < ( A ? endX : 1 );
    }
    else if( y == h - 1 )
    {
      inRange = x >= ( B ? startX : w - 1 ) && x < ( BR ? w : w - 1 );
    }
    else
    {
      inRange = x >= startX && x < endX;
    }
    dxA = -1; dyA = -1; dxB = 1; dyB = 1;
  }
  else
  {
    if( y == 0 )
    {
      inRange = x >= ( A ? startX : w - 1 ) && x < ( AR ? w : w - 1 );
    }
    else if( y == h - 1 )
    {
      inRange = x >= ( BL ? 0 : 1 ) && x < ( B ? endX : 1 );
    }
    else
    {
      inRange = x >= startX && x < endX;
    }
    dxA = 1; dyA = -1; dxB = -1; dyB = 1;
  }
  if( !inRange )
  {
    return;
  }
  if( ( pc.numHorVb > 0 || pc.numVerVb > 0 ) && vbDisabled( x, y, lumaX, lumaY, lumaW, lumaH, checkVer, checkHor, x0, y0 ) )
  {
    return;
  }
  const int edgeType = sgn( cur - S( gx + dxA, gy + dyA ) ) + sgn( cur - S( gx + dxB, gy + dyB ) );
  pc.dst.v[pc.origin + gy * pc.stride + gx] = int16_t( cur + int( p.offset[edgeType + 2] ) );
}
