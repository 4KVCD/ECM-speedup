#version 460
#pragma use_vulkan_memory_model
// intra reconstruction of a picture on the GPU: persistent workgroups take the transform blocks from a queue of ready
// blocks; a block is ready when the blocks whose samples it reads are reconstructed (dependency lists and counts
// from the host: geometry and decoding order only), so independent blocks (the three components, distant parts of
// the picture) run at the same time and no workgroup waits on a block it holds.
// Per block: reference samples of the block's reference line (MRL; for ISP sub-partitions the CU's references, shifted
// along the split, and the previous sub-partition's samples) and their [1 2 1] filtering, prediction (planar,
// directional planar, DC, angular with PDPC and intra fusion, MIP, the intra bilateral filter) and reconstruction with
// the residual intra_resi computed beforehand for all blocks at once (with LMCS: scaled for chroma by the neighbouring
// luma, the bilateral filter on inverse-mapped samples); with sign prediction the signs are decided first from the
// prediction and the neighbours, and the residual computed again where a sign is negative. Every step follows the C++
// of IntraPrediction / MatrixIntraPrediction / TrQuant / DecCu.
// Modes the CPU cannot know without the reconstruction are derived in a node per CU before its blocks: the MPM lists
// (intra_modes.glsl), DIMD (intra_dimd.glsl), OBIC (intra_obic.glsl), intra merge (intra_merge.glsl, with the template
// costs of intra_timd.glsl) and TIMD (intra_timd.glsl); the blocks of DIMD, OBIC, intra merge and TIMD CUs blend the
// predictions of several modes.
#extension GL_GOOGLE_include_directive : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_memory_scope_semantics : require
#include "common.glsl"
#include "intra_common.glsl"

layout( local_size_x = 256 ) in;

// Vulkan memory model: the reconstruction and the done flags are written by one workgroup and read by others
// (device-scope coherent, done flags with release / acquire); the scratch is shared by the invocations of a workgroup
layout( buffer_reference, std430, buffer_reference_align = 2 ) coherent buffer CBufI16 { int16_t v[]; };
layout( buffer_reference, std430, buffer_reference_align = 4 ) coherent buffer CBufI32 { int v[]; };

#define SYNC() barrier()

// the features of a picture the pipeline is built for (specialization constants; GpuIntraRec.cpp's IntraRecVariant):
// a picture without them runs a pipeline without their code, whose mere presence slows every block (~15 % for DIMD)
layout( constant_id = 0 ) const bool WITH_DIMD = true;                 // DIMD and OBIC in nodes, their blending
layout( constant_id = 1 ) const bool WITH_DERIVED_TRANSFORMS = true;   // blocks with DERIVE_TRANSFORM
layout( constant_id = 2 ) const bool WITH_MERGE = true;                // intra merge CUs (and OBIC's merge neighbours)
layout( constant_id = 3 ) const bool WITH_TIMD = true;                 // TIMD CUs (with DIMD and intra merge)
layout( constant_id = 4 ) const bool WITH_TIMD_SAD = false;            // TIMD-SAD CUs (with TIMD; a picture's own pipeline)
layout( constant_id = 5 ) const bool WITH_TIMD_MERGE = false;          // TIMD merge CUs (with TIMD-SAD)
layout( constant_id = 6 ) const bool WITH_TMRL = false;                // TMRL CUs (with TIMD merge)
layout( constant_id = 7 ) const bool WITH_CCLM = false;                // CCLM blocks (with any of the above: ~30 % without DIMD)
layout( constant_id = 8 ) const bool WITH_CCCM = false;                // CCCM blocks (with CCLM)
layout( constant_id = 9 ) const bool WITH_CFLM = false;                // CFLM blocks (with CCCM: ~2 % for CCCM's)
layout( constant_id = 10 ) const bool WITH_CCP_MERGE = false;          // CCP merge blocks (with CFLM)
layout( constant_id = 11 ) const bool WITH_CCP_DERIVED = false;        // decoder-derived CCP fusion (with CCP merge)
// CCP merge / decoder-derived CCP fusion blocks with LFNST / NSPT (with decoder-derived CCP fusion) are the pipelines
// of intra_rec's second module (GpuLib's CMakeLists.txt compiles it with CCP_LFNST_MODULE defined), whose second merge
// prediction adds ~1M SPIR-V IDs (of the 4.19M a module may have) that the first module's pipelines do without
// the template costs of arms one sample thick (TIMD merge's and TMRL's templates: their SATD kernels)
const bool WITH_THIN_TEMPLATES = WITH_TIMD_MERGE || WITH_TMRL;

const int PAD     = 6;                        // interpFilterNumPadded (16 taps / 2 - 2)
const int ANG     = 1792;                     // angular reference buffers (the CPU's are larger; blocks <= 128 use < 1700)
const int MAX_MRL = 13;                       // the farthest reference line (multiRefIdx 12, its fusion line 13)
const int MAX_REF = 2 * ( 8 * 128 + 2 + MAX_MRL ) + 16; // reference line: top row (stride predSize + 1 + mrl), then the left column
const int WEAK4   = 5 * 32 * 16;              // offset of the weak 4-tap table in the filter buffer
const int BF_LUT  = WEAK4 + 32 * 4;           // the bilateral filter's LUT rows (26 x 48), size and MAD factors
const int BF_SIZE = BF_LUT + 26 * 48;
const int BF_MAD  = BF_SIZE + 64;
const int EXT_CUBIC = BF_MAD + 16;            // the 1/64 cubic filter of template predictions (64 x 4; intra_timd.glsl)
const int EXT_NTAP  = EXT_CUBIC + 64 * 4;     // the 1/64 N-tap tables of TIMD blocks ([taps 6,8,10,12,16][64][16])
const int BF_PRED = 0;                        // in s_tmp: the prediction (< 1024 samples: at most 512)
const int BF_BLK  = 512;                      // in s_tmp: the padded block ((W + 4) x (H + 4) <= 720)

shared int16_t s_ref[2][MAX_REF];             // refBufUnfiltered: the block's line (filtered in place when refFilter), the fusion line
shared int16_t s_tmp[MAX_REF];                // the reference filter's output; the bilateral filter's blocks
shared int16_t s_angA[2][ANG];                // refAbove, refAbove2nd
shared int16_t s_angL[2][ANG];                // refLeft, refLeft2nd
shared int16_t s_filters[WEAK4 + 32 * 4];     // the filter tables (copied once per workgroup)
shared int     s_dc;
shared int     s_ti;
shared int     s_next;                        // a dependent this workgroup released and continues with (-1: none)
shared int     s_deps[256];                   // the first dependents of the block (prefetched)
shared int     s_red[6];                      // workgroup sums
shared int16_t s_bfLut[48];                   // the bilateral filter's LUT row of the block's QP
shared int     s_mipBdry[8];                  // MIP: the reduced boundary (top, then left)
shared int     s_mipRed[64];                  // MIP: the reduced prediction (4 x 4 or 8 x 8)
shared int     s_predDimdMode;                // MIP / CCLM with LFNST / NSPT: their mode, a DIMD of the prediction(s)
// sign prediction (signPrediction; blocks of 4 x 4 to 32 x 32, at most 8 predicted signs)
shared int16_t s_spPred[32 * 32];             // the block's prediction, reconstructed once the signs are decided
shared int16_t s_spBorder[64];                // TU::predBorderResi: the residual the neighbours predict along the border
shared int16_t s_spBase[64];                  // the border of the residual with every predicted sign positive
shared int16_t s_spTempl[8 * 64];             // the templates of the predicted coefficients
// per border entry j, a sign hypothesis' border residual in two halves (16-bit sums, which suffice: the CPU's are
// Pel): at j * 16 + h the base minus twice the templates the low four hypothesis bits h select, and minus twice those
// the high four bits h select
shared int16_t s_spLow[64 * 16];
shared int16_t s_spHigh[64 * 16];
shared uint    s_spCost[256];                 // per sign hypothesis: its cost << 8 | the hypothesis
shared int16_t s_spCoef[32 * 32];             // the dequantized coefficients with the decided signs (nonzero region;
                                              // clipped to the 16-bit transform range), with LFNST its outputs over them
shared int16_t s_spStage1[32 * 32];           // their first inverse transform stage
shared int     s_secIn[64];                   // the LFNST / NSPT inputs (dequantized, in scan order)
shared int     s_lfnstOut[96];                // the LFNST outputs

shared int     s_mode;                        // the mode of a block whose mode is derived (intra_modes.glsl)
shared int     s_modesRead[MPM_NEIGHBOURS];   // the modes its derivation reads (modeRead)

Params P;      // the parameter block (loaded once)
int    g_ti;   // the block being reconstructed
bool   g_crs;       // LMCS chroma residual scaling of the block
int    g_crsScale;  // its scale (Reshape::calculateChromaAdj)
// blending (a DERIVE_DIMD block whose CU's DIMD blends, a DERIVE_OBIC or DERIVE_MERGE block): the predictions of the
// CU's modes (s_blendMode: DIMD's or the intra merge candidate's main mode, planar and blend modes, OBIC's modes) are
// summed per location dependence class (emitPred), weighted, in the workgroup's BLEND_ACC sums at the start of the
// scratch (Params::scratch; each class's N samples)
const int BLEND_ACC = 3 * 128 * 128;
const int BLEND_MAX = 8;
shared int s_blendNum;                 // the block's predictions (0: no blending)
shared int s_blendMode[BLEND_MAX];     // their modes,
shared int s_blendW[BLEND_MAX];        // weights (0: not predicted; dimdRelWeight, obicFusionWeight)
shared int s_blendClass[BLEND_MAX];    // and classes (dimdLocDep, obicLocDep: 0 none, 1 vertical, 2 horizontal; OBIC's
                                       // -1, see blendTotals)
shared int s_blendTot[3];              // the classes' total weights (blendTotals)
bool   g_blendSum;     // emitPred adds to the sums
bool   g_blendFirst;   // the first prediction (the main mode) sets them, the other classes' to 0
int    g_blendW;       // the prediction's weight
int    g_blendClass;   // its class
bool   g_blendTaps;    // DIMD: the prediction's filter length by its weight (JVET-AN0158)

#include "intra_modes.glsl"

// the classes' totals of the block's predictions as predIntraAng / generateDimdBuffersForLocDepBlending take them, one
// invocation: a class other than 1 (vertical) or 2 (horizontal) weighs in the first class's total, also one no class's
// blend takes - OBIC's -1, a mode only intra merge neighbours gave (DIMD's and intra merge's classes are 0 to 2); its
// blend then divides by more, unless the CPU blends that class by a shortcut - one prediction as it is, two or three
// by weights scaled to 64 where the total is a power of two, the last of them (in OBIC's order, as here) taking the
// rest - which the weights reproduce here. An intra merge candidate of no weights (no candidate at all) blends nothing
// and keeps the main mode's prediction. merge: a block of an intra merge CU
void blendTotals( bool merge )
{
  int tot[3] = int[3]( 0, 0, 0 );
  for( int k = 0; k < BLEND_MAX; k++ ) tot[s_blendClass[k] == 1 ? 1 : s_blendClass[k] == 2 ? 2 : 0] += s_blendW[k];
  if( merge && tot[0] == 0 && tot[1] == 0 && tot[2] == 0 )
  {
    s_blendW[0]     = 64;
    s_blendClass[0] = 0;
    tot[0]          = 64;
  }
  int num = 0, sum = 0, last = -1;   // the first class's predictions in its blend
  for( int k = 0; k < BLEND_MAX; k++ )
  {
    if( s_blendClass[k] == 0 && s_blendW[k] != 0 )
    {
      num++;
      sum += s_blendW[k];
      last = k;
    }
  }
  const int rest = WITH_MERGE ? tot[0] - sum : 0;   // the weight of class -1 (only with intra merge CUs)
  if( rest != 0 && num == 1 )
  {
    s_blendW[last] = tot[0];
  }
  else if( rest != 0 && num >= 2 && num <= 3 && ( tot[0] & ( tot[0] - 1 ) ) == 0 )
  {
    s_blendW[last] += rest;
  }
  for( int c = 0; c < 3; c++ ) s_blendTot[c] = tot[c];
}

// the mode of CU n: the host's (CU_KNOWN), or published by the CU's node, on which the reading block or node depends
int cuModeOf( int n )
{
  return CBufI32( P.cuMode ).v[n];
}

// the start of TIMD CU n's TimdOut (written by its node)
int timdOutBase( int n )
{
  return BufI32( P.timdData ).v[BufCu( P.cus ).v[n].timd] * TIMD_OUT;   // TimdHead::index
}

// whether TIMD CU n is a TIMD-SAD CU (TimdHead::sad; none outside the TIMD-SAD pipeline)
bool timdSadCu( int n )
{
  return WITH_TIMD_SAD && BufI32( P.timdData ).v[BufCu( P.cus ).v[n].timd + TIMD_HEAD_SAD] != 0;
}

// the start of the TimdOut fields TIMD CU n's blocks predict: its TIMD's, a TIMD-SAD CU's TIMD-SAD's (its prediction
// takes the *Sad fields throughout: initPredIntraParams, predIntraAng's TIMD-SAD branch), a TIMD merge CU's chosen
// candidate's
int timdPredBase( int n )
{
  return timdOutBase( n ) + ( timdSadCu( n ) ? TIMD_OUT_SAD : 0 );
}

// whether TIMD CU c is a TIMD merge CU (TimdHead::merge; none outside the TIMD merge pipeline)
bool timdMergeCu( Cu c )
{
  return WITH_TIMD_MERGE && BufI32( P.timdData ).v[c.timd + TIMD_HEAD_MERGE] != 0;
}

// the modes a CU's derivation reads (loaded by the invocations in parallel): luma the neighbours' at getSpatialIpm's
// positions (-1: none), chroma the co-located luma CU's in entry 0
int modeRead( Cu c, int k )
{
  const int n = c.kind == CU_MPM || c.kind == CU_TIMD ? c.nbr[k] : k == 0 ? c.lumaCu : -1;
  return n >= 0 ? cuModeOf( n ) : -1;
}

// an entry of the transform tables' directory (TR_TAB_*)
int trTab( int which )
{
  return BufI32( P.matrices ).v[P.trTables + which];
}

// PU::getWideAngle: the wide-angle index of a mode for a block of w x h (below 0 or above 66 for wide angles)
int puWideAngle( int w, int h, int mode )
{
  if( mode < 2 )
  {
    return mode;
  }
  const int deltaSize = abs( findMSB( w ) - findMSB( h ) );
  const int modeShift = deltaSize == 0 ? 0 : deltaSize == 1 ? 6 : deltaSize == 2 ? 10 : deltaSize == 3 ? 12 : deltaSize == 4 ? 14 : 15;
  if( w > h && mode < 2 + modeShift )
  {
    return mode + VDIA_IDX - 1;
  }
  if( h > w && mode > VDIA_IDX - modeShift )
  {
    return mode - ( VDIA_IDX + 1 );
  }
  return mode;
}

// PU::getNSPTIntraMode( PU::getWideAngle ) of a mode for a block of w x h: its wide angle in NSPT's numbering (the
// extended angles after the regular modes)
int nsptMode( int w, int h, int mode )
{
  const int extHalf = trTab( TR_TAB_EXT_MODES ) >> 1;
  const int wide    = puWideAngle( w, h, mode );
  return wide < 0 ? wide + extHalf + NUM_LUMA_MODE : wide >= NUM_LUMA_MODE ? wide + extHalf : wide;
}

// PU::getTransposeFlag of a mode in NSPT's numbering
bool nsptTranspose( int im )
{
  const int extHalf = trTab( TR_TAB_EXT_MODES ) >> 1;
  return ( im >= NUM_LUMA_MODE && im >= NUM_LUMA_MODE + extHalf ) || ( im < NUM_LUMA_MODE && im > DIA_IDX );
}

// the transform types (horizontal, vertical) of ECM's explicit MTS for a luma block of W x H (TrQuant::getTrTypes with
// MTSExt): kernel pair trIdx of the set of the size class and the mode's wide angle, clamped to 2 .. 66 (planar of
// directional planar index plIdx as its direction), the identity transform near horizontal / vertical. mode: the
// block's mode (67-mode set), the signalled one the identity transform's rule reads
ivec2 explicitMtsTypes( int W, int H, int mode, int plIdx, int trIdx )
{
  BufI32    mt   = BufI32( P.matrices );
  const int wide = puWideAngle( W, H, mode );
  int pm = wide < 0 ? 2 : wide >= NUM_LUMA_MODE ? VDIA_IDX : wide;
  if( pm == PLANAR_IDX )
  {
    pm = plIdx == 2 ? HOR_IDX : plIdx == 1 ? VER_IDX : pm;
  }
  const bool transposed = pm > DIA_IDX;
  const int  mdIdx = transposed ? NUM_LUMA_MODE + 1 - pm : pm;
  const int  szW = min( 3, findMSB( W ) - 2 ), szH = min( 3, findMSB( H ) - 2 );
  const int  set  = mt.v[trTab( TR_TAB_IPM_TO_SET ) + ( transposed ? szH * 4 + szW : szW * 4 + szH ) * 36 + mdIdx];
  const int  pair = mt.v[trTab( TR_TAB_SET ) + set * trTab( TR_TAB_SET_ROW ) + trIdx];
  int ver = mt.v[trTab( TR_TAB_IDX_TO_TR ) + pair * 2 + ( transposed ? 1 : 0 )];
  int hor = mt.v[trTab( TR_TAB_IDX_TO_TR ) + pair * 2 + ( transposed ? 0 : 1 )];
  if( trIdx == 3 && W <= 16 && H <= 16 )   // the signalled mode decides
  {
    const int limit = mt.v[trTab( TR_TAB_ID_LUT ) + ( findMSB( W ) - 2 ) * 3 + findMSB( H ) - 2];
    ver = abs( mode - HOR_IDX ) <= limit ? trTab( TR_TAB_IDTR ) : ver;
    hor = abs( mode - VER_IDX ) <= limit ? trTab( TR_TAB_IDTR ) : hor;
  }
  return ivec2( hor, ver );
}

// the offset in matrices of the inverse transform matrix of a type for a side of size samples (-1: none)
int trMatrix( int type, int size )
{
  return BufI32( P.matrices ).v[trTab( TR_TAB_MATRIX ) + type * 7 + findMSB( size ) - 1];
}

// the transforms of a derived mode (Tu::derive & DERIVE_TRANSFORM), as the host chooses them otherwise: the kernel
// pair of ECM's explicit MTS (explicitMtsTypes) and the LFNST / NSPT set, transposition and matrix of
// getFinalIntraModeForTransform's mode (planar of a directional planar index as its direction, the wide angle of the
// block, of the CU with ISP, in NSPT's numbering); a TIMD merge CU's block the types its chosen candidate gave on the
// sides that take them (DERIVE_INHERIT_*). mode: the CU's mode, which MTS takes, or a MIP / CCLM block's DIMD of its
// prediction(s) (MIP has no MTS with LFNST, chroma no MTS); LFNST / NSPT take a DIMD or OBIC CU's DIMD main mode
// instead (getFinalIntraModeForTransform's DIMD branch), with MTSS the mode and NSPT bucket chosen into the CU's
// DimdOut. plIdx: the CU's directional planar index
void selectTransform( inout Tu t, int mode, int plIdx )
{
  BufI32     mt      = BufI32( P.matrices );
  const bool luma    = t.comp == 0;
  const int  W = t.w, H = t.h;
  if( t.mtsSet != 0 )   // (luma only)
  {
    const ivec2 types = explicitMtsTypes( W, H, mode, plIdx, t.mtsSet - 1 );
    t.mtxV = trMatrix( types.y, H );
    t.mtxH = trMatrix( types.x, W );
  }
  if( WITH_TIMD_MERGE && ( t.derive & ( DERIVE_INHERIT_HOR | DERIVE_INHERIT_VER ) ) != 0 )
  {
    // (a type without a matrix of the side's size, for which the CPU would call no transform, keeps the host's: no
    // decodable stream has one)
    CBufI32   timdOut = CBufI32( P.timdOut );
    const int outBase = timdOutBase( t.cu );
    const int mtxH    = trMatrix( timdOut.v[outBase + TIMD_OUT_TR_HOR], W );
    const int mtxV    = trMatrix( timdOut.v[outBase + TIMD_OUT_TR_VER], H );
    t.mtxH = ( t.derive & DERIVE_INHERIT_HOR ) != 0 && mtxH >= 0 ? mtxH : t.mtxH;
    t.mtxV = ( t.derive & DERIVE_INHERIT_VER ) != 0 && mtxV >= 0 ? mtxV : t.mtxV;
  }
  if( t.secKind != SEC_NONE )
  {
    int im, bucket = t.secBucket;
    if( WITH_DIMD && ( t.derive & DERIVE_MTSS ) != 0 )
    {
      CBufI32 d = CBufI32( P.dimdOut );
      im = d.v[t.cu * DIMD_OUT + DIMD_OUT_MTSS_MODE];
      if( d.v[t.cu * DIMD_OUT + DIMD_OUT_MTSS_BUCKET] != 0 )   // PU::getNSPTBucket's second bucket
      {
        bucket = bucket == 0 ? 1 : 0;
      }
    }
    else
    {
      int m = WITH_DIMD && ( t.derive & ( DERIVE_DIMD | DERIVE_OBIC ) ) != 0 ? CBufI32( P.dimdOut ).v[t.cu * DIMD_OUT + DIMD_OUT_MODE] : mode;
      if( luma && m == PLANAR_IDX )
      {
        m = plIdx == 2 ? HOR_IDX : plIdx == 1 ? VER_IDX : m;
      }
      const bool ispLuma = luma && t.isp != 0;
      im = nsptMode( ispLuma ? t.cuW : W, ispLuma ? t.cuH : H, m );
    }
    t.secTranspose = nsptTranspose( im ) ? 1 : 0;
    if( t.secKind == SEC_LFNST )
    {
      const int set = mt.v[trTab( TR_TAB_LFNST_LUT ) + im], size = findMSB( t.secSize ) - 2;
      t.secMatrix = mt.v[trTab( TR_TAB_LFNST_MATRIX ) + ( size * 35 + set ) * 3 + t.secIdx];
      t.secLayout = mt.v[trTab( TR_TAB_LFNST_LAYOUT ) + size * 2 + t.secTranspose];
    }
    else
    {
      const int set   = mt.v[trTab( TR_TAB_NSPT_LUT ) + im];
      const int shape = t.secTranspose != 0 ? nsptShape( H, W ) : nsptShape( W, H );   // the kernel's block
      t.secMatrix = mt.v[trTab( TR_TAB_NSPT_MATRIX ) + ( ( shape * 35 + set ) * 3 + t.secIdx ) * 3 + bucket];
    }
  }
}

// verification: the transforms block g_ti took with derived transforms (Params::dbgParams' last fields), one invocation
void storeDbgTransforms( Tu t )
{
  const int o = g_ti * DBG_PARAMS;
  BufI32 dp = BufI32( P.dbgParams );
  dp.v[o + 12] = t.mtxV;  dp.v[o + 13] = t.mtxH;  dp.v[o + 14] = t.secMatrix;  dp.v[o + 15] = t.secTranspose;  dp.v[o + 16] = t.secLayout;
}

int filterTap( int taps, int frac, int i )
{
  int t = taps == 6 ? 0 : taps == 8 ? 1 : taps == 10 ? 2 : taps == 12 ? 3 : 4;
  return int( s_filters[( t * 32 + frac ) * 16 + i] );
}

int weak4( int frac, int i )
{
  return int( s_filters[WEAK4 + frac * 4 + i] );
}

// a reconstructed sample of an earlier block (all blocks read are reconstructed before the block is queued)
int recoAt( int comp, int x, int y )
{
  return int( CBufI16( P.plane[comp] ).v[P.origin[comp] + y * P.stride[comp] + x] );
}

#include "intra_dimd.glsl"
#include "intra_obic.glsl"

// MTSS's mode list (deriveDimdModeList's end) from its histograms in s_dimdHist: the three strongest modes of their
// sum, the first of equal ones first (updateCandListB2S moves a mode ahead of strictly weaker ones only, and fills the
// list with the first modes: all zero gives planar, DC, 2); one invocation
ivec3 mtssList()
{
  int amp[3]  = int[3]( -1, -1, -1 );
  int mode[3] = int[3]( 0, 0, 0 );
  for( int i = 0; i < NUM_LUMA_MODE; i++ )
  {
    const int h = s_dimdHist[i] + s_dimdHist[NUM_LUMA_MODE + i] + s_dimdHist[2 * NUM_LUMA_MODE + i];
    for( int j = 0; j < 3; j++ )
    {
      if( h > amp[j] )
      {
        for( int k = 2; k > j; k-- )
        {
          amp[k]  = amp[k - 1];
          mode[k] = mode[k - 1];
        }
        amp[j]  = h;
        mode[j] = i;
        break;
      }
    }
  }
  return ivec3( mode[0], mode[1], mode[2] );
}

// getFinalIntraModeForTransform with MTSS for the luma block of CU c (a DIMD, OBIC, intra merge or MIP CU: one block of
// its size, no directional planar index), one invocation: the LFNST / NSPT mode in NSPT's numbering and whether NSPT takes
// its second bucket. mode1: the mode without MTSS; second: the mode MTSS tries first (-1: none); list: MTSS's mode
// list. A mode whose LFNST set or transposition differs from the first one's is taken: second, else the list's last
// entry where any entry differs (the CPU's loop over the list does not stop at the first), else its first; NSPT takes
// the first mode in its second bucket instead where the chosen one is within 2 of it
ivec2 mtssChoice( Cu c, int mode1, int second, ivec3 list )
{
  BufI32     mt         = BufI32( P.matrices );
  const int  lut        = trTab( TR_TAB_LFNST_LUT );
  const int  im         = nsptMode( c.w, c.h, mode1 );
  const bool transposed = nsptTranspose( im );
  int  test = 0, mode2 = mode1;
  bool valid = false;
  if( second >= 0 )
  {
    mode2 = second;
    test  = nsptMode( c.w, c.h, second );
    valid = mt.v[lut + test] != mt.v[lut + im] || nsptTranspose( test ) != transposed;
  }
  if( !valid )
  {
    for( int i = 0; i < 3; i++ )
    {
      mode2 = list[i];
      test  = nsptMode( c.w, c.h, list[i] );
      valid = valid || mt.v[lut + test] != mt.v[lut + im] || nsptTranspose( test ) != transposed;
    }
  }
  if( !valid )
  {
    mode2 = list[0];
    test  = nsptMode( c.w, c.h, list[0] );
  }
  const bool secondBucket = c.mtssNspt != 0 && abs( mode2 - mode1 ) <= 2;
  return ivec2( secondBucket ? im : test, secondBucket ? 1 : 0 );
}

int clip3i( int lo, int hi, int v )
{
  return min( max( v, lo ), hi );
}

int asPel( int v )   // the int16 Pel the CPU stores
{
  return int( int16_t( v ) );
}

// LMCS: the forward and inverse luma mappings (Reshape's LUTs)
int fwdLut( int v ) { return BufI32( P.lmcs ).v[v]; }
int invLut( int v ) { return BufI32( P.lmcs ).v[P.lmcsLutSize + v]; }

// Reshape::scalePel: the residual scaled by scale / 2^11 (CSCALE_FP_PREC), magnitude rounded; scale is an int16_t there
int scalePel( int val, int scale, int maxVal )
{
  const int sc   = int( int16_t( scale ) );
  const int sign = val < 0 ? -1 : 0;
  val = clip3i( ~maxVal, maxVal, val );
  val = ( val ^ sign ) - sign;
  int tmp = ( val * sc + ( 1 << 10 ) ) >> 11;
  tmp = ( tmp ^ sign ) - sign;
  return clip3i( -32768, 32767, tmp );
}

// the reference samples of line `line` (refSource: xFillReferenceSamples' unit availability and padding, or for ISP
// initIntraPatternChTypeISP) into s_ref[dst], all invocations, no barrier, every sample fetched by its own invocation:
// the samples the prediction can read (the host's or intra_deps' superset; entries beyond are never read), top entries
// 0 .. readMax[line][0] at 0, left entries 0 .. readMax[line][1] at predStride
void fillReferencePar( Tu t, int line, int dst, int predStride, int lid, int NT )
{
  const int valueDC = 1 << ( t.bitDepth - 1 );
  const int numTop  = t.readMax[line][0] + 1;
  for( int e = lid; e < numTop + t.readMax[line][1] + 1; e += NT )
  {
    const bool top = e < numTop;
    const int  idx = top ? e : e - numTop;
    int sx, sy;
    const int v = refSource( t, line, top, idx, sx, sy ) ? recoAt( t.comp, sx, sy ) : valueDC;
    s_ref[dst][top ? idx : idx + predStride] = int16_t( v );
  }
}

// reconstruction of sample (x, y) of block t from its prediction and residual (debug copy of the prediction for the
// verification)
void reconstruct( Tu t, int x, int y, int pr, int re )
{
  const int i = y * t.w + x;
  if( g_crs )   // the residual the CPU reconstructs with (and records, for the comparison)
  {
    re = scalePel( re, g_crsScale, ( 1 << t.bitDepth ) - 1 );
    if( pc.verify != 0 )
    {
      BufI16( P.dbgResi ).v[t.dbgOffset + i] = int16_t( re );
    }
  }
  CBufI16( P.plane[t.comp] ).v[P.origin[t.comp] + ( t.y + y ) * P.stride[t.comp] + t.x + x] = int16_t( clip3i( t.recMin, t.recMax, pr + re ) );
  if( pc.verify != 0 )
  {
    BufI16( P.dbgPred ).v[t.dbgOffset + i] = int16_t( pr );
  }
}

// predicted sample (x, y) of block t: reconstructed with the residual intra_resi computed, or one written in intra_rec
// (Tu::resiFrom, read device-coherent): with joint CbCr by the pair's other block (sign prediction's decision, or the
// Cb block whose transforms depend on a derived mode), or by this block (inChainResidual, which sets its local copy's
// resiFrom to itself); with sign prediction kept until the signs are decided (signPrediction)
void storeRecon( Tu t, int x, int y, int pr )
{
  if( t.spCoded >= 0 )
  {
    s_spPred[y * t.w + x] = int16_t( pr );
    return;
  }
  const int o  = t.dbgOffset + y * t.w + x;
  const int re = t.resiFrom >= 0 ? int( CBufI16( P.dbgResi ).v[o] ) : int( BufI16( P.dbgResi ).v[o] );
  reconstruct( t, x, y, pr, re );
}

int  cccmFusionBlend( Tu t, int x, int y, int pr );   // (intra_cccm.glsl)
void cflmStore( Tu t, int x, int y, int pr );

// sample (x, y) of the predicted region: reconstructed if it lies in the block (the region of an ISP sub-partition 1
// or 2 wide is 4 wide; the CPU predicts it once and each sub-partition takes its columns); a block of LM chroma fusion
// or CCP merge fusion with CCCM blends its final prediction with the CCCM one, a CFLM block keeps it for its models
// (cflmPrediction)
void storeRegion( Tu t, int x, int y, int pr )
{
  const int bx = x - ( t.x - t.regX );
  if( bx >= 0 && bx < t.w )
  {
    const int fusion = WITH_CCCM ? lmFusionType( t ) : 0;
    if( WITH_CFLM && fusion > 1 )
    {
      cflmStore( t, bx, y, pr );
    }
    else
    {
      storeRecon( t, bx, y, fusion == 1 ? cccmFusionBlend( t, bx, y, pr ) : pr );
    }
  }
}

// a predicted sample of the region: reconstructed now, kept for the bilateral filter, or added to the blending's sums
// (stored and loaded device-coherent: another invocation may handle the sample in the next prediction)
void emitPred( Tu t, int x, int y, int pr, bool bf )
{
  if( WITH_DIMD && g_blendSum )
  {
    CBufI32   acc = CBufI32( P.scratch );
    const int o   = int( gl_WorkGroupID.x ) * BLEND_ACC + y * t.regW + x;
    const int N   = t.regW * t.h;
    for( int c = 0; c < 3; c++ )
    {
      const int add = c == g_blendClass ? pr * g_blendW : 0;
      if( g_blendFirst )
      {
        acc.v[o + c * N] = add;
      }
      else if( add != 0 )
      {
        acc.v[o + c * N] += add;
      }
    }
    return;
  }
  if( bf )
  {
    s_tmp[BF_PRED + y * t.regW + x] = int16_t( pr );
  }
  else
  {
    storeRegion( t, x, y, pr );
  }
}

// MIP's upsampling (MatrixIntraPrediction::predictionUpsampling) in closed form, each sample on its own: the CPU's
// running sums give before * (factor - pos) + behind * pos, rounded and shifted once. Horizontal stage: reduced row r
// at column x, between the reduced samples; the first segment starts from the left reference of the last row of the
// vertical segment r
int mipHor( int r, int x, int ps, int upH, int upV, int predStride )
{
  if( upH == 1 )
  {
    return s_mipRed[r * ps + x];
  }
  const int j = x / upH, pos = x % upH + 1, lg = findMSB( upH );
  const int before = j == 0 ? int( s_ref[0][predStride + ( r + 1 ) * upV] ) : s_mipRed[r * ps + j - 1];
  return ( before * ( upH - pos ) + s_mipRed[r * ps + j] * pos + ( 1 << ( lg - 1 ) ) ) >> lg;
}

// the MIP prediction of sample (x, y): the vertical stage over the horizontal one; the first segment starts from the
// top reference
int mipSample( int x, int y, int ps, int upH, int upV, int predStride )
{
  if( upV == 1 )
  {
    return mipHor( y, x, ps, upH, upV, predStride );
  }
  const int i = y / upV, pos = y % upV + 1, lg = findMSB( upV );
  const int before = i == 0 ? int( s_ref[0][1 + x] ) : mipHor( i - 1, x, ps, upH, upV, predStride );
  return ( before * ( upV - pos ) + mipHor( i, x, ps, upH, upV, predStride ) * pos + ( 1 << ( lg - 1 ) ) ) >> lg;
}

// buildHistogram's subsampling with MTSS: every second column and row of regions of this many samples or more
const int MIN_MTSS_SIZE = 128;

// the LFNST / NSPT mode of MIP block t of W x H (DERIVE_MIP_DIMD), all invocations, s_dimdHist's first histogram zeroed
// before, ending with a barrier: deriveIpmForTransform over the prediction (buildHistogram's 3x3 gradients at the
// samples inside the block, subsampled from MIN_MTSS_SIZE samples on; the strongest mode, mipDimdMode, and the second
// strongest, dimdDerivedIntraDir2nd), into s_predDimdMode and for the comparison the CU's DimdOut; with MTSS
// (DERIVE_MTSS) MTSS's choice among them and the mode list of the CU's node, into the DimdOut that selectTransform reads
void mipTransformMode( Tu t, int W, int H, int ps, int upH, int upV, int predStride, int lid, int NT )
{
  const int iw = W - 2, ih = H - 2, step = iw * ih >= MIN_MTSS_SIZE ? 2 : 1;
  const int cols = ( iw + step - 1 ) / step, rows = ( ih + step - 1 ) / step;
  for( int i = lid; i < cols * rows; i += NT )
  {
    const int   x = 1 + ( i % cols ) * step, y = 1 + ( i / cols ) * step;
    const ivec2 g = sobel3x3( mipSample( x - 1, y - 1, ps, upH, upV, predStride ), mipSample( x, y - 1, ps, upH, upV, predStride ),
                              mipSample( x + 1, y - 1, ps, upH, upV, predStride ),
                              mipSample( x - 1, y, ps, upH, upV, predStride ), mipSample( x + 1, y, ps, upH, upV, predStride ),
                              mipSample( x - 1, y + 1, ps, upH, upV, predStride ), mipSample( x, y + 1, ps, upH, upV, predStride ),
                              mipSample( x + 1, y + 1, ps, upH, upV, predStride ) );
    if( g.x != 0 || g.y != 0 )
    {
      atomicAdd( s_dimdHist[dimdAngle( g )], abs( g.x ) + abs( g.y ) );
    }
  }
  SYNC();
  if( lid == 0 )
  {
    int firstAmp = 0, secondAmp = 0, first = 0, second = 0;
    for( int i = 0; i < NUM_LUMA_MODE; i++ )
    {
      const int amp = s_dimdHist[i];
      if( amp > firstAmp )
      {
        secondAmp = firstAmp;
        second    = first;
        firstAmp  = amp;
        first     = i;
      }
      else if( amp > secondAmp )
      {
        secondAmp = amp;
        second    = i;
      }
    }
    s_predDimdMode = first;
    CBufI32   o    = CBufI32( P.dimdOut );
    const int base = t.cu * DIMD_OUT;
    o.v[base + DIMD_OUT_MODE]      = first;
    o.v[base + DIMD_OUT_TR_SECOND] = second;
    if( ( t.derive & DERIVE_MTSS ) != 0 )
    {
      const ivec3 list   = ivec3( o.v[base + DIMD_OUT_MTSS_LIST], o.v[base + DIMD_OUT_MTSS_LIST + 1], o.v[base + DIMD_OUT_MTSS_LIST + 2] );
      const ivec2 choice = mtssChoice( BufCu( P.cus ).v[t.cu], first, second, list );
      o.v[base + DIMD_OUT_MTSS_MODE]   = choice.x;
      o.v[base + DIMD_OUT_MTSS_BUCKET] = choice.y;
    }
  }
  controlBarrier( gl_ScopeWorkgroup, gl_ScopeWorkgroup, gl_StorageSemanticsBuffer | gl_StorageSemanticsShared,
                  gl_SemanticsAcquireRelease );
}

// workgroup sums of a and b (all invocations, uniform control flow; the slots are zero before)
ivec2 wgSum2( int a, int b, int slot )
{
  const int sa = subgroupAdd( a ), sb = subgroupAdd( b );
  if( subgroupElect() )
  {
    atomicAdd( s_red[slot], sa );
    atomicAdd( s_red[slot + 1], sb );
  }
  SYNC();
  return ivec2( s_red[slot], s_red[slot + 1] );
}

#include "intra_timd.glsl"
#include "intra_merge.glsl"

// ----- a TIMD block's prediction parameters (TIMD's luma path of initPredIntraParams, bExtIntraDir)

// the parameters of a mode of the 131-mode set: its wide angle getWideAngleExt's (checkWA) or getTimdWideAngleExt's,
// angles in 1/64 samples, PDPC as for the regular modes, planar's reference filter, none for angular modes (JVET-AM0104)
// and always the cubic filter (JVET-AM0163); fusion and the bilateral filter apart (GpuIntraRec.cpp's copy:
// applyTimdModeParams)
void timdModeParams( inout Tu t, int mode, bool checkWA )
{
  const int W = t.regW, H = t.h;
  const int predMode = checkWA ? timdWideAngle( W, H, mode ) : timdWaipAngle( W, H, mode );
  t.dirMode        = mode;
  t.isModeVer      = predMode >= EXT_DIA_IDX ? 1 : 0;
  t.intraPredAngle = 0;
  t.absInvAngle    = 0;
  t.angularScale   = 0;
  t.gradPDPC       = 0;
  bool pdpc = W >= 4 && H >= 4 && t.mrl == 0;
  const int angMode = t.isModeVer != 0 ? predMode - EXT_VER_IDX : -( predMode - EXT_HOR_IDX );
  if( mode > DC_IDX && mode <= EXT_VDIA_IDX )
  {
    const int absAng = EXT_ANG_TABLE[abs( angMode )];
    t.absInvAngle    = EXT_INV_ANG_TABLE[abs( angMode )];
    t.intraPredAngle = angMode < 0 ? -absAng : absAng;
    if( angMode < 0 )
    {
      pdpc = false;
    }
    else if( angMode > 0 )
    {
      t.angularScale = min( 2, findMSB( t.isModeVer != 0 ? H : W ) - ( findMSB( 3 * t.absInvAngle - 2 ) - 8 ) );
      if( t.angularScale < 0 )
      {
        t.angularScale = ( findMSB( W ) + findMSB( H ) - 2 ) >> 2;
        t.gradPDPC     = 1;
      }
    }
  }
  if( ( t.derive & DERIVE_NO_PDPC ) != 0 )
  {
    pdpc       = false;
    t.gradPDPC = 0;
  }
  const bool smoothing = ( t.derive & DERIVE_NO_SMOOTHING ) == 0 && t.mrl == 0 && t.disableRefFilter == 0;
  t.refFilter = mode == PLANAR_IDX && smoothing && W * H > 32 ? 1 : 0;
  t.useCubic  = 1;
  t.applyPDPC = pdpc ? 1 : 0;
  t.plIdx     = 0;
}

// a TIMD block's blend (xGetNumTapsTIMD): the filter lengths of its mode (x) and its secondary mode (y), from its modes
// of nonzero weight: one angular mode alone 8, with DC 16, else 12 (the CPU's TIMD-SAD / merge counterparts aside)
ivec2 timdBlendTaps( int outBase )
{
  CBufI32    timdOut = CBufI32( P.timdOut );
  const int  mode    = timdOut.v[outBase + TIMD_OUT_MODE];
  const bool mainAngular = mode > DC_IDX;
  int numAngular = mainAngular ? 1 : 0, numPlanar = !mainAngular && mode != DC_IDX ? 1 : 0, total = 1;
  if( timdOut.v[outBase + TIMD_OUT_WEIGHT + 1] > 0 )
  {
    const int secondary = timdOut.v[outBase + TIMD_OUT_SECONDARY];
    numAngular += secondary > DC_IDX ? 1 : 0;
    numPlanar += secondary == PLANAR_IDX ? 1 : 0;
    total++;
  }
  if( timdOut.v[outBase + TIMD_OUT_WEIGHT + 2] > 0 )
  {
    numPlanar += timdOut.v[outBase + TIMD_OUT_NON_ANG] != DC_IDX ? 1 : 0;
    total++;
  }
  if( numAngular == 1 && numPlanar == 0 )
  {
    const int taps = total == numAngular ? 8 : 16;   // (no DC: 8)
    return mainAngular ? ivec2( taps, 0 ) : ivec2( 0, taps );
  }
  return ivec2( 12, 12 );
}

// TIMD's fusion of a blend (JVET-AG0128): the secondary mode predicted from the next reference line only where both
// modes are angular, of wide angles at most 8 apart (4 for blocks up to 128 samples) on one side of the horizontal and the
// vertical, or the mode blends with itself; the main mode without fusion
bool timdBlendFusion( int outBase, int W, int H )
{
  CBufI32    timdOut   = CBufI32( P.timdOut );
  const int  mode      = timdOut.v[outBase + TIMD_OUT_MODE], secondary = timdOut.v[outBase + TIMD_OUT_SECONDARY];
  const int  wideMode  = timdOut.v[outBase + TIMD_OUT_CHECK_WA] != 0 ? timdWideAngle( W, H, mode ) : timdWaipAngle( W, H, mode );
  const int  wideSecondary = timdOut.v[outBase + TIMD_OUT_SEC_CHECK_WA] != 0 ? timdWideAngle( W, H, secondary )
                                                                             : timdWaipAngle( W, H, secondary );
  const bool close = abs( wideMode - wideSecondary ) <= ( W * H > 128 ? 8 : 4 )
                     && ( wideMode - EXT_HOR_IDX ) * ( wideSecondary - EXT_HOR_IDX ) >= 0
                     && ( wideMode - EXT_VER_IDX ) * ( wideSecondary - EXT_VER_IDX ) >= 0;
  return ( mode > DC_IDX && secondary > DC_IDX && close ) || ( mode == secondary && mode > DC_IDX );
}

// bifApplyLut (the LUT row in s_bfLut, offset base: 0 distance 1, 16 diagonal, 32 distance 2)
int bfLut( int diff, int base, int cutBits, int bdShift )
{
  const int bitsRound  = 1 << ( cutBits - 2 );
  const int bitsRound2 = bitsRound + ( 1 << ( cutBits - 1 ) );
  const int v    = abs( diff );
  const int idx  = min( ( v + bitsRound ) >> cutBits, 15 );
  const int idx2 = min( ( v + bitsRound2 ) >> cutBits, 15 );
  const int w0   = ( ( int( s_bfLut[base + idx] ) + int( s_bfLut[base + idx2] ) + 1 ) >> 1 ) << bdShift;
  return diff < 0 ? -w0 : w0;
}

// the reference lines an angular prediction reads (xPredIntraAng's weightMode): the block's (4), the block's and the
// next one weighed 3 : 1 (intra fusion, 3), or the next one alone (0: a TIMD blend's secondary mode)
const int FUSE_NONE   = 0;
const int FUSE_BOTH   = 1;
const int FUSE_SECOND = 2;

// planar's reference sample i of the block's line: the filtered one in s_tmp where a TIMD blend keeps both
int planarRef( int i, bool filtered )
{
  return filtered ? int( s_tmp[i] ) : int( s_ref[0][i] );
}

// main / side reference arrays of line l (main = above for vertical modes)
int mainR( bool isVer, int l, int i ) { return isVer ? int( s_angA[l][i] ) : int( s_angL[l][i] ); }
int sideR( bool isVer, int l, int i ) { return isVer ? int( s_angL[l][i] ) : int( s_angA[l][i] ); }
void mainW( bool isVer, int l, int i, int v ) { if( isVer ) s_angA[l][i] = int16_t( v ); else s_angL[l][i] = int16_t( v ); }

// the luma interpolation filter of xPredIntraAng for fraction frac (cubic N-tap table or the Gaussian formulas); ext:
// a TIMD block's 1/64 fractions (its N-tap tables, read from the filter buffer)
int lumaConv( bool isVer, int l, int base, int taps, bool cubic, bool big, int frac, bool ext )
{
  int sum = 0;
  if( WITH_TIMD && ext )
  {
    const int t = taps == 6 ? 0 : taps == 8 ? 1 : taps == 10 ? 2 : taps == 12 ? 3 : 4;
    BufI32    f = BufI32( P.filters );
    for( int k = 0; k < taps; k++ ) sum += mainR( isVer, l, base + k ) * f.v[EXT_NTAP + ( t * 64 + frac ) * 16 + k];
  }
  else if( cubic )
  {
    for( int k = 0; k < taps; k++ ) sum += mainR( isVer, l, base + k ) * filterTap( taps, frac, k );
  }
  else
  {
    int f[6];
    if( big )
    {
      f[0] = 16 - ( frac >> 1 ); f[1] = 64 - 3 * ( frac >> 1 ); f[2] = 96 - frac;
      f[3] = 64 + frac;          f[4] = 16 + 3 * ( frac >> 1 ); f[5] = frac >> 1;
    }
    else
    {
      f[0] = 0; f[1] = 64 - ( frac << 1 ); f[2] = 128 - ( frac << 1 ); f[3] = 64 + ( frac << 1 ); f[4] = frac << 1; f[5] = 0;
    }
    for( int k = 0; k < 6; k++ ) sum += mainR( isVer, l, base + k ) * int( int16_t( f[k] ) );
  }
  return sum;
}

// xPredIntraAng's reference arrays refMain / refSide of a prediction of W x H at angle `angle` (absInvAngle) from
// reference line mrl in s_ref[0] (stride predStride, arms topRefLength / leftRefLength long), into s_angA[0] / s_angL[0]
// (above / left), all invocations; the caller synchronizes before reading them. The arrays are zero on entry (cleared
// after use, like the CPU's persistent buffers); every entry is computed directly from the line (the CPU's copies,
// padding, end replication and negative-angle extension). Returns the indices of the line's corner in the main and the
// side array (refMain, refSide before their offset by multiRefIdx)
ivec2 angularArrays( bool isVer, int W, int H, int angle, int absInvAngle, int topRefLength, int leftRefLength, int mrl,
                     int predStride, bool disableRefFilter, int maxPel, int lid, int NT )
{
  const int sizeSide = isVer ? H : W;
  if( angle < 0 )
  {
    // the corner and the arms, then the main arm extended below its start by the side arm projected onto it (the weak
    // 4-tap filter, or where the SPS disables the reference filter the nearer sample)
    for( int i = lid; i < W + PAD + 2 + mrl; i += NT ) s_angA[0][H + PAD + i] = s_ref[0][i];
    for( int i = lid; i < H + PAD + 2 + mrl; i += NT ) s_angL[0][W + PAD + i] = s_ref[0][predStride + i];
    const int mainBase  = sizeSide + PAD;
    const int sideOff   = isVer ? predStride : 0;   // side entry j (copied above) = the reference line itself
    const int sideRange = sizeSide + 2 + mrl;
    for( int k = -( sizeSide + PAD ) + lid; k <= -1; k += NT )
    {
      const int frac32precision = ( -k * absInvAngle + 8 ) >> 4;
      const int intpel = frac32precision >> 5, fracpel = frac32precision & 31;
      const int left  = int( s_ref[0][sideOff + clip3i( 0, sideRange, intpel )] );
      const int right = int( s_ref[0][sideOff + clip3i( 0, sideRange, intpel + 1 )] );
      int v;
      if( disableRefFilter )
      {
        v = fracpel > 15 ? right : left;
      }
      else
      {
        const int lm1 = int( s_ref[0][sideOff + clip3i( 0, sideRange, intpel - 1 )] );
        const int rp1 = int( s_ref[0][sideOff + clip3i( 0, sideRange, intpel + 2 )] );
        v = clip3i( 0, maxPel, ( weak4( fracpel, 0 ) * lm1 + weak4( fracpel, 1 ) * left + weak4( fracpel, 2 ) * right + weak4( fracpel, 3 ) * rp1 + 32 ) >> 6 );
      }
      mainW( isVer, 0, mainBase + k, v );
    }
    return ivec2( mainBase, ( isVer ? W : H ) + PAD );
  }
  // above: PAD copies of entry 0, then the top row (read on past the row, as the CPU's memcpy does); left alike; the
  // main array's end (entry refLength + multiRefIdx) is replicated over maxIndex + PAD entries
  const int refLength = isVer ? topRefLength : leftRefLength;
  const int log2Ratio = findMSB( W ) - findMSB( H );
  const int maxIndex  = ( mrl << max( 0, isVer ? log2Ratio : -log2Ratio ) ) + 6;
  const int end0 = PAD + refLength + mrl;
  const int val  = int( s_ref[0][( isVer ? 0 : predStride ) + refLength + mrl] );
  const int lenA = isVer ? end0 + maxIndex + PAD + 1 : PAD + topRefLength + mrl + PAD;
  const int lenL = isVer ? PAD + leftRefLength + mrl + PAD : end0 + maxIndex + PAD + 1;
  for( int j = lid; j < lenA; j += NT )
  {
    const int v = isVer && j > end0 ? val : j < PAD ? int( s_ref[0][0] ) : int( s_ref[0][j - PAD] );
    s_angA[0][j] = int16_t( v );
  }
  for( int j = lid; j < lenL; j += NT )
  {
    const int v = !isVer && j > end0 ? val : j < PAD ? int( s_ref[0][predStride] ) : int( s_ref[0][predStride + j - PAD] );
    s_angL[0][j] = int16_t( v );
  }
  return ivec2( PAD, PAD );
}

#include "intra_tmrl.glsl"
#include "intra_cclm.glsl"
#include "intra_cccm.glsl"
#include "intra_ccp.glsl"

// the residual of block c in intra_rec (a derived mode's transforms, DERIVE_TRANSFORM, or sign prediction's
// recomputation), as intra_resi computes it for the others: the dequantized coefficients, those at the positions in
// negativeAt (x | y << 16, -1: none) negated (for NSPT only its inputs, in scan order, into s_secIn), with LFNST its
// outputs over them (s_spCoef); all invocations, ending with a barrier. firstStageRows then gives the first stage of
// some rows, secondStage the residual sample by sample from that
void prepareCoefficients( Tu c, int negativeAt[8], int lid, int NT )
{
  BufI32    mt      = BufI32( P.matrices );
  BufI8     kernels = BufI8( P.secKernels );
  BufI32    cf      = BufI32( P.coeffs );
  const int nzR = c.nzRows, nzC = c.nzCols, addDq = dequantAdd( c );
  if( c.secKind == SEC_NSPT )
  {
    for( int i = lid; i < c.secNumIn; i += NT )
    {
      const int pos = mt.v[c.secScan + i], x = pos & 0xffff, y = pos >> 16;
      int       q   = y < nzR && x < nzC ? cf.v[c.coeffOffset + y * nzC + x] : 0;
      for( int k = 0; k < 8; k++ )
      {
        q = negativeAt[k] == pos ? -q : q;
      }
      s_secIn[i] = q != 0 ? dequant( c, q, addDq, mt, P.qcsOffset ) : 0;
    }
    SYNC();
    return;
  }
  for( int i = lid; i < nzR * nzC; i += NT )
  {
    const int pos = ( i % nzC ) | ( ( i / nzC ) << 16 );
    int       q   = cf.v[c.coeffOffset + i];
    for( int k = 0; k < 8; k++ )
    {
      q = negativeAt[k] == pos ? -q : q;
    }
    s_spCoef[i] = int16_t( q != 0 ? dequant( c, q, addDq, mt, P.qcsOffset ) : 0 );
  }
  SYNC();
  if( c.secKind == SEC_LFNST )
  {
    for( int i = lid; i < c.secNumIn; i += NT )
    {
      const int pos = mt.v[c.secScan + i];
      s_secIn[i] = int( s_spCoef[( pos >> 16 ) * nzC + ( pos & 0xffff )] );
    }
    SYNC();
    for( int j = lid; j < c.secRowLength; j += NT )
    {
      int sum = 0;
      for( int k = 0; k < c.secNumIn; k++ ) sum += s_secIn[k] * int( kernels.v[c.secMatrix + k * c.secRowLength + j] );
      s_lfnstOut[j] = clip3i( c.trMin, c.trMax, ( sum + 64 ) >> 7 );
    }
    SYNC();
    for( int j = lid; j < c.secRowLength; j += NT )
    {
      const int pos = mt.v[c.secLayout + j];
      s_spCoef[( pos >> 16 ) * nzC + ( pos & 0xffff )] = int16_t( s_lfnstOut[j] );
    }
    SYNC();
  }
}

// the first stage of rows y0 .. y0 + rows - 1 of block c (not NSPT): s_spStage1[xf * rows + y - y0] for the
// coefficient columns xf < nzCols (rows * nzCols <= 1024), from prepareCoefficients' coefficients (prepared), or
// dequantizing the recorded levels as intra_resi does (without LFNST: ECM's transforms up to 128 x 128 keep all
// coefficients, TU_256); all invocations, ending with a barrier
void firstStageRows( Tu c, int y0, int rows, bool prepared, int lid, int NT )
{
  BufI32    mt    = BufI32( P.matrices );
  BufI32    cf    = BufI32( P.coeffs );
  const int nzR   = c.nzRows, nzC = c.nzCols, H = c.h, addDq = dequantAdd( c );
  const int rnd1  = 1 << ( c.shift1 - 1 );
  for( int i = lid; i < nzC * rows; i += NT )
  {
    const int xf = i / rows, y = y0 + i % rows;
    int sum = 0;
    for( int k = 0; k < nzR; k++ )
    {
      int v;
      if( prepared )
      {
        v = int( s_spCoef[k * nzC + xf] );
      }
      else
      {
        const int q = cf.v[c.coeffOffset + k * nzC + xf];
        v = q != 0 ? dequant( c, q, addDq, mt, P.qcsOffset ) : 0;
      }
      sum += mt.v[c.mtxV + k * H + y] * v;
    }
    s_spStage1[i] = int16_t( clip3i( c.trMin, c.trMax, ( sum + rnd1 ) >> c.shift1 ) );
  }
  SYNC();
}

// prepareCoefficients and the first stage of the whole block (sign prediction's blocks, at most 32 x 32)
void firstStage( Tu c, int negativeAt[8], int lid, int NT )
{
  prepareCoefficients( c, negativeAt, lid, NT );
  if( c.secKind != SEC_NSPT )
  {
    firstStageRows( c, 0, c.h, true, lid, NT );
  }
}

// the residual sample (x, y) of block c: NSPT's matrix times its inputs, or the second stage of the first stage of
// rows y0 .. y0 + rows - 1 (firstStageRows)
int secondStage( Tu c, int x, int y, int y0, int rows )
{
  const int W = c.w, H = c.h;
  if( c.secKind == SEC_NSPT )
  {
    BufI8     kernels = BufI8( P.secKernels );
    const int shift   = c.shift1 + c.shift2 - 7;
    const int jj      = c.secTranspose != 0 ? x * H + y : y * W + x;
    int sum = 0;
    for( int k = 0; k < c.secNumIn; k++ ) sum += s_secIn[k] * int( kernels.v[c.secMatrix + k * c.secRowLength + jj] );
    return clip3i( c.trMin, c.trMax, ( sum + ( 1 << ( shift - 1 ) ) ) >> shift );
  }
  BufI32 mt = BufI32( P.matrices );
  int sum = 0;
  for( int k = 0; k < c.nzCols; k++ ) sum += mt.v[c.mtxH + k * W + x] * int( s_spStage1[k * rows + y - y0] );
  return clip3i( c.trMin, c.trMax, ( sum + ( 1 << ( c.shift2 - 1 ) ) ) >> c.shift2 );
}

// the residual of a block whose transforms depend on a derived mode (DERIVE_TRANSFORM, without sign prediction),
// computed before its prediction (a MIP block's after it: mipTransformMode) in chunks of rows whose first stage fits
// s_spStage1 and stored (device-coherent) where intra_resi stores the others', with joint CbCr also the other block's
// (which waits for this one); a barrier with buffer semantics makes it visible to the invocations that read it at the
// reconstruction (storeRecon)
void inChainResidual( Tu t, int lid, int NT )
{
  const bool prepared = t.secKind != SEC_NONE;   // LFNST / NSPT: their inputs and outputs in shared memory
  if( prepared )
  {
    const int none[8] = int[8]( -1, -1, -1, -1, -1, -1, -1, -1 );
    prepareCoefficients( t, none, lid, NT );
  }
  const int  W = t.w, H = t.h;
  const int  chunk   = t.secKind == SEC_NSPT ? H : min( H, 1024 / t.nzCols );
  const bool crCoded = abs( t.jccr ) == 3;   // joint CbCr: the Cb block holds Cr's coefficients, gets the derived residual
  for( int y0 = 0; y0 < H; y0 += chunk )
  {
    const int rows = min( chunk, H - y0 );
    if( t.secKind != SEC_NSPT )
    {
      firstStageRows( t, y0, rows, prepared, lid, NT );
    }
    for( int i = lid; i < rows * W; i += NT )
    {
      const int x = i % W, y = y0 + i / W, o = y * W + x;
      const int coded = secondStage( t, x, y, y0, rows );
      if( t.jccr != 0 )
      {
        const int derived = jccrDerived( t.jccr, coded );
        CBufI16( P.dbgResi ).v[t.dbgOffset + o]  = int16_t( crCoded ? derived : coded );
        CBufI16( P.dbgResi ).v[t.jccrOffset + o] = int16_t( crCoded ? coded : derived );
      }
      else
      {
        CBufI16( P.dbgResi ).v[t.dbgOffset + o] = int16_t( coded );
      }
    }
    SYNC();   // s_spStage1 is the next rows'
  }
  controlBarrier( gl_ScopeWorkgroup, gl_ScopeWorkgroup, gl_StorageSemanticsBuffer, gl_SemanticsAcquireRelease );
}

// sign prediction's data of block c (with a derived mode's transforms, which intra_resi skipped) as intra_resi
// computes it for the others: the border of the residual with every predicted sign positive (s_spBase: the left
// column bottom-up, then the top row) and per predicted coefficient its template (s_spTempl: the border of the
// residual of the coefficient alone with the amplitude 1 << 8, times its dequantized magnitude, >> 8; DCT-II / MTS:
// one product per stage, NSPT: the matrix entry, LFNST: through the LFNST into its region and both stages, one
// coefficient after the other). All invocations, ending with a barrier; s_spCoef and s_spStage1 are free afterwards
void signPredData( Tu c, int n, int lid, int NT )
{
  BufI32    sp      = BufI32( P.signPred );
  BufI32    mt      = BufI32( P.matrices );
  BufI8     kernels = BufI8( P.secKernels );
  BufI32    cf      = BufI32( P.coeffs );
  const int W = c.w, H = c.h, len = W + H, nzR = c.nzRows, nzC = c.nzCols, addDq = dequantAdd( c );
  const int rnd1 = 1 << ( c.shift1 - 1 ), rnd2 = 1 << ( c.shift2 - 1 ), nsptShift = c.shift1 + c.shift2 - 7;
  const int none[8] = int[8]( -1, -1, -1, -1, -1, -1, -1, -1 );
  firstStage( c, none, lid, NT );
  for( int j = lid; j < len; j += NT )
  {
    s_spBase[j] = int16_t( j < H ? secondStage( c, 0, H - 1 - j, 0, H ) : secondStage( c, j - H, 0, 0, H ) );
  }
  SYNC();
  if( c.secKind != SEC_LFNST )
  {
    for( int i = lid; i < n * len; i += NT )
    {
      const int k = i / len, j = i % len;
      const int pos = sp.v[c.spOffset + SP_POS + k], px = pos & 0xffff, py = pos >> 16;
      const int r = j < H ? H - 1 - j : 0, col = j < H ? 0 : j - H;
      int basis;
      if( c.secKind == SEC_NSPT )
      {
        int scanIdx = 0;   // the coefficient's index in the scan (the predicted ones lie among the first 16)
        while( scanIdx < c.secNumIn && mt.v[c.secScan + scanIdx] != pos )
        {
          scanIdx++;
        }
        const int jj = c.secTranspose != 0 ? col * H + r : r * W + col;
        const int k8 = scanIdx < c.secNumIn ? int( kernels.v[c.secMatrix + scanIdx * c.secRowLength + jj] ) : 0;
        basis = clip3i( c.trMin, c.trMax, ( 256 * k8 + ( 1 << ( nsptShift - 1 ) ) ) >> nsptShift );
      }
      else
      {
        const int stage1 = clip3i( c.trMin, c.trMax, ( mt.v[c.mtxV + py * H + r] * 256 + rnd1 ) >> c.shift1 );
        basis = clip3i( c.trMin, c.trMax, ( mt.v[c.mtxH + px * W + col] * stage1 + rnd2 ) >> c.shift2 );
      }
      const int coeffVal = dequant( c, cf.v[c.coeffOffset + py * nzC + px], addDq, mt, P.qcsOffset );
      s_spTempl[i] = int16_t( ( coeffVal * basis + 128 ) >> 8 );   // a Pel
    }
    SYNC();
    return;
  }
  for( int k = 0; k < n; k++ )
  {
    const int pos = sp.v[c.spOffset + SP_POS + k];
    int scanIdx = 0;
    while( scanIdx < c.secNumIn && mt.v[c.secScan + scanIdx] != pos )
    {
      scanIdx++;
    }
    for( int i = lid; i < nzR * nzC; i += NT )
    {
      s_spCoef[i] = int16_t( 0 );
    }
    SYNC();
    for( int j = lid; j < c.secRowLength && scanIdx < c.secNumIn; j += NT )
    {
      const int lp = mt.v[c.secLayout + j];
      s_spCoef[( lp >> 16 ) * nzC + ( lp & 0xffff )] =
        int16_t( clip3i( c.trMin, c.trMax, ( 256 * int( kernels.v[c.secMatrix + scanIdx * c.secRowLength + j] ) + 64 ) >> 7 ) );
    }
    SYNC();
    for( int i = lid; i < nzC * H; i += NT )
    {
      const int xf = i / H, y = i % H;
      int sum = 0;
      for( int ky = 0; ky < nzR; ky++ ) sum += mt.v[c.mtxV + ky * H + y] * int( s_spCoef[ky * nzC + xf] );
      s_spStage1[xf * H + y] = int16_t( clip3i( c.trMin, c.trMax, ( sum + rnd1 ) >> c.shift1 ) );
    }
    SYNC();
    const int coeffVal = dequant( c, cf.v[c.coeffOffset + ( pos >> 16 ) * nzC + ( pos & 0xffff )], addDq, mt, P.qcsOffset );
    for( int j = lid; j < len; j += NT )
    {
      const int r = j < H ? H - 1 - j : 0, col = j < H ? 0 : j - H;
      int sum = 0;
      for( int xf = 0; xf < nzC; xf++ ) sum += mt.v[c.mtxH + xf * W + col] * int( s_spStage1[xf * H + r] );
      const int basis = clip3i( c.trMin, c.trMax, ( sum + rnd2 ) >> c.shift2 );
      s_spTempl[k * len + j] = int16_t( ( coeffVal * basis + 128 ) >> 8 );   // a Pel
    }
    SYNC();
  }
}

// sign prediction, decoder side (TrQuant::predCoeffSigns), once the block is predicted (into s_spPred), then its
// reconstruction (all invocations). The border the neighbours predict (TU::predBorderResi: twice the reconstructed
// sample next to the block minus the one beyond it, or the mid-level value at the picture's left / top edge, minus
// the prediction; the left column bottom-up, then the top row; only the left column at the top edge and the top row
// at the left edge count) is compared with the border of the residual of each sign hypothesis: that of intra_resi
// with every predicted sign positive, minus twice the template of each negative one (as two halves), in 16 bits
// like the CPU's Pel (with LMCS chroma scaling, reshapeChroma, scaled). The sums of absolute differences,
// shifted left by 8 with the hypothesis in the low bits (bit b: predicted coefficient n - 1 - b negative), rank the
// hypotheses; the signs are then decided in order: the coded sign says whether the prediction from the best
// hypothesis was right, and after a wrong one the best is searched again among the hypotheses that agree with the
// signs decided. Where a decided sign is negative the residual is computed again (dequantization, LFNST or NSPT and
// both transform stages as in intra_resi, with joint CbCr also the other component's, for the other block of the pair,
// which waits for this one). A block whose transforms depend on a derived mode (DERIVE_TRANSFORM; chosen into t before)
// gets its data here (signPredData) and its residual computed in any case.
void signPrediction( Tu t, int lid, int NT )
{
  Tu c = t.spCoded == g_ti ? t : BufTu( P.tus ).v[t.spCoded];   // the block with the coefficients
  const bool inChain = WITH_DERIVED_TRANSFORMS && ( c.derive & DERIVE_TRANSFORM ) != 0;
  if( inChain && t.spCoded != g_ti )   // the other block of a joint CbCr pair, in the same CU (CCLM: its DIMD, found too)
  {
    const bool cclmDimd = WITH_CCLM && ( c.derive & DERIVE_CCLM_DIMD ) != 0;
    selectTransform( c, cclmDimd ? s_predDimdMode : s_mode, cclmDimd ? 0 : BufCu( P.cus ).v[c.cu].plIdx );
  }
  const int W = t.w, H = t.h, N = W * H, len = W + H;
  BufI32    sp   = BufI32( P.signPred );
  BufI16    resi = BufI16( P.dbgResi );
  const int n = sp.v[c.spOffset + SP_NUM], codedSigns = sp.v[c.spOffset + SP_SIGNS];
  const bool useLeft = t.x != 0 || t.y == 0, useTop = t.y != 0 || t.x == 0;
  const int  first = useLeft ? 0 : H, last = useTop ? len : H;
  if( inChain )
  {
    signPredData( c, n, lid, NT );
  }
  for( int j = lid; j < len; j += NT )
  {
    const bool left = j < H;
    const int  x = left ? 0 : j - H, y = left ? H - 1 - j : 0;   // the block's sample at border entry j
    int predicted = 1 << ( t.bitDepth - 1 );
    if( left ? t.x != 0 : t.y != 0 )
    {
      const int nextTo = left ? recoAt( t.comp, t.x - 1, t.y + y ) : recoAt( t.comp, t.x + x, t.y - 1 );
      const int beyond = left ? recoAt( t.comp, t.x - 2, t.y + y ) : recoAt( t.comp, t.x + x, t.y - 2 );
      predicted = asPel( 2 * nextTo - beyond );
    }
    s_spBorder[j] = int16_t( predicted - int( s_spPred[y * W + x] ) );
    if( !inChain )
    {
      s_spBase[j] = resi.v[t.dbgOffset + y * W + x];
    }
  }
  for( int i = lid; i < n * len && !inChain; i += NT )
  {
    s_spTempl[i] = int16_t( sp.v[c.spOffset + SP_TEMPLATES + i] );
  }
  SYNC();
  for( int i = lid; i < 16 * len; i += NT )   // the halves (hypothesis bit b selects coefficient n - 1 - b)
  {
    const int j = i >> 4, h = i & 15;
    int low = int( s_spBase[j] ), high = 0;
    for( int b = 0; b < 4; b++ )
    {
      if( ( ( h >> b ) & 1 ) != 0 && b < n )
      {
        low -= 2 * int( s_spTempl[( n - 1 - b ) * len + j] );
      }
      if( ( ( h >> b ) & 1 ) != 0 && b + 4 < n )
      {
        high -= 2 * int( s_spTempl[( n - 5 - b ) * len + j] );
      }
    }
    s_spLow[i]  = int16_t( low );
    s_spHigh[i] = int16_t( high );
  }
  SYNC();
  // the cost of each hypothesis s: its border residual is the sum of the halves its low and high four bits select
  const int maxPel = ( 1 << t.bitDepth ) - 1;
  for( int s = lid; s < ( 1 << n ); s += NT )
  {
    const int low = s & 15, high = s >> 4;
    uint cost = 0;
    for( int j = first; j < last; j++ )
    {
      int v = asPel( int( s_spLow[j * 16 + low] ) + int( s_spHigh[j * 16 + high] ) );
      if( g_crs )
      {
        v = scalePel( v, g_crsScale, maxPel );
      }
      cost += uint( abs( int( s_spBorder[j] ) - v ) );
    }
    s_spCost[s] = ( cost << 8 ) | uint( s );
  }
  SYNC();
  // the decision, made alike by every subgroup (no barrier, no shared copy)
  uint minIdx = 0, base = 0, signMask = 1u << n;
  bool wrong    = true;   // the previous prediction was wrong (or none yet): search the best hypothesis again
  int  negative = 0;      // bit k: predicted coefficient k is negative
  for( int k = 0; k < n; k++ )
  {
    if( wrong )
    {
      uint m = 0xffffffffu;
      for( uint idx = base + gl_SubgroupInvocationID; idx < base + signMask; idx += gl_SubgroupSize )
      {
        m = min( m, s_spCost[idx] );
      }
      minIdx = subgroupMin( m ) & 0xffu;
    }
    signMask >>= 1;
    const bool predSign = ( minIdx & signMask ) != 0;
    wrong = ( ( codedSigns >> k ) & 1 ) != 0;   // the coded sign: whether the predicted one was wrong
    if( predSign != wrong )
    {
      negative |= 1 << k;
      base += signMask;
    }
  }
  const bool recompute = negative != 0 || inChain;
  if( recompute )   // with the decided signs (the positions of the negative ones, x | y << 16, else -1)
  {
    int negativeAt[8];
    for( int k = 0; k < 8; k++ )
    {
      negativeAt[k] = k < n && ( ( negative >> k ) & 1 ) != 0 ? sp.v[c.spOffset + SP_POS + k] : -1;
    }
    firstStage( c, negativeAt, lid, NT );
  }
  // the second stage, sample by sample, and the reconstruction; the coded residual is this block's
  const int derivedOffset = abs( c.jccr ) == 3 ? c.dbgOffset : c.jccrOffset;
  for( int i = lid; i < N; i += NT )
  {
    const int x = i % W, y = i / W;
    int re;
    if( recompute )
    {
      re = secondStage( c, x, y, 0, H );
      if( c.jccr != 0 )
      {
        CBufI16( P.dbgResi ).v[derivedOffset + i] = int16_t( jccrDerived( c.jccr, re ) );
      }
      if( pc.verify != 0 )
      {
        resi.v[t.dbgOffset + i] = int16_t( re );
      }
    }
    else
    {
      re = int( resi.v[t.dbgOffset + i] );
    }
    reconstruct( t, x, y, int( s_spPred[i] ), re );
  }
}

// the end of a block or node: its results (device-coherent stores of all invocations: samples, a node's mode) happen
// before its dependents (d0 .. d1 in depList, the first ones prefetched in s_deps) are released; the last dependency of
// a block to finish takes it over (one per block, the workgroup continues with it) or queues it
void releaseDependents( int d0, int d1, int lid, int NT )
{
  controlBarrier( gl_ScopeWorkgroup, gl_ScopeQueueFamily, gl_StorageSemanticsBuffer, gl_SemanticsAcquireRelease );
  for( int k = lid; k < d1 - d0; k += NT )
  {
    const int d = k < 256 ? s_deps[k] : BufI32( P.depList ).v[d0 + k];
    if( atomicAdd( CBufI32( P.depCount ).v[d], -1, gl_ScopeQueueFamily, gl_StorageSemanticsBuffer, gl_SemanticsAcquireRelease ) == 1 )
    {
      if( atomicCompSwap( s_next, -1, d ) != -1 )
      {
        const int pos = atomicAdd( CBufI32( P.counter ).v[1], 1 );
        atomicStore( CBufI32( P.queue ).v[pos], d, gl_ScopeQueueFamily, gl_StorageSemanticsBuffer, gl_SemanticsRelease );
      }
    }
  }
  if( lid == 0 )
  {
    atomicAdd( CBufI32( P.counter ).v[2], 1 );   // finished blocks and nodes
  }
}

void main()
{
  const int lid = int( gl_LocalInvocationID.x );
  const int NT  = int( gl_WorkGroupSize.x );
  P = BufParams( pc.params ).p;
  if( BufI32( P.depStart ).v[pc.numTus] > P.edgeCap )   // intra_deps found more dependencies than fit: the host redoes it
  {
    return;
  }

  for( int i = lid; i < WEAK4 + 32 * 4; i += NT )   // filter taps fit int16 (TFilterCoeff)
  {
    s_filters[i] = int16_t( BufI32( P.filters ).v[i] );
  }
  for( int i = lid; i < ANG; i += NT )   // the angular arrays are zero between blocks
  {
    s_angA[0][i] = int16_t( 0 ); s_angL[0][i] = int16_t( 0 );
    s_angA[1][i] = int16_t( 0 ); s_angL[1][i] = int16_t( 0 );
  }
  if( lid == 0 )
  {
    s_next = -1;
  }
  for( ;; )
  {
    if( lid < 6 )
    {
      s_red[lid] = 0;
    }
    // the next block: the dependent this workgroup released last, else a queue position and (once filled) the
    // block at it; blocks handed over directly never enter the queue, so a position may stay empty: the workgroup
    // stops when all blocks are reconstructed
    SYNC();
    if( lid == 0 )
    {
      int b = s_next;
      s_next = -1;
      if( b < 0 )
      {
        b = pc.numTus;
        const int pos = atomicAdd( CBufI32( P.counter ).v[0], 1 );
        if( pos < pc.numTus )
        {
          for( ;; )
          {
            const int q = atomicLoad( CBufI32( P.queue ).v[pos], gl_ScopeQueueFamily, gl_StorageSemanticsBuffer, gl_SemanticsAcquire );
            if( q >= 0 )
            {
              b = q;
              break;
            }
            if( atomicLoad( CBufI32( P.counter ).v[2], gl_ScopeQueueFamily, 0, gl_SemanticsRelaxed ) >= pc.numTus )
            {
              break;
            }
          }
        }
      }
      s_ti = b;
    }
    SYNC();
    g_ti = s_ti;
    if( g_ti >= pc.numTus )
    {
      break;
    }
    Tu t = BufTu( P.tus ).v[g_ti];
    // the dependents, prefetched (their release ends the block)
    const int d0 = BufI32( P.depOffset ).v[g_ti], d1 = BufI32( P.depOffset ).v[g_ti + 1];
    if( lid < d1 - d0 )
    {
      s_deps[lid] = BufI32( P.depList ).v[d0 + lid];
    }
    // ----- a CU's node (intra_modes.glsl): the mode from the parsed syntax and the modes it reads (the neighbours' or
    // the co-located luma CU's, the host's or published by the nodes of those CUs, on which it depends), published for
    // the CU's blocks and the CUs reading it; first the CU's DIMD (intra_dimd.glsl: from the reconstruction around the
    // CU, on whose blocks it depends), the mode of a DIMD CU and the first entries of an MPM list; an OBIC CU's modes
    // then from its neighbours' (intra_obic.glsl: published by the nodes of those CUs, on which it depends); an intra
    // merge CU's parameters from its neighbours', ranked by template costs (intra_merge.glsl); a TIMD CU's modes from
    // template costs of its MPM list's modes and more, a TIMD merge CU's from its TIMD neighbours', ranked by template
    // costs (intra_timd.glsl); a TMRL CU's mode and reference line by template costs of a list's modes on several lines,
    // a chroma TMRL CU's also by the co-located luma block's prediction (intra_tmrl.glsl); with MTSS the LFNST / NSPT
    // mode of the CU's block (mtssList, mtssChoice)
    if( ( t.derive & DERIVE_NODE ) != 0 )
    {
      const Cu c = BufCu( P.cus ).v[t.cu];
      if( lid < MPM_NEIGHBOURS )   // the modes read, loaded at once
      {
        s_modesRead[lid] = modeRead( c, lid );
      }
      const bool dimd = WITH_DIMD && c.dimd >= 0;
      if( dimd )
      {
        dimdHistograms( c, lid, NT );
      }
      SYNC();
      DimdOut d;   // invocation 0's
      int dimdModes[3] = int[3]( -1, -1, -1 );
      if( lid == 0 )
      {
        if( dimd && ( c.kind == CU_CHROMA_DIMD || c.kind == CU_CHROMA_TMRL ) )   // after the co-located luma mode's
        {                                                                        // (s_modesRead[0])
          dimdModes[0] = dimdChromaSelect( s_modesRead[0], dimdModes[1] );
          CBufI32( P.dimdOut ).v[t.cu * DIMD_OUT + DIMD_OUT_MODE]   = dimdModes[0];
          CBufI32( P.dimdOut ).v[t.cu * DIMD_OUT + DIMD_OUT_SECOND] = dimdModes[1];
        }
        else if( dimd )
        {
          d = dimdSelect( c.w, c.h );
          dimdStore( t.cu, d );
          dimdModes = int[3]( d.mode, d.blendMode[0], d.blendMode[1] );
        }
      }
      int cuMode = -1;       // invocation 0's
      int timdSecond = -1;   // a TIMD CU's second mode for MTSS (invocation 0's)
      if( WITH_DIMD && c.kind == CU_OBIC )
      {
        SYNC();   // dimdSelect has read the histograms whose memory OBIC's takes
        obicHistogram( c, lid, NT );
        if( lid == 0 )
        {
          cuMode = obicSelect( c, d );
        }
      }
      else if( WITH_DIMD && WITH_MERGE && c.kind == CU_MERGE )   // intra_merge.glsl (no DIMD of its own)
      {
        cuMode = mergeNode( c, t.cu, t.bitDepth, ( t.derive & DERIVE_NO_PDPC ) != 0, lid, NT );
      }
      else if( WITH_TIMD_MERGE && c.kind == CU_TIMD && timdMergeCu( c ) )   // intra_timd.glsl, from its candidates
      {
        cuMode = timdMergeNode( c, t.bitDepth, ( t.derive & DERIVE_NO_PDPC ) != 0, timdSecond, lid, NT );
      }
      else if( WITH_TMRL && c.kind == CU_TMRL )   // intra_tmrl.glsl, its mode list with its DIMD
      {
        cuMode = tmrlNode( t, c, dimdModes, t.bitDepth, lid, NT );
      }
      else if( WITH_TMRL && c.kind == CU_CHROMA_TMRL )   // intra_tmrl.glsl, its mode list with its DIMD chroma
      {
        cuMode = chromaTmrlNode( t, c, s_modesRead[0], dimdModes, lid, NT );
      }
      else if( WITH_TIMD && c.kind == CU_TIMD )   // intra_timd.glsl, its MPM list with its DIMD
      {
        int modes[MPM_NEIGHBOURS];
        for( int k = 0; k < MPM_NEIGHBOURS; k++ )
        {
          modes[k] = s_modesRead[k];
        }
        cuMode = timdNode( c, t.cu, modes, dimdModes, t.bitDepth, ( t.derive & DERIVE_NO_PDPC ) != 0, timdSecond, lid, NT );
      }
      else if( lid == 0 && c.kind != CU_KNOWN )
      {
        int modes[MPM_NEIGHBOURS];
        for( int k = 0; k < MPM_NEIGHBOURS; k++ )
        {
          modes[k] = s_modesRead[k];
        }
        cuMode = deriveCuMode( c, modes, dimdModes );
      }
      if( lid == 0 && c.kind != CU_KNOWN )   // (a MIP CU's node, CU_KNOWN, keeps the host's mode)
      {
        CBufI32( P.cuMode ).v[t.cu] = cuMode;
      }
      // MTSS (a DIMD, OBIC, intra merge, TIMD or MIP CU with mdirIdx): its mode list from histograms of its own
      // (deriveDimdModeList), once dimdSelect and obicSelect have read theirs, then the LFNST / NSPT mode and bucket of its
      // luma block (a MIP block chooses them itself, from its prediction: mipTransformMode)
      if( WITH_DIMD && WITH_DERIVED_TRANSFORMS && c.mtss >= 0 )
      {
        SYNC();
        dimdHistogramsOf( c.mtss, MTSS_CALLS, c.w, c.h, lid, NT );
        if( lid == 0 && c.kind == CU_KNOWN )
        {
          const ivec3 list = mtssList();
          for( int k = 0; k < 3; k++ )
          {
            CBufI32( P.dimdOut ).v[t.cu * DIMD_OUT + DIMD_OUT_MTSS_LIST + k] = list[k];
          }
        }
        else if( lid == 0 )
        {
          // the mode without MTSS (a DIMD or OBIC CU's DIMD main mode, intra merge's, TIMD's) and the one MTSS tries
          // first: DIMD's second strongest, an OBIC CU's second OBIC mode (-1 only without OBIC modes, which no
          // decodable stream has: planar keeps it in range), a blended TIMD CU's secondary, none for intra merge
          const int   mode   = c.kind == CU_MERGE || c.kind == CU_TIMD ? cuMode : d.mode;
          const int   second = c.kind == CU_DIMD ? d.trSecond
                               : c.kind == CU_OBIC ? max( CBufI32( P.obicOut ).v[c.obic * OBIC_OUT + OBIC_OUT_MODE + 1], PLANAR_IDX )
                               : c.kind == CU_TIMD ? timdSecond : -1;
          const ivec3 list   = mtssList();
          const ivec2 choice = mtssChoice( c, mode, second, list );
          CBufI32     o      = CBufI32( P.dimdOut );
          const int   base   = t.cu * DIMD_OUT;
          for( int k = 0; k < 3; k++ )
          {
            o.v[base + DIMD_OUT_MTSS_LIST + k] = list[k];
          }
          o.v[base + DIMD_OUT_MTSS_MODE]   = choice.x;
          o.v[base + DIMD_OUT_MTSS_BUCKET] = choice.y;
        }
      }
      releaseDependents( d0, d1, lid, NT );
      continue;
    }
    // ----- a block of a CU whose mode its node derived: the parameters for the mode
    if( ( t.derive & DERIVE_MODE ) != 0 )
    {
      if( lid == 0 )
      {
        s_mode = cuModeOf( t.cu );
      }
      // a DIMD CU's predictions where its DIMD blends (dimdPrediction), an intra merge CU's alike from its chosen
      // candidate (always), an OBIC CU's: its modes but those not set; a TIMD CU's where its modes blend: its mode, its
      // secondary mode and its non-angular one (TimdOut; the weight of one not blended 0); a CCP merge block's of
      // fusion with DIMD chroma: the merge prediction (no mode), then the DIMD chroma mode's, each weighed 1
      const bool dimdCu  = WITH_DIMD && ( t.derive & DERIVE_DIMD ) != 0, obicCu = WITH_DIMD && ( t.derive & DERIVE_OBIC ) != 0;
      const bool mergeCu = WITH_DIMD && WITH_MERGE && ( t.derive & DERIVE_MERGE ) != 0;
      const bool timdCu  = WITH_TIMD && ( t.derive & DERIVE_TIMD ) != 0;
      const bool ccpCu   = WITH_CCP_MERGE && WITH_DIMD && ( t.derive & DERIVE_CCP_DIMD ) != 0;
      const int  timdOut = timdCu ? timdPredBase( t.cu ) : 0;
      if( ( dimdCu || obicCu || mergeCu || timdCu || ccpCu ) && lid < BLEND_MAX )
      {
        int mode = -1, w = 0, cls = 0;
        if( ccpCu )
        {
          mode = lid == 1 ? cuModeOf( t.cu ) : -1;
          w    = lid < 2 ? 1 : 0;
        }
        else if( timdCu )
        {
          CBufI32 o = CBufI32( P.timdOut );
          if( lid < 3 && o.v[timdOut + TIMD_OUT_BLENDED] != 0 )
          {
            mode = o.v[timdOut + ( lid == 0 ? TIMD_OUT_MODE : lid == 1 ? TIMD_OUT_SECONDARY : TIMD_OUT_NON_ANG )];
            w    = max( o.v[timdOut + TIMD_OUT_WEIGHT + lid], 0 );
            cls  = o.v[timdOut + TIMD_OUT_LOC_DEP + lid];
          }
        }
        else if( dimdCu || mergeCu )
        {
          dimdPrediction( t.cu, lid, mode, w, cls );
        }
        else if( lid < OBIC_MODES )
        {
          CBufI32   b = CBufI32( P.obicOut );
          const int o = BufCu( P.cus ).v[t.cu].obic * OBIC_OUT;
          mode = b.v[o + OBIC_OUT_MODE + lid];
          w    = mode >= 0 ? b.v[o + OBIC_OUT_WEIGHT + lid] : 0;
          cls  = b.v[o + OBIC_OUT_LOC_DEP + lid];
        }
        s_blendMode[lid]  = mode;
        s_blendW[lid]     = w;
        s_blendClass[lid] = cls;
        if( lid == 0 )
        {
          s_blendNum = ccpCu ? 2 : obicCu ? OBIC_MODES
                       : timdCu ? ( CBufI32( P.timdOut ).v[timdOut + TIMD_OUT_BLENDED] != 0 ? 3 : 0 )
                       : mergeCu || CBufI32( P.dimdOut ).v[t.cu * DIMD_OUT + DIMD_OUT_BLENDING] != 0 ? DIMD_FUSION_NUM : 0;
        }
      }
      SYNC();
      if( dimdCu || obicCu || mergeCu || timdCu || ccpCu )   // (the block's: the same for the whole workgroup)
      {
        if( lid == 0 )
        {
          blendTotals( mergeCu );
        }
        SYNC();
      }
      if( timdCu )
      {
        // TIMD (the 131-mode set): its mode with its wide angle; fusion where the modes do not blend as the CU's
        // fetchRef2nd and the slope allow it, where they blend TIMD's rule (the main mode then without fusion, the
        // secondary from the next line alone: timdBlendFusion), a TIMD merge CU's always (its secondary then by its
        // slope, below); the bilateral filter only on a blend
        CBufI32 o = CBufI32( P.timdOut );
        timdModeParams( t, o.v[timdOut + TIMD_OUT_MODE], o.v[timdOut + TIMD_OUT_CHECK_WA] != 0 );
        const bool blending  = s_blendNum != 0;
        const bool timdMerge = WITH_TIMD_MERGE && ( t.derive & DERIVE_TIMD_MERGE ) != 0;
        const bool blendFuses = ( t.derive & DERIVE_NO_FUSION ) == 0 && ( timdMerge || timdBlendFusion( timdOut, t.regW, t.h ) );
        t.fusion = blending ? ( blendFuses ? 1 : 0 )
                            : ( t.derive & DERIVE_FETCH2ND ) != 0 && t.dirMode > DC_IDX && ( abs( t.intraPredAngle ) & 63 ) != 0 ? 1 : 0;
        t.bf     = blending && ( t.derive & DERIVE_BF ) != 0 ? 1 : 0;   // (of the blend)
      }
      else if( WITH_TMRL && ( t.derive & DERIVE_TMRL ) != 0 )   // its node's mode and line (intra_tmrl.glsl)
      {
        tmrlBlockParams( t );
      }
      else
      {
        applyModeParams( t, s_mode, BufCu( P.cus ).v[t.cu].plIdx );
      }
      if( dimdCu || obicCu || mergeCu )
      {
        // the main mode of DIMD, OBIC and intra merge has no bilateral filter; blending (always with OBIC: planar is
        // added, and intra merge) has no intra fusion (initIntraPatternChType's fetchRef2nd) and filters the blended
        // prediction (predIntraAng, generateDimdBuffersForLocDepBlending; the host checked the size and QP)
        const bool blending = s_blendNum != 0;
        t.fusion = blending ? 0 : t.fusion;
        t.bf     = blending && ( t.derive & DERIVE_BF ) != 0 ? 1 : 0;
      }
      if( pc.verify != 0 && lid == 0 )
      {
        const int o = g_ti * DBG_PARAMS;
        BufI32 dp = BufI32( P.dbgParams );
        dp.v[o + 0] = t.dirMode;   dp.v[o + 1] = t.isModeVer;  dp.v[o + 2] = t.intraPredAngle;  dp.v[o + 3] = t.absInvAngle;
        dp.v[o + 4] = t.useCubic;  dp.v[o + 5] = t.refFilter;  dp.v[o + 6] = t.applyPDPC;       dp.v[o + 7] = t.gradPDPC;
        dp.v[o + 8] = t.angularScale; dp.v[o + 9] = t.fusion;  dp.v[o + 10] = t.bf;             dp.v[o + 11] = t.plIdx;
      }
    }
    int  angClear  = 0;
    bool angClear2 = false;
    // the predicted region (the block, or the 4-wide region of ISP sub-partitions 1 or 2 wide: storeRegion keeps the
    // block's columns) and the arm lengths of its references (m_topRefLength / m_leftRefLength: 8x the block, for ISP
    // the CU's size plus the region's)
    const int W = t.regW, H = t.h, N = W * H;
    const bool isp = t.isp != 0;
    const int topLen = isp ? t.cuW + W : W << 3, leftLen = isp ? t.cuH + H : H << 3;
    const int maxPel = ( 1 << t.bitDepth ) - 1;
    const int mrl = t.mrl;   // the reference line (MRL excludes planar, PDPC, the reference filter, MIP and ISP)
    const int predStride = topLen + 1 + mrl, predSize = topLen, predHSize = leftLen;
    const bool fusion = t.fusion != 0;

    // ----- LMCS chroma residual scaling (Reshape::calculateChromaAdjVpduNei with LMCS_CHROMA_CALC_CU): the rounded
    // mean of the luma column left of and the row above the CU (rows / columns beyond the picture replaced by the last
    // one), clipped, selects the scale; without neighbours the mid-level value does
    g_crs      = ( t.lmcs & 2 ) != 0;
    g_crsScale = 0;
    if( g_crs )
    {
      const bool hasLeft = ( t.crsAvail & 1 ) != 0, hasAbove = ( t.crsAvail & 2 ) != 0;
      int sum = 0;
      for( int k = lid; hasLeft && k < t.crsH; k += NT ) sum += recoAt( 0, t.crsX - 1, min( t.crsY + k, P.height[0] - 1 ) );
      for( int k = lid; hasAbove && k < t.crsW; k += NT ) sum += recoAt( 0, min( t.crsX + k, P.width[0] - 1 ), t.crsY - 1 );
      const int total  = wgSum2( sum, 0, 0 ).x;
      const int pelnum = ( hasLeft ? t.crsH : 0 ) + ( hasAbove ? t.crsW : 0 );
      const int lumaValue = pelnum > 0 ? clip3i( P.lumaClipMin, P.lumaClipMax, ( total + ( pelnum >> 1 ) ) / pelnum ) : P.lmcsLutSize >> 1;
      g_crsScale = BufI32( P.lmcs ).v[2 * P.lmcsLutSize + lumaValue];
    }

    // ----- LM chroma fusion (geneChromaFusionPred): of its first type, and of CCP merge fusion with CCCM, the CCCM
    // prediction it blends in (storeRegion), into the scratch before the references and the prediction take s_tmp and
    // the angular arrays; of CFLM the area whose chroma buffer keeps the regular prediction (intra_cccm.glsl)
    if( WITH_CCCM && lmFusionType( t ) == 1 )
    {
      cccmPrediction( t, false, lid, NT );
    }
    else if( WITH_CFLM && lmFusionType( t ) > 1 )
    {
      cflmArea( t, lid );
    }

    // ----- reference samples (and the second line of intra fusion)
    fillReferencePar( t, 0, 0, predStride, lid, NT );
    if( fusion )
    {
      fillReferencePar( t, 1, 1, predStride + 1, lid, NT );
    }
    SYNC();
    // DIMD / OBIC / intra merge blending (predIntraAng): each mode predicts from the filtered or the unfiltered
    // references as its own parameters say, so both are kept: the unfiltered in s_ref[1] (blending has no fusion line),
    // the filtered in s_tmp. A TIMD blend, which can fuse, keeps the unfiltered ones in s_ref[0], its planar
    // predictions read the filtered ones in s_tmp (planarRef)
    const bool timdBlend = WITH_TIMD && ( t.derive & DERIVE_TIMD ) != 0 && s_blendNum != 0;
    const int  blendCus  = DERIVE_DIMD | DERIVE_OBIC | DERIVE_MERGE | DERIVE_CCP_DIMD;
    const bool blend     = ( WITH_DIMD && ( t.derive & blendCus ) != 0 && s_blendNum != 0 ) || timdBlend;
    if( t.refFilter != 0 || blend )   // xFilterReferenceSamples (multiRefIdx 0): in place, or for blending beside them
    {
      for( int i = lid; i <= predStride + predHSize; i += NT )
      {
        int v;
        if( i == 0 || i == predStride )
        {
          v = ( int( s_ref[0][0] ) + int( s_ref[0][1] ) + int( s_ref[0][predStride] ) + int( s_ref[0][predStride + 1] ) + 2 ) >> 2;
        }
        else if( i == predSize || i == predStride + predHSize )
        {
          v = int( s_ref[0][i] );
        }
        else
        {
          v = ( int( s_ref[0][i - 1] ) + 2 * int( s_ref[0][i] ) + int( s_ref[0][i + 1] ) + 2 ) >> 2;
        }
        s_tmp[i] = int16_t( v );
      }
      SYNC();
      for( int i = lid; i <= predStride + predHSize && !blend; i += NT ) s_ref[0][i] = s_tmp[i];
      for( int i = lid; i <= predStride + predHSize && blend && !timdBlend; i += NT ) s_ref[1][i] = s_ref[0][i];
      SYNC();
    }

    // ----- the intra bilateral filter (bilateralFilterPredDiamond5x5Clip, luma of intra slices; the host checked
    // the size, mode and QP): angular modes skip it for textured references (xPredIntaAng's isRefSampleMadSkipBf, the
    // mean absolute deviation of the (filtered) top and left reference arrays)
    bool bf = t.bf == 1;
    if( t.bf == 2 )
    {
      // the arms are 8x the block (never ISP), W, H <= 32: one sample per invocation
      const int a = lid < topLen ? int( s_ref[0][lid] ) : 0, b = lid < leftLen ? int( s_ref[0][predStride + lid] ) : 0;
      const ivec2 sum = wgSum2( a, b, 0 );
      const int lT = findMSB( topLen ), lL = findMSB( leftLen );
      const int avgT = ( sum.x + ( 1 << ( lT - 1 ) ) ) >> lT, avgL = ( sum.y + ( 1 << ( lL - 1 ) ) ) >> lL;
      const ivec2 dev = wgSum2( lid < topLen ? abs( a - avgT ) : 0, lid < leftLen ? abs( b - avgL ) : 0, 2 );
      const int madT = ( dev.x + ( 1 << ( lT - 1 ) ) ) >> lT, madL = ( dev.y + ( 1 << ( lL - 1 ) ) ) >> lL;
      bf = min( ( ( madT + madL + 1 ) >> 1 ) >> 4, 15 ) <= 10;
    }

    // ----- MIP's reduced prediction (MatrixIntraPrediction::prepareInputForPred, computeReducedPred), which its
    // upsampling reads (mipSample); a MIP block with LFNST / NSPT takes their mode from its prediction (mipTransformMode)
    const int mipPs = t.mipSizeId < 2 ? 4 : 8, mipUpH = W / mipPs, mipUpV = H / mipPs;
    if( t.mipMatrix >= 0 )
    {
      const int bs = t.mipSizeId == 0 ? 2 : 4, inSize = 2 * bs;
      // the reduced boundary: the Haar-downsampled top (entries 0 .. bs - 1) and left (bs .. 2 bs - 1) references
      if( lid < inSize )
      {
        const bool top = lid < bs;
        const int  k = top ? lid : lid - bs, f = ( top ? W : H ) / bs, lg = findMSB( f );
        int sum = 0;
        for( int j = 0; j < f; j++ ) sum += int( s_ref[0][( top ? 1 : predStride + 1 ) + k * f + j] );
        s_mipBdry[lid] = f > 1 ? ( sum + ( 1 << ( lg - 1 ) ) ) >> lg : sum;
      }
      const bool mipDimd = WITH_DERIVED_TRANSFORMS && WITH_DIMD && ( t.derive & DERIVE_MIP_DIMD ) != 0;
      for( int i = lid; mipDimd && i < NUM_LUMA_MODE; i += NT )   // mipTransformMode's histogram
      {
        s_dimdHist[i] = 0;
      }
      SYNC();
      // the matrix input: [top, left], transposed [left, top], rebased on its first entry; that entry becomes the
      // difference to the mid level, or 0 for the large size class, whose matrices have no weight for it
      const bool transposed = t.mipTransposed != 0;
      int mipIn[8];
      for( int i = 0; i < inSize; i++ ) mipIn[i] = s_mipBdry[transposed ? ( i < bs ? bs + i : i - bs ) : i];
      const int inputOffset = mipIn[0];
      mipIn[0] = t.mipSizeId < 2 ? ( 1 << ( t.bitDepth - 1 ) ) - inputOffset : 0;
      int inSum = mipIn[0];
      for( int i = 1; i < inSize; i++ )
      {
        mipIn[i] -= inputOffset;
        inSum += mipIn[i];
      }
      // the reduced prediction, one sample per invocation (computed in the transposed order when transposed); the
      // large class's rows hold the weights of inputs 1 ..
      if( lid < mipPs * mipPs )
      {
        const int rowLen = t.mipSizeId == 2 ? inSize - 1 : inSize, first = t.mipSizeId == 2 ? 1 : 0;
        int sum = 0;
        for( int i = first; i < inSize; i++ ) sum += mipIn[i] * BufI32( P.matrices ).v[t.mipMatrix + lid * rowLen + i - first];
        const int offset = ( 1 << ( 6 - 1 ) ) - 32 * inSum;   // MIP_SHIFT_MATRIX 6, MIP_OFFSET_MATRIX 32
        s_mipRed[transposed ? ( lid % mipPs ) * mipPs + lid / mipPs : lid] = clip3i( 0, maxPel, ( ( sum + offset ) >> 6 ) + inputOffset );
      }
      SYNC();
      if( mipDimd )
      {
        mipTransformMode( t, W, H, mipPs, mipUpH, mipUpV, predStride, lid, NT );
      }
    }

    // ----- a CCLM block with LFNST / NSPT: their mode from a DIMD of the CU's chroma predictions (intra_cclm.glsl; a
    // CCP merge block's and a decoder-derived CCP fusion block's: intra_ccp.glsl)
    const bool cclmDimd = WITH_CCLM && WITH_DIMD && WITH_DERIVED_TRANSFORMS && ( t.derive & DERIVE_CCLM_DIMD ) != 0;
    if( cclmDimd )
    {
#ifdef CCP_LFNST_MODULE   // (a call the optimizer removes still takes the IDs of the inlined function)
      if( t.ccpMerge >= 0 )
      {
        ccpMergeTransformMode( t, predStride, maxPel, lid, NT );
      }
      else
#endif
      {
        cclmTransformMode( t, predStride, maxPel, lid, NT );
      }
    }

    // ----- the transforms, where they depend on a derived mode or a MIP / CCLM block's prediction: the matrices of the
    // mode, and (unless the residual comes from the other block of a joint CbCr pair) without sign prediction the
    // residual, its first stage now, its second sample by sample at the reconstruction (storeRecon); signPrediction
    // computes all for its blocks
    if( WITH_DERIVED_TRANSFORMS && ( t.derive & DERIVE_TRANSFORM ) != 0 )
    {
      const bool predDimd = cclmDimd || ( WITH_DIMD && ( t.derive & DERIVE_MIP_DIMD ) != 0 );
      selectTransform( t, predDimd ? s_predDimdMode : s_mode, predDimd ? 0 : BufCu( P.cus ).v[t.cu].plIdx );
      if( pc.verify != 0 && lid == 0 )
      {
        storeDbgTransforms( t );
      }
      if( t.spCoded < 0 && t.resiFrom < 0 )
      {
        inChainResidual( t, lid, NT );
        t.resiFrom = g_ti;   // storeRecon reads it device-coherent
      }
    }

    // ----- prediction and reconstruction; with blending (predIntraAng) the predictions of the CU's modes in turn (DIMD's
    // main mode, planar and blend modes; OBIC's modes), each with the parameters of its mode (initPredIntraParams for
    // the CU, no fusion, no bilateral filter), its references and its filter length (DIMD's by its weight), summed
    // (emitPred), then blended
    // A TIMD blend (predIntraAng's TIMD branch): its mode without fusion, its secondary (with the secondary's wide-angle
    // choice; its non-angular mode with it) from the next line alone where TIMD's rule fuses them - a TIMD merge CU's
    // where its slope is fractional (its initPredIntraParams' fusion of a secondary mode) - their filter lengths by the
    // modes blended (timdBlendTaps; a TIMD-SAD blend keeps the default lengths: xPredIntraAng takes numTapsTIMD only
    // without TIMD-SAD)
    // CCP merge fusion with DIMD chroma (predCCPCandidate's ccpMergeFusionType 1) blends alike: first the merge
    // prediction (intra_ccp.glsl, with its inside filter), then that of the DIMD chroma mode its node derived, each
    // weighed 1, averaged with rounding
    g_blendSum  = false;
    g_blendTaps = ( t.derive & DERIVE_DIMD ) != 0;
    const ivec2 timdTaps = timdBlend && !timdSadCu( t.cu ) ? timdBlendTaps( timdPredBase( t.cu ) ) : ivec2( 0, 0 );
    const bool  timdMergeBlend = WITH_TIMD_MERGE && timdBlend && ( t.derive & DERIVE_TIMD_MERGE ) != 0;
    const bool  ccpDimd = WITH_CCP_MERGE && WITH_DIMD && ( t.derive & DERIVE_CCP_DIMD ) != 0;
    bool blendFirst = true;
    for( int sub = 0; sub < ( blend ? s_blendNum : 1 ); sub++ )
    {
      int fuse = fusion ? FUSE_BOTH : FUSE_NONE;   // the lines the angular prediction reads
      if( blend )
      {
        g_blendW     = s_blendW[sub];
        g_blendClass = s_blendClass[sub];
        if( g_blendW == 0 )
        {
          continue;
        }
        if( sub > 0 && timdBlend )
        {
          timdModeParams( t, s_blendMode[sub], CBufI32( P.timdOut ).v[timdPredBase( t.cu ) + TIMD_OUT_SEC_CHECK_WA] != 0 );
        }
        else if( sub > 0 )
        {
          applyModeParams( t, s_blendMode[sub], 0 );
        }
        const bool secondaryFuses = !timdMergeBlend || ( t.dirMode > DC_IDX && ( abs( t.intraPredAngle ) & 63 ) != 0 );
        fuse         = timdBlend && sub == 1 && fusion && secondaryFuses ? FUSE_SECOND : FUSE_NONE;
        g_blendSum   = true;
        g_blendFirst = blendFirst;
        blendFirst   = false;
        for( int i = lid; i <= predStride + predHSize && !timdBlend; i += NT ) s_ref[0][i] = t.refFilter != 0 ? s_tmp[i] : s_ref[1][i];
        SYNC();
      }
      // a TIMD blend's planar with the reference filter: the filtered line (in s_tmp)
      const bool planarFiltered = timdBlend && t.refFilter != 0;
      if( t.mipMatrix >= 0 )   // MIP: predictionUpsampling of the reduced prediction
      {
        for( int i = lid; i < N; i += NT ) emitPred( t, i % W, i / W, mipSample( i % W, i / W, mipPs, mipUpH, mipUpV, predStride ), bf );
      }
      else if( WITH_CCLM && !( ccpDimd && sub == 1 )   // (the merge's LM fields stay: its second prediction is angular)
               && ( ( t.lm & LM_ACTIVE ) != 0 || ( WITH_CCP_MERGE && t.ccpMerge >= 0 ) ) )
      {
        // CCLM, CCCM (intra_cclm.glsl, intra_cccm.glsl): the model(s) from the template, then applied; CCP merge
        // (intra_ccp.glsl): the inherited model applied as the LM block of its type applies its own, also the model
        // decoder-derived CCP fusion chooses
        const int lx = t.x << 1, ly = t.y << 1;   // the co-located luma block (4:2:0)
        if( WITH_CCP_MERGE && t.ccpMerge >= 0 )
        {
          ccpMergePrediction( t, predStride, lid, NT );   // (t: the chosen model's LM block; its luma buffers in the
                                                          // angular arrays, cleared at the end, or the scratch)
          angClear  = g_ccpAngUsed;
          angClear2 = g_ccpAngUsed > 0;
        }
        else if( WITH_CCCM && ( ( t.lm >> LM_CCCM_SHIFT ) & 3 ) != 0 )
        {
          cccmPrediction( t, false, lid, NT );   // (its luma buffer in the angular arrays, cleared at the end, or
                                                 // the scratch)
          angClear  = g_cccmSharedLuma ? ( cccmBufferSize() + 3 ) >> 2 : 0;
          angClear2 = g_cccmSharedLuma;
        }
        else
        {
          if( lid == 0 )
          {
            cclmAvailability( t );
          }
          SYNC();
          if( lid == 0 )
          {
            cclmModel( t, lx, ly, predStride, 0, 0 );
            if( t.ccp >= 0 )   // (CCP merge's inheritance)
            {
              cclmStoreCcp( t );
            }
          }
          SYNC();
        }
        for( int i = lid; i < N; i += NT )
        {
          emitPred( t, i % W, i / W, cclmPrediction( t, lx, ly, i % W, i / W, maxPel, 0 ), false );
        }
      }
      else if( t.dirMode == 0 || t.dirMode == 1 )   // planar / DC, then their PDPC
      {
        const int log2W = findMSB( W ), log2H = findMSB( H );
        if( t.dirMode == 1 && lid == 0 )   // xGetPredValDc: from entry multiRefIdx + 1 on
        {
          int denom = ( W == H ) ? ( W << 1 ) : max( W, H );
          int sum = 0;
          if( W >= H ) for( int k = 0; k < W; k++ ) sum += int( s_ref[0][mrl + 1 + k] );
          if( W <= H ) for( int k = 0; k < H; k++ ) sum += int( s_ref[0][predStride + mrl + 1 + k] );
          s_dc = ( sum + ( denom >> 1 ) ) >> findMSB( denom );
        }
        SYNC();
        const int topRight = planarRef( 1 + W, planarFiltered ), bottomLeft = planarRef( predStride + 1 + H, planarFiltered );
        const int offset = 1 << ( log2W + log2H ), finalShift = 1 + log2W + log2H;
        const int pdpcScale = ( log2W - 2 + log2H - 2 + 2 ) >> 2;
        for( int i = lid; i < N; i += NT )
        {
          int x = i % W, y = i / W;
          int T = planarRef( 1 + x, planarFiltered ), L = planarRef( predStride + 1 + y, planarFiltered );
          int v;
          if( t.dirMode == 1 )
          {
            v = s_dc;
          }
          else
          {
            int horPred  = ( L << log2W ) + ( x + 1 ) * ( topRight - L );
            int vertPred = ( T << log2H ) + ( y + 1 ) * ( bottomLeft - T );
            if( t.plIdx == 1 )      v = ( horPred + ( 1 << ( log2W - 1 ) ) ) >> log2W;
            else if( t.plIdx == 2 ) v = ( vertPred + ( 1 << ( log2H - 1 ) ) ) >> log2H;
            else                    v = ( ( horPred << log2H ) + ( vertPred << log2W ) + offset ) >> finalShift;
          }
          v = asPel( v );
          if( t.applyPDPC != 0 )   // xIntraPredPlanarDcPdpc
          {
            const int wT = 32 >> min( 31, ( y << 1 ) >> pdpcScale );
            const int wL = 32 >> min( 31, ( x << 1 ) >> pdpcScale );
            v = asPel( v + ( ( wL * ( L - v ) + wT * ( T - v ) + 32 ) >> 6 ) );
          }
          emitPred( t, i % W, i / W, v, bf );
        }
      }
      else   // angular (xPredIntraAng)
      {
        const bool isVer = t.isModeVer != 0;
        const int angle = t.intraPredAngle, absInvAngle = t.absInvAngle;
        // the reference arrays of the block's line (angularArrays), then of the fusion line (refMain2nd / refSide2nd:
        // longer copies and ranges); every entry is computed directly from the lines, so one barrier after both suffices
        const int topRefLength = topLen, leftRefLength = leftLen;
        const int mrl2 = mrl + 1, predStride2 = predStride + 1;   // the fusion line (multiRefIdx2nd)
        const int sizeSide = isVer ? H : W;
        const int refLength = isVer ? topRefLength : leftRefLength;
        const int log2Ratio = findMSB( W ) - findMSB( H );
        const int sh = max( 0, isVer ? log2Ratio : -log2Ratio );
        const ivec2 bases = angularArrays( isVer, W, H, angle, absInvAngle, topRefLength, leftRefLength, mrl, predStride,
                                           t.disableRefFilter != 0, maxPel, lid, NT );
        int mainBase = bases.x, sideBase = bases.y, mainBase2, sideBase2;
        if( angle < 0 )
        {
          mainBase2 = mainBase + 1;
          sideBase2 = sideBase + 1;
          if( fusion )
          {
            for( int i = lid; i < topRefLength + PAD + mrl2; i += NT ) s_angA[1][H + PAD + 1 + i] = s_ref[1][i];
            for( int i = lid; i < leftRefLength + PAD + mrl2; i += NT ) s_angL[1][W + PAD + 1 + i] = s_ref[1][predStride2 + i];
            const int sideOff2 = isVer ? predStride2 : 0;
            const int sizeSideRange = ( isVer ? leftRefLength : topRefLength ) + mrl2;
            for( int k = -( sizeSide + 1 + PAD ) + lid; k <= -1; k += NT )
            {
              int frac32precision = ( -k * absInvAngle + 8 ) >> 4;
              int intpel = frac32precision >> 5, fracpel = frac32precision & 31;
              int left  = int( s_ref[1][sideOff2 + clip3i( 0, sizeSideRange, intpel ) ] );
              int right = int( s_ref[1][sideOff2 + clip3i( 0, sizeSideRange, intpel + 1 ) ] );
              int v;
              if( t.disableRefFilter != 0 )
              {
                v = fracpel > 15 ? right : left;
              }
              else
              {
                int lm1 = int( s_ref[1][sideOff2 + clip3i( 0, sizeSideRange, intpel - 1 ) ] );
                int rp1 = int( s_ref[1][sideOff2 + clip3i( 0, sizeSideRange, intpel + 2 ) ] );
                v = clip3i( 0, maxPel, ( weak4( fracpel, 0 ) * lm1 + weak4( fracpel, 1 ) * left + weak4( fracpel, 2 ) * right + weak4( fracpel, 3 ) * rp1 + 32 ) >> 6 );
              }
              mainW( isVer, 1, mainBase2 + k, v );
            }
          }
        }
        else
        {
          if( fusion )
          {
            const int maxIndex2 = ( mrl2 << sh ) + 6 + 4;
            const int end1 = PAD + refLength + mrl2;
            const int val2 = int( s_ref[1][( isVer ? 0 : predStride2 ) + refLength + mrl2] );
            const int lenA2 = isVer ? end1 + maxIndex2 + PAD + 1 : PAD + topRefLength + mrl2 + PAD;
            const int lenL2 = isVer ? PAD + leftRefLength + mrl2 + PAD : end1 + maxIndex2 + PAD + 1;
            for( int j = lid; j < lenA2; j += NT )
            {
              const int v = isVer && j > end1 ? val2 : j < PAD ? int( s_ref[1][0] ) : int( s_ref[1][j - PAD] );
              s_angA[1][j] = int16_t( v );
            }
            for( int j = lid; j < lenL2; j += NT )
            {
              const int v = !isVer && j > end1 ? val2 : j < PAD ? int( s_ref[1][predStride2] ) : int( s_ref[1][predStride2 + j - PAD] );
              s_angL[1][j] = int16_t( v );
            }
          }
          mainBase2 = PAD;
          sideBase2 = PAD;
        }
        // the prediction reads the arrays from the reference line's own corner on (refMain += multiRefIdx, refMain2nd +=
        // multiRefIdx2nd)
        mainBase += mrl;
        sideBase += mrl;
        mainBase2 += mrl2;
        sideBase2 += mrl2;
        // cleared after the block (IntraPrediction's angRefClearEnd)
        angClear = min( ANG, 2 * ( W + H ) + max( topRefLength, leftRefLength ) + 2 * PAD + 2 * mrl2 + ( mrl2 << abs( log2Ratio ) ) + 16 );
        angClear2 = fusion;
        SYNC();
        // rows along the main direction (width/height swapped for horizontal modes); a TIMD or TMRL block's angles in
        // 1/64 samples (bExtIntraDir)
        const int w = isVer ? W : H, h = isVer ? H : W;
        const bool isLuma = t.comp == 0;
        const bool ext = ( WITH_TIMD && ( t.derive & DERIVE_TIMD ) != 0 ) || ( WITH_TMRL && ( t.derive & DERIVE_TMRL ) != 0 && isLuma );
        const int  fracBits = ext ? 6 : 5, fracMask = ( 1 << fracBits ) - 1;
        int taps = 0;
        if( isLuma )
        {
          taps = t.useCubic != 0 ? 16 : 6;
          const bool byWeight = WITH_DIMD && g_blendSum && g_blendTaps && t.useCubic != 0;
          if( byWeight )   // JVET-AN0158: a DIMD blend's prediction by its weight
          {
            taps = g_blendW >= 32 ? 8 : 16;
          }
          const int timdBlendTaps = sub == 0 ? timdTaps.x : timdTaps.y;
          if( timdBlend && timdBlendTaps != 0 )   // a TIMD blend's (where it gives one; TIMD's 8 stay 8: JVET-AM0163)
          {
            taps = timdBlendTaps;
          }
          if( w < 8 && taps > 10 ) taps = 10;
          if( byWeight && taps == 8 )   // JVET-AK0087: 8 taps for slopes away from H / V in small blocks
          {
            const int log2Size = ( findMSB( w ) + findMSB( h ) ) >> 1;
            const int diff     = min( abs( angle - HOR_IDX ), abs( angle - VER_IDX ) );   // of the angle, as the CPU has it
            taps = diff > ( log2Size >> 1 ) && log2Size < 4 ? 8 : 6;
          }
        }
        const int numExtra = taps / 2 - 2;
        const bool intSlope = ( abs( angle ) & fracMask ) == 0;
        const bool big = W >= 32 && H >= 32;
        // (PDPC: none for a prediction from the next line alone, but of the vertical / horizontal mode)
        const bool pdpc = t.applyPDPC != 0 && ( angle == 0 || !WITH_TIMD || fuse != FUSE_SECOND );
        const int pdpcLimit = pdpc ? min( 3 << ( angle == 0 ? ( ( findMSB( w ) + findMSB( h ) - 2 ) >> 2 ) : t.angularScale ), w ) : 0;
        for( int i = lid; i < N; i += NT )
        {
          int x = i % w, y = i / w;   // position in the (possibly transposed) block
          int v;
          if( angle == 0 )
          {
            v = mainR( isVer, 0, mainBase + 1 + x );
            if( x < pdpcLimit )
            {
              const int scale = ( findMSB( w ) + findMSB( h ) - 2 ) >> 2;
              const int topLeft = mainR( isVer, 0, mainBase ), left = sideR( isVer, 0, sideBase + 1 + y );
              const int wL = 32 >> ( 2 * x >> scale );
              v = clip3i( 0, maxPel, v + ( ( wL * ( left - topLeft ) + 32 ) >> 6 ) );
            }
          }
          else
          {
            const int deltaPos = angle * ( y + 1 + mrl );
            const int deltaInt = deltaPos >> fracBits, deltaFract = deltaPos & fracMask;
            if( intSlope )   // (also from the next line alone: the block's line, as the CPU's copy)
            {
              v = mainR( isVer, 0, mainBase + deltaInt + 1 + x );
            }
            else if( isLuma )
            {
              const bool cubic = t.useCubic != 0;
              const int  deltaInt2 = ( deltaPos + angle ) >> fracBits, deltaFract2 = ( deltaPos + angle ) & fracMask;
              int val32;
              if( WITH_TIMD && fuse == FUSE_SECOND )
              {
                val32 = ( lumaConv( isVer, 1, mainBase2 + deltaInt2 + x - numExtra, taps, cubic, big, deltaFract2, ext ) + 128 ) >> 8;
              }
              else
              {
                const int c0 = lumaConv( isVer, 0, mainBase + deltaInt + x - numExtra, taps, cubic, big, deltaFract, ext );
                if( fuse == FUSE_BOTH )
                {
                  const int c1 = lumaConv( isVer, 1, mainBase2 + deltaInt2 + x - numExtra, taps, cubic, big, deltaFract2, ext );
                  val32 = ( 3 * c0 + 1 * c1 + 128 * 4 ) >> ( 8 + 2 );
                }
                else
                {
                  val32 = ( c0 + 128 ) >> 8;
                }
              }
              v = clip3i( 0, maxPel, clip3i( 0, maxPel, val32 ) );
            }
            else
            {
              const int p0 = mainR( isVer, 0, mainBase + deltaInt + x + 1 ), p1 = mainR( isVer, 0, mainBase + deltaInt + x + 2 );
              v = asPel( p0 + ( ( deltaFract * ( p1 - p0 ) + 16 ) >> 5 ) );
            }
            v = asPel( v );
            if( x < pdpcLimit )
            {
              const int scale = t.angularScale;
              const int wL = 32 >> ( 2 * x >> scale );
              if( t.gradPDPC != 0 )
              {
                const int left = sideR( isVer, 0, sideBase + 1 + y );
                const int m0 = mainR( isVer, 0, mainBase + deltaInt ), m1 = mainR( isVer, 0, mainBase + deltaInt + 1 );
                const int topLeft = asPel( m0 + ( ( deltaFract * ( m1 - m0 ) + ( 1 << ( fracBits - 1 ) ) ) >> fracBits ) );
                v = clip3i( 0, maxPel, v + ( ( wL * ( left - topLeft ) + 32 ) >> 6 ) );
              }
              else
              {
                const int invAngleSum = 256 + ( x + 1 ) * absInvAngle;
                const int left = sideR( isVer, 0, sideBase + y + ( invAngleSum >> 9 ) + 1 );
                v = asPel( v + ( ( wL * ( left - v ) + 32 ) >> 6 ) );
              }
            }
          }
          const int ox = isVer ? x : y, oy = isVer ? y : x;
          emitPred( t, ox, oy, asPel( v ), bf );
        }
      }
      if( blend )   // the next prediction: its own angular arrays (zero), the sums visible to all invocations
      {
        SYNC();
        for( int i = lid; i < angClear; i += NT )
        {
          s_angA[0][i] = int16_t( 0 );
          s_angL[0][i] = int16_t( 0 );
          if( angClear2 )   // (a TIMD blend's next line)
          {
            s_angA[1][i] = int16_t( 0 );
            s_angL[1][i] = int16_t( 0 );
          }
        }
        angClear = 0;
        controlBarrier( gl_ScopeWorkgroup, gl_ScopeWorkgroup, gl_StorageSemanticsBuffer | gl_StorageSemanticsShared,
                        gl_SemanticsAcquireRelease );
      }
    }
    if( blend )
    {
      // each class's prediction (predIntraAng): its sum over the class's total (truncated, as the division and the
      // shift of timdBlending / dimdBlending give it); the totals are weightNonLocDep (with DIMD's planar), weightVer
      // and weightHor (blendTotals)
      g_blendSum = false;
      const int wt[3] = int[3]( s_blendTot[0], s_blendTot[1], s_blendTot[2] );
      // with location dependence, xLocationdepBlending (range 10, a TIMD blend's 8 from 128 samples on; doubled across
      // blocks above 64): the vertical class's weight falls down the rows, the horizontal one's along the columns (mode
      // 0 both, clipped to their shares of the rest, mode 1 vertical, mode 2 horizontal), the rest is the first class's
      const int  wNon = wt[0], wVer = wt[1], wHor = wt[2];
      const bool locDep = wVer != 0 || wHor != 0;
      const int  ldMode = wHor > 0 && wVer > 0 ? 0 : wVer > 0 ? 1 : 2;
      const int  range = timdBlend && W * H > 127 ? 8 : 10;
      const int  rangeVer = H > 64 ? 2 * range : range, rangeHor = W > 64 ? 2 * range : range;
      int clipVer = 64, clipHor = 64;
      if( locDep && ldMode == 0 )
      {
        clipVer = wVer + dimdScaledWeight( wVer, wVer + wHor, wNon );
        clipHor = wHor + dimdScaledWeight( wHor, wVer + wHor, wNon );
      }
      const bool needClipVer = wVer + rangeVer > clipVer || wVer - rangeVer < 0;
      const bool needClipHor = wHor + rangeHor > clipHor || wHor - rangeHor < 0;
      CBufI32 acc = CBufI32( P.scratch );
      const int rounding = ccpDimd ? 1 : 0;   // (CCP merge fusion with DIMD chroma: (2 P0 + 2 P1 + 2) >> 2)
      for( int i = lid; i < N; i += NT )
      {
        const int x = i % W, y = i / W, o = int( gl_WorkGroupID.x ) * BLEND_ACC + i;
        int v[3];
        for( int c = 0; c < 3; c++ )
        {
          v[c] = wt[c] != 0 ? asPel( divTrunc( acc.v[o + c * N] + rounding, wt[c] ) ) : 0;
        }
        int pr = v[0];
        if( locDep )
        {
          const bool rowsVary = ( ldMode == 0 || wNon != 0 ) && H > 1, colsVary = wNon != 0 && W > 1;
          int wv = rowsVary ? divTrunc( ( wVer + rangeVer ) * ( H - 1 ) - ( ( rangeVer * y ) << 1 ), H - 1 ) : 64;
          wv = rowsVary && needClipVer ? clip3i( 0, clipVer, wv ) : wv;
          int wh = colsVary ? divTrunc( ( wHor + rangeHor ) * ( W - 1 ) - ( ( rangeHor * x ) << 1 ), W - 1 ) : ldMode == 0 ? 64 - wv : 64;
          wh = colsVary && needClipHor ? clip3i( 0, clipHor, wh ) : wh;
          pr = ldMode == 0 ? asPel( ( v[1] * wv + v[2] * wh + v[0] * ( 64 - wv - wh ) + 32 ) >> 6 )
             : ldMode == 1 ? asPel( ( v[1] * wv + v[0] * ( 64 - wv ) + 32 ) >> 6 )
                           : asPel( ( v[2] * wh + v[0] * ( 64 - wh ) + 32 ) >> 6 );
        }
        emitPred( t, x, y, pr, bf );
      }
    }
    SYNC();
    if( bf )
    {
      // with LMCS the filter works on the inverse-mapped prediction and reconstruction, and its output (also when the
      // gate skips the filter) is mapped back (bilateralFilterPredDiamond5x5Clip)
      const bool lmcsBf = ( t.lmcs & 1 ) != 0;
      if( lmcsBf )
      {
        for( int i = lid; i < N; i += NT ) s_tmp[BF_PRED + i] = int16_t( invLut( int( s_tmp[BF_PRED + i] ) ) );
        SYNC();
      }
      // getFilterLutParameters: the mean absolute deviation of the prediction gates the filter and sets its strength
      const int log2W = findMSB( W ), log2H = findMSB( H ), whlog2 = log2W + log2H;
      const int bdShift = max( 0, t.bitDepth - 10 );
      if( lid < 48 )
      {
        s_bfLut[lid] = int16_t( BufI32( P.filters ).v[BF_LUT + clip3i( 0, 25, t.qp - 17 ) * 48 + lid] );
      }
      int acc = 0;
      for( int i = lid; i < N; i += NT ) acc += int( s_tmp[BF_PRED + i] );
      const int avg = ( wgSum2( acc, 0, 4 ).x + ( 1 << ( whlog2 - 1 ) ) ) >> whlog2;
      acc = 0;
      for( int i = lid; i < N; i += NT ) acc += abs( int( s_tmp[BF_PRED + i] ) - avg );
      int mad = ( wgSum2( 0, acc, 4 ).y + ( 1 << ( whlog2 - 1 ) ) ) >> whlog2;
      mad = ( mad + ( bdShift == 0 ? 0 : 1 << ( bdShift - 1 ) ) ) >> bdShift;
      mad = min( mad >> 4, 15 );
      if( mad < 10 )
      {
        const int bfac = BufI32( P.filters ).v[BF_SIZE + min( log2W, 7 ) * 8 + min( log2H, 7 )] + BufI32( P.filters ).v[BF_MAD + mad];
        // the block padded by two samples as the CPU builds it in rows of S samples (iWidthExtSIMD): the prediction
        // mirrored (columns, then rows), then the reconstruction around the CU's origin (for ISP sub-partitions the
        // CU's, with the CU's units) where its neighbours are available: with all of them the corner, the W above and
        // H left samples; else the corner, the left units but the bottom one and the above units but the last one.
        // Those writes go row by row at the CPU's stride, so the above units of an ISP sub-partition narrower than its
        // CU run past the row into the next ones; the last write wins (the CPU's order: corner, left, above, each
        // column writing row y - 2 at 2 + c and row y - 1 at S + 2 + c)
        const int PW = W + 4, S = W < 8 ? 12 : ( W + 4 ) | 4;
        const int bx = isp ? t.cuX : t.x, by = isp ? t.cuY : t.y;
        const int numAbove = max( ( isp ? t.cuW : W ) / t.unitW, 1 ), numLeft = max( ( isp ? t.cuH : H ) / t.unitH, 1 );
        const int corner = t.bfAvail[0], pA = t.bfAvail[1], pL = t.bfAvail[2];
        const bool all = corner != 0 && pA == numAbove && pL == numLeft;
        const int topRec  = all ? W : min( pA, numAbove - 1 ) * t.unitW;   // the above columns written
        const int leftRec = all ? H : min( pL, numLeft - 1 ) * t.unitH;    // the left rows written
        for( int i = lid; i < PW * ( H + 4 ); i += NT )
        {
          const int py = i / PW, px = i % PW;
          const int y = py - 2, x = px - 2;
          const int L = py * S + px, c0 = L - 2, c1 = L - S - 2;   // the position at the CPU's stride, its columns
          int sx = 0, sy = 0;
          bool rec = true;
          if( c0 >= 0 && c0 < topRec )
          {
            sx = bx + c0;
            sy = by - 2;
          }
          else if( c1 >= 0 && c1 < topRec )
          {
            sx = bx + c1;
            sy = by - 1;
          }
          else if( px < 2 && y >= 0 && y < leftRec )
          {
            sx = bx - 2 + px;
            sy = by + y;
          }
          else if( px < 2 && py < 2 && corner != 0 )
          {
            sx = bx - 2 + px;
            sy = by - 2 + py;
          }
          else
          {
            rec = false;
          }
          int v;
          if( rec )
          {
            v = recoAt( 0, sx, sy );
            v = lmcsBf ? invLut( v ) : v;
          }
          else
          {
            const int my = py == 0 ? 1 : py == 1 ? 0 : py == H + 3 ? H - 2 : py == H + 2 ? H - 1 : y;
            const int mx = px == 0 ? 1 : px == 1 ? 0 : px == W + 3 ? W - 2 : px == W + 2 ? W - 1 : x;
            v = int( s_tmp[BF_PRED + my * W + mx] );
          }
          s_tmp[BF_BLK + i] = int16_t( v );
        }
        SYNC();
        // the 5x5 diamond (blockBilateralFilterDiamond5x5 with isIntraPredBf), then the prediction plus the
        // filtered difference, clipped
        const int cutBits = 3 + bdShift;
        for( int i = lid; i < N; i += NT )
        {
          const int x = i % W, y = i / W;
          const int c = BF_BLK + ( y + 2 ) * PW + x + 2;
          const int p = int( s_tmp[c] );
          int modsum = 0;
          modsum += bfLut( int( s_tmp[c - 1] ) - p, 0, cutBits, bdShift );
          modsum += bfLut( int( s_tmp[c + 1] ) - p, 0, cutBits, bdShift );
          modsum += bfLut( int( s_tmp[c - PW] ) - p, 0, cutBits, bdShift );
          modsum += bfLut( int( s_tmp[c + PW] ) - p, 0, cutBits, bdShift );
          modsum += bfLut( int( s_tmp[c - PW - 1] ) - p, 16, cutBits, bdShift );
          modsum += bfLut( int( s_tmp[c - PW + 1] ) - p, 16, cutBits, bdShift );
          modsum += bfLut( int( s_tmp[c + PW - 1] ) - p, 16, cutBits, bdShift );
          modsum += bfLut( int( s_tmp[c + PW + 1] ) - p, 16, cutBits, bdShift );
          modsum += bfLut( int( s_tmp[c - 2] ) - p, 32, cutBits, bdShift );
          modsum += bfLut( int( s_tmp[c + 2] ) - p, 32, cutBits, bdShift );
          modsum += bfLut( int( s_tmp[c - 2 * PW] ) - p, 32, cutBits, bdShift );
          modsum += bfLut( int( s_tmp[c + 2 * PW] ) - p, 32, cutBits, bdShift );
          const int filt = asPel( ( modsum * bfac + 128 ) >> 8 );   // (BIF_ROUND_ADD / 2) << 3, BIF_ROUND_SHIFT - 1 + 3
          const int filtered = clip3i( 0, maxPel, filt + p );
          storeRegion( t, x, y, lmcsBf ? fwdLut( filtered ) : filtered );
        }
      }
      else
      {
        for( int i = lid; i < N; i += NT )
        {
          const int pr = int( s_tmp[BF_PRED + i] );
          storeRegion( t, i % W, i / W, lmcsBf ? fwdLut( pr ) : pr );
        }
      }
    }
    // ----- CFLM (geneChromaFusionPred's types 2 and 3): the block's prediction by its models from its regular one,
    // complete in the chroma buffer, and the luma (intra_cccm.glsl; its luma buffer in the angular arrays, cleared at
    // the end, or the scratch)
    if( WITH_CFLM && lmFusionType( t ) > 1 )
    {
      cflmPrediction( t, lid, NT );
      angClear  = max( angClear, g_cccmSharedLuma ? ( cccmBufferSize() + 3 ) >> 2 : 0 );
      angClear2 = angClear2 || g_cccmSharedLuma;
    }
    if( t.spCoded >= 0 )   // the prediction is complete: decide the signs, reconstruct
    {
      SYNC();
      signPrediction( t, lid, NT );
    }

    releaseDependents( d0, d1, lid, NT );
    for( int i = lid; i < angClear; i += NT )
    {
      s_angA[0][i] = int16_t( 0 );
      s_angL[0][i] = int16_t( 0 );
      if( angClear2 )
      {
        s_angA[1][i] = int16_t( 0 );
        s_angL[1][i] = int16_t( 0 );
      }
    }
  }
}
