#version 460
#pragma use_vulkan_memory_model
// intra reconstruction of a picture on the GPU: persistent workgroups take the transform blocks from a queue of ready
// blocks; a block is ready when the blocks whose samples it reads are reconstructed (dependency lists and counts
// from the host: geometry and decoding order only), so independent blocks (the three components, distant parts of
// the picture) run at the same time and no workgroup waits on a block it holds.
// Per block: reference samples of the block's reference line (MRL; for ISP sub-partitions the CU's references, shifted
// along the split, and the previous sub-partition's samples) and their [1 2 1] filtering, prediction (planar,
// directional planar, DC, angular with PDPC and intra fusion, MIP, the intra bilateral filter) and reconstruction with
// the residual intra_resi computed beforehand for all blocks at once (with LMCS: scaled for chroma by the neighbouring
// luma, the bilateral filter on inverse-mapped samples); with sign prediction the signs are decided first from the
// prediction and the neighbours, and the residual computed again where a sign is negative. Every step follows the C++
// of IntraPrediction / MatrixIntraPrediction / TrQuant / DecCu.
// Not yet: decoder-side intra modes.
#extension GL_GOOGLE_include_directive : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_memory_scope_semantics : require
#include "common.glsl"
#include "intra_common.glsl"

layout( local_size_x = 256 ) in;

// Vulkan memory model: the reconstruction and the done flags are written by one workgroup and read by others
// (device-scope coherent, done flags with release / acquire); the scratch is shared by the invocations of a workgroup
layout( buffer_reference, std430, buffer_reference_align = 2 ) coherent buffer CBufI16 { int16_t v[]; };
layout( buffer_reference, std430, buffer_reference_align = 4 ) coherent buffer CBufI32 { int v[]; };

#define SYNC() barrier()

const int PAD     = 6;                        // interpFilterNumPadded (16 taps / 2 - 2)
const int ANG     = 1792;                     // angular reference buffers (the CPU's are larger; blocks <= 128 use < 1700)
const int MAX_MRL = 13;                       // the farthest reference line (multiRefIdx 12, its fusion line 13)
const int MAX_REF = 2 * ( 8 * 128 + 2 + MAX_MRL ) + 16; // reference line: top row (stride predSize + 1 + mrl), then the left column
const int WEAK4   = 5 * 32 * 16;              // offset of the weak 4-tap table in the filter buffer
const int BF_LUT  = WEAK4 + 32 * 4;           // the bilateral filter's LUT rows (26 x 48), size and MAD factors
const int BF_SIZE = BF_LUT + 26 * 48;
const int BF_MAD  = BF_SIZE + 64;
const int BF_PRED = 0;                        // in s_tmp: the prediction (< 1024 samples: at most 512)
const int BF_BLK  = 512;                      // in s_tmp: the padded block ((W + 4) x (H + 4) <= 720)

shared int16_t s_ref[2][MAX_REF];             // refBufUnfiltered: the block's line (filtered in place when refFilter), the fusion line
shared int16_t s_tmp[MAX_REF];                // the reference filter's output; the bilateral filter's blocks
shared int16_t s_angA[2][ANG];                // refAbove, refAbove2nd
shared int16_t s_angL[2][ANG];                // refLeft, refLeft2nd
shared int16_t s_filters[WEAK4 + 32 * 4];     // the filter tables (copied once per workgroup)
shared int     s_dc;
shared int     s_ti;
shared int     s_next;                        // a dependent this workgroup released and continues with (-1: none)
shared int     s_deps[256];                   // the first dependents of the block (prefetched)
shared int     s_red[6];                      // workgroup sums
shared int16_t s_bfLut[48];                   // the bilateral filter's LUT row of the block's QP
shared int     s_mipBdry[8];                  // MIP: the reduced boundary (top, then left)
shared int     s_mipRed[64];                  // MIP: the reduced prediction (4 x 4 or 8 x 8)
// sign prediction (signPrediction; blocks of 4 x 4 to 32 x 32, at most 8 predicted signs)
shared int16_t s_spPred[32 * 32];             // the block's prediction, reconstructed once the signs are decided
shared int16_t s_spBorder[64];                // TU::predBorderResi: the residual the neighbours predict along the border
shared int16_t s_spBase[64];                  // the border of the residual with every predicted sign positive
shared int16_t s_spTempl[8 * 64];             // the templates of the predicted coefficients
// per border entry j, a sign hypothesis' border residual in two halves (16-bit sums, which suffice: the CPU's are
// Pel): at j * 16 + h the base minus twice the templates the low four hypothesis bits h select, and minus twice those
// the high four bits h select
shared int16_t s_spLow[64 * 16];
shared int16_t s_spHigh[64 * 16];
shared uint    s_spCost[256];                 // per sign hypothesis: its cost << 8 | the hypothesis
shared int16_t s_spCoef[32 * 32];             // the dequantized coefficients with the decided signs (nonzero region;
                                              // clipped to the 16-bit transform range), with LFNST its outputs over them
shared int16_t s_spStage1[32 * 32];           // their first inverse transform stage
shared int     s_secIn[64];                   // the LFNST / NSPT inputs (dequantized, in scan order)
shared int     s_lfnstOut[96];                // the LFNST outputs

Params P;      // the parameter block (loaded once)
int    g_ti;   // the block being reconstructed
bool   g_crs;       // LMCS chroma residual scaling of the block
int    g_crsScale;  // its scale (Reshape::calculateChromaAdj)

int filterTap( int taps, int frac, int i )
{
  int t = taps == 6 ? 0 : taps == 8 ? 1 : taps == 10 ? 2 : taps == 12 ? 3 : 4;
  return int( s_filters[( t * 32 + frac ) * 16 + i] );
}

int weak4( int frac, int i )
{
  return int( s_filters[WEAK4 + frac * 4 + i] );
}

// a reconstructed sample of an earlier block (all blocks read are reconstructed before the block is queued)
int recoAt( int comp, int x, int y )
{
  return int( CBufI16( P.plane[comp] ).v[P.origin[comp] + y * P.stride[comp] + x] );
}

int clip3i( int lo, int hi, int v )
{
  return min( max( v, lo ), hi );
}

int asPel( int v )   // the int16 Pel the CPU stores
{
  return int( int16_t( v ) );
}

// LMCS: the forward and inverse luma mappings (Reshape's LUTs)
int fwdLut( int v ) { return BufI32( P.lmcs ).v[v]; }
int invLut( int v ) { return BufI32( P.lmcs ).v[P.lmcsLutSize + v]; }

// Reshape::scalePel: the residual scaled by scale / 2^11 (CSCALE_FP_PREC), magnitude rounded; scale is an int16_t there
int scalePel( int val, int scale, int maxVal )
{
  const int sc   = int( int16_t( scale ) );
  const int sign = val < 0 ? -1 : 0;
  val = clip3i( ~maxVal, maxVal, val );
  val = ( val ^ sign ) - sign;
  int tmp = ( val * sc + ( 1 << 10 ) ) >> 11;
  tmp = ( tmp ^ sign ) - sign;
  return clip3i( -32768, 32767, tmp );
}

// the reference samples of line `line` (refSource: xFillReferenceSamples' unit availability and padding, or for ISP
// initIntraPatternChTypeISP), all invocations, no barrier, every sample fetched by its own invocation: the samples the
// prediction can read (the host's or intra_deps' superset; entries beyond are never read), top entries 0 ..
// readMax[line][0] at 0, left entries 0 .. readMax[line][1] at predStride
void fillReferencePar( Tu t, int line, int predStride, int lid, int NT )
{
  const int valueDC = 1 << ( t.bitDepth - 1 );
  const int numTop  = t.readMax[line][0] + 1;
  for( int e = lid; e < numTop + t.readMax[line][1] + 1; e += NT )
  {
    const bool top = e < numTop;
    const int  idx = top ? e : e - numTop;
    int sx, sy;
    const int v = refSource( t, line, top, idx, sx, sy ) ? recoAt( t.comp, sx, sy ) : valueDC;
    s_ref[line][top ? idx : idx + predStride] = int16_t( v );
  }
}

// reconstruction of sample (x, y) of block t from its prediction and residual (debug copy of the prediction for the
// verification)
void reconstruct( Tu t, int x, int y, int pr, int re )
{
  const int i = y * t.w + x;
  if( g_crs )   // the residual the CPU reconstructs with (and records, for the comparison)
  {
    re = scalePel( re, g_crsScale, ( 1 << t.bitDepth ) - 1 );
    if( pc.verify != 0 )
    {
      BufI16( P.dbgResi ).v[t.dbgOffset + i] = int16_t( re );
    }
  }
  CBufI16( P.plane[t.comp] ).v[P.origin[t.comp] + ( t.y + y ) * P.stride[t.comp] + t.x + x] = int16_t( clip3i( t.recMin, t.recMax, pr + re ) );
  if( pc.verify != 0 )
  {
    BufI16( P.dbgPred ).v[t.dbgOffset + i] = int16_t( pr );
  }
}

// predicted sample (x, y) of block t: reconstructed with the residual of intra_resi, or with joint CbCr and sign
// prediction with the one the decision in the pair's other block wrote (read device-coherent); with sign prediction
// kept until the signs are decided (signPrediction)
void storeRecon( Tu t, int x, int y, int pr )
{
  if( t.spCoded >= 0 )
  {
    s_spPred[y * t.w + x] = int16_t( pr );
    return;
  }
  const int o  = t.dbgOffset + y * t.w + x;
  const int re = t.resiFrom >= 0 ? int( CBufI16( P.dbgResi ).v[o] ) : int( BufI16( P.dbgResi ).v[o] );
  reconstruct( t, x, y, pr, re );
}

// sample (x, y) of the predicted region: reconstructed if it lies in the block (the region of an ISP sub-partition 1
// or 2 wide is 4 wide; the CPU predicts it once and each sub-partition takes its columns)
void storeRegion( Tu t, int x, int y, int pr )
{
  const int bx = x - ( t.x - t.regX );
  if( bx >= 0 && bx < t.w )
  {
    storeRecon( t, bx, y, pr );
  }
}

// a predicted sample of the region: reconstructed now, or kept for the bilateral filter
void emitPred( Tu t, int x, int y, int pr, bool bf )
{
  if( bf )
  {
    s_tmp[BF_PRED + y * t.regW + x] = int16_t( pr );
  }
  else
  {
    storeRegion( t, x, y, pr );
  }
}

// MIP's upsampling (MatrixIntraPrediction::predictionUpsampling) in closed form, each sample on its own: the CPU's
// running sums give before * (factor - pos) + behind * pos, rounded and shifted once. Horizontal stage: reduced row r
// at column x, between the reduced samples; the first segment starts from the left reference of the last row of the
// vertical segment r
int mipHor( int r, int x, int ps, int upH, int upV, int predStride )
{
  if( upH == 1 )
  {
    return s_mipRed[r * ps + x];
  }
  const int j = x / upH, pos = x % upH + 1, lg = findMSB( upH );
  const int before = j == 0 ? int( s_ref[0][predStride + ( r + 1 ) * upV] ) : s_mipRed[r * ps + j - 1];
  return ( before * ( upH - pos ) + s_mipRed[r * ps + j] * pos + ( 1 << ( lg - 1 ) ) ) >> lg;
}

// the MIP prediction of sample (x, y): the vertical stage over the horizontal one; the first segment starts from the
// top reference
int mipSample( int x, int y, int ps, int upH, int upV, int predStride )
{
  if( upV == 1 )
  {
    return mipHor( y, x, ps, upH, upV, predStride );
  }
  const int i = y / upV, pos = y % upV + 1, lg = findMSB( upV );
  const int before = i == 0 ? int( s_ref[0][1 + x] ) : mipHor( i - 1, x, ps, upH, upV, predStride );
  return ( before * ( upV - pos ) + mipHor( i, x, ps, upH, upV, predStride ) * pos + ( 1 << ( lg - 1 ) ) ) >> lg;
}

// workgroup sums of a and b (all invocations, uniform control flow; the slots are zero before)
ivec2 wgSum2( int a, int b, int slot )
{
  const int sa = subgroupAdd( a ), sb = subgroupAdd( b );
  if( subgroupElect() )
  {
    atomicAdd( s_red[slot], sa );
    atomicAdd( s_red[slot + 1], sb );
  }
  SYNC();
  return ivec2( s_red[slot], s_red[slot + 1] );
}

// bifApplyLut (the LUT row in s_bfLut, offset base: 0 distance 1, 16 diagonal, 32 distance 2)
int bfLut( int diff, int base, int cutBits, int bdShift )
{
  const int bitsRound  = 1 << ( cutBits - 2 );
  const int bitsRound2 = bitsRound + ( 1 << ( cutBits - 1 ) );
  const int v    = abs( diff );
  const int idx  = min( ( v + bitsRound ) >> cutBits, 15 );
  const int idx2 = min( ( v + bitsRound2 ) >> cutBits, 15 );
  const int w0   = ( ( int( s_bfLut[base + idx] ) + int( s_bfLut[base + idx2] ) + 1 ) >> 1 ) << bdShift;
  return diff < 0 ? -w0 : w0;
}

// main / side reference arrays of line l (main = above for vertical modes)
int mainR( bool isVer, int l, int i ) { return isVer ? int( s_angA[l][i] ) : int( s_angL[l][i] ); }
int sideR( bool isVer, int l, int i ) { return isVer ? int( s_angL[l][i] ) : int( s_angA[l][i] ); }
void mainW( bool isVer, int l, int i, int v ) { if( isVer ) s_angA[l][i] = int16_t( v ); else s_angL[l][i] = int16_t( v ); }

// the luma interpolation filter of xPredIntraAng for fraction frac (cubic N-tap table or the Gaussian formulas)
int lumaConv( bool isVer, int l, int base, int taps, bool cubic, bool big, int frac )
{
  int sum = 0;
  if( cubic )
  {
    for( int k = 0; k < taps; k++ ) sum += mainR( isVer, l, base + k ) * filterTap( taps, frac, k );
  }
  else
  {
    int f[6];
    if( big )
    {
      f[0] = 16 - ( frac >> 1 ); f[1] = 64 - 3 * ( frac >> 1 ); f[2] = 96 - frac;
      f[3] = 64 + frac;          f[4] = 16 + 3 * ( frac >> 1 ); f[5] = frac >> 1;
    }
    else
    {
      f[0] = 0; f[1] = 64 - ( frac << 1 ); f[2] = 128 - ( frac << 1 ); f[3] = 64 + ( frac << 1 ); f[4] = frac << 1; f[5] = 0;
    }
    for( int k = 0; k < 6; k++ ) sum += mainR( isVer, l, base + k ) * int( int16_t( f[k] ) );
  }
  return sum;
}

// sign prediction, decoder side (TrQuant::predCoeffSigns), once the block is predicted (into s_spPred), then its
// reconstruction (all invocations). The border the neighbours predict (TU::predBorderResi: twice the reconstructed
// sample next to the block minus the one beyond it, or the mid-level value at the picture's left / top edge, minus
// the prediction; the left column bottom-up, then the top row; only the left column at the top edge and the top row
// at the left edge count) is compared with the border of the residual of each sign hypothesis: that of intra_resi
// with every predicted sign positive, minus twice the template of each negative one (as two halves), in 16 bits
// like the CPU's Pel (with LMCS chroma scaling, reshapeChroma, scaled). The sums of absolute differences,
// shifted left by 8 with the hypothesis in the low bits (bit b: predicted coefficient n - 1 - b negative), rank the
// hypotheses; the signs are then decided in order: the coded sign says whether the prediction from the best
// hypothesis was right, and after a wrong one the best is searched again among the hypotheses that agree with the
// signs decided. Where a decided sign is negative the residual is computed again (dequantization, LFNST or NSPT and
// both transform stages as in intra_resi, with joint CbCr also the other component's, for the other block of the pair,
// which waits for this one).
void signPrediction( Tu t, int lid, int NT )
{
  const Tu  c = t.spCoded == g_ti ? t : BufTu( P.tus ).v[t.spCoded];   // the block with the coefficients
  const int W = t.w, H = t.h, N = W * H, len = W + H;
  BufI32    sp   = BufI32( P.signPred );
  BufI16    resi = BufI16( P.dbgResi );
  const int n = sp.v[c.spOffset + SP_NUM], codedSigns = sp.v[c.spOffset + SP_SIGNS];
  const bool useLeft = t.x != 0 || t.y == 0, useTop = t.y != 0 || t.x == 0;
  const int  first = useLeft ? 0 : H, last = useTop ? len : H;
  for( int j = lid; j < len; j += NT )
  {
    const bool left = j < H;
    const int  x = left ? 0 : j - H, y = left ? H - 1 - j : 0;   // the block's sample at border entry j
    int predicted = 1 << ( t.bitDepth - 1 );
    if( left ? t.x != 0 : t.y != 0 )
    {
      const int nextTo = left ? recoAt( t.comp, t.x - 1, t.y + y ) : recoAt( t.comp, t.x + x, t.y - 1 );
      const int beyond = left ? recoAt( t.comp, t.x - 2, t.y + y ) : recoAt( t.comp, t.x + x, t.y - 2 );
      predicted = asPel( 2 * nextTo - beyond );
    }
    s_spBorder[j] = int16_t( predicted - int( s_spPred[y * W + x] ) );
    s_spBase[j]   = resi.v[t.dbgOffset + y * W + x];
  }
  for( int i = lid; i < n * len; i += NT )
  {
    s_spTempl[i] = int16_t( sp.v[c.spOffset + SP_TEMPLATES + i] );
  }
  SYNC();
  for( int i = lid; i < 16 * len; i += NT )   // the halves (hypothesis bit b selects coefficient n - 1 - b)
  {
    const int j = i >> 4, h = i & 15;
    int low = int( s_spBase[j] ), high = 0;
    for( int b = 0; b < 4; b++ )
    {
      if( ( ( h >> b ) & 1 ) != 0 && b < n )
      {
        low -= 2 * int( s_spTempl[( n - 1 - b ) * len + j] );
      }
      if( ( ( h >> b ) & 1 ) != 0 && b + 4 < n )
      {
        high -= 2 * int( s_spTempl[( n - 5 - b ) * len + j] );
      }
    }
    s_spLow[i]  = int16_t( low );
    s_spHigh[i] = int16_t( high );
  }
  SYNC();
  // the cost of each hypothesis s: its border residual is the sum of the halves its low and high four bits select
  const int maxPel = ( 1 << t.bitDepth ) - 1;
  for( int s = lid; s < ( 1 << n ); s += NT )
  {
    const int low = s & 15, high = s >> 4;
    uint cost = 0;
    for( int j = first; j < last; j++ )
    {
      int v = asPel( int( s_spLow[j * 16 + low] ) + int( s_spHigh[j * 16 + high] ) );
      if( g_crs )
      {
        v = scalePel( v, g_crsScale, maxPel );
      }
      cost += uint( abs( int( s_spBorder[j] ) - v ) );
    }
    s_spCost[s] = ( cost << 8 ) | uint( s );
  }
  SYNC();
  // the decision, made alike by every subgroup (no barrier, no shared copy)
  uint minIdx = 0, base = 0, signMask = 1u << n;
  bool wrong    = true;   // the previous prediction was wrong (or none yet): search the best hypothesis again
  int  negative = 0;      // bit k: predicted coefficient k is negative
  for( int k = 0; k < n; k++ )
  {
    if( wrong )
    {
      uint m = 0xffffffffu;
      for( uint idx = base + gl_SubgroupInvocationID; idx < base + signMask; idx += gl_SubgroupSize )
      {
        m = min( m, s_spCost[idx] );
      }
      minIdx = subgroupMin( m ) & 0xffu;
    }
    signMask >>= 1;
    const bool predSign = ( minIdx & signMask ) != 0;
    wrong = ( ( codedSigns >> k ) & 1 ) != 0;   // the coded sign: whether the predicted one was wrong
    if( predSign != wrong )
    {
      negative |= 1 << k;
      base += signMask;
    }
  }
  const bool recompute = negative != 0;
  BufI32     mt        = BufI32( P.matrices );
  BufI8      kernels   = BufI8( P.secKernels );
  const int  nsptShift = c.shift1 + c.shift2 - 7;
  if( recompute )
  {
    // the coefficients with the decided signs, dequantized (for NSPT only its inputs, in scan order), with LFNST its
    // outputs over them (as in intra_resi), then the first stage
    BufI32    cf  = BufI32( P.coeffs );
    const int nzR = c.nzRows, nzC = c.nzCols, addDq = dequantAdd( c );
    int       negativeAt[8];   // the positions of the negative ones (x | y << 16), else -1
    for( int k = 0; k < 8; k++ )
    {
      negativeAt[k] = k < n && ( ( negative >> k ) & 1 ) != 0 ? sp.v[c.spOffset + SP_POS + k] : -1;
    }
    if( c.secKind == SEC_NSPT )
    {
      for( int i = lid; i < c.secNumIn; i += NT )
      {
        const int pos = mt.v[c.secScan + i], x = pos & 0xffff, y = pos >> 16;
        int       q   = y < nzR && x < nzC ? cf.v[c.coeffOffset + y * nzC + x] : 0;
        for( int k = 0; k < 8; k++ )
        {
          q = negativeAt[k] == pos ? -q : q;
        }
        s_secIn[i] = q != 0 ? dequant( c, q, addDq, mt, P.qcsOffset ) : 0;
      }
      SYNC();
    }
    else
    {
      for( int i = lid; i < nzR * nzC; i += NT )
      {
        const int pos = ( i % nzC ) | ( ( i / nzC ) << 16 );
        int       q   = cf.v[c.coeffOffset + i];
        for( int k = 0; k < 8; k++ )
        {
          q = negativeAt[k] == pos ? -q : q;
        }
        s_spCoef[i] = int16_t( q != 0 ? dequant( c, q, addDq, mt, P.qcsOffset ) : 0 );
      }
      SYNC();
      if( c.secKind == SEC_LFNST )
      {
        for( int i = lid; i < c.secNumIn; i += NT )
        {
          const int pos = mt.v[c.secScan + i];
          s_secIn[i] = int( s_spCoef[( pos >> 16 ) * nzC + ( pos & 0xffff )] );
        }
        SYNC();
        for( int j = lid; j < c.secRowLength; j += NT )
        {
          int sum = 0;
          for( int k = 0; k < c.secNumIn; k++ ) sum += s_secIn[k] * int( kernels.v[c.secMatrix + k * c.secRowLength + j] );
          s_lfnstOut[j] = clip3i( c.trMin, c.trMax, ( sum + 64 ) >> 7 );
        }
        SYNC();
        for( int j = lid; j < c.secRowLength; j += NT )
        {
          const int pos = mt.v[c.secLayout + j];
          s_spCoef[( pos >> 16 ) * nzC + ( pos & 0xffff )] = int16_t( s_lfnstOut[j] );
        }
        SYNC();
      }
      const int rnd1 = 1 << ( c.shift1 - 1 );
      for( int i = lid; i < nzC * H; i += NT )
      {
        const int xf = i / H, y = i % H;
        int sum = 0;
        for( int k = 0; k < nzR; k++ ) sum += mt.v[c.mtxV + k * H + y] * int( s_spCoef[k * nzC + xf] );
        s_spStage1[xf * H + y] = int16_t( clip3i( c.trMin, c.trMax, ( sum + rnd1 ) >> c.shift1 ) );
      }
      SYNC();
    }
  }
  // the second stage, sample by sample, and the reconstruction; the coded residual is this block's
  const int rnd2 = 1 << ( c.shift2 - 1 );
  const int derivedOffset = abs( c.jccr ) == 3 ? c.dbgOffset : c.jccrOffset;
  for( int i = lid; i < N; i += NT )
  {
    const int x = i % W, y = i / W;
    int re;
    if( recompute && c.secKind == SEC_NSPT )   // NSPT's matrix gives the residual (intra_resi)
    {
      const int jj = c.secTranspose != 0 ? x * H + y : i;
      int sum = 0;
      for( int k = 0; k < c.secNumIn; k++ ) sum += s_secIn[k] * int( kernels.v[c.secMatrix + k * c.secRowLength + jj] );
      re = clip3i( c.trMin, c.trMax, ( sum + ( 1 << ( nsptShift - 1 ) ) ) >> nsptShift );
    }
    else if( recompute )
    {
      int sum = 0;
      for( int k = 0; k < c.nzCols; k++ ) sum += mt.v[c.mtxH + k * W + x] * int( s_spStage1[k * H + y] );
      re = clip3i( c.trMin, c.trMax, ( sum + rnd2 ) >> c.shift2 );
    }
    if( recompute )
    {
      if( c.jccr != 0 )
      {
        CBufI16( P.dbgResi ).v[derivedOffset + i] = int16_t( jccrDerived( c.jccr, re ) );
      }
      if( pc.verify != 0 )
      {
        resi.v[t.dbgOffset + i] = int16_t( re );
      }
    }
    else
    {
      re = int( resi.v[t.dbgOffset + i] );
    }
    reconstruct( t, x, y, int( s_spPred[i] ), re );
  }
}

void main()
{
  const int lid = int( gl_LocalInvocationID.x );
  const int NT  = int( gl_WorkGroupSize.x );
  P = BufParams( pc.params ).p;
  if( BufI32( P.depStart ).v[pc.numTus] > P.edgeCap )   // intra_deps found more dependencies than fit: the host redoes it
  {
    return;
  }

  for( int i = lid; i < WEAK4 + 32 * 4; i += NT )   // filter taps fit int16 (TFilterCoeff)
  {
    s_filters[i] = int16_t( BufI32( P.filters ).v[i] );
  }
  for( int i = lid; i < ANG; i += NT )   // the angular arrays are zero between blocks
  {
    s_angA[0][i] = int16_t( 0 ); s_angL[0][i] = int16_t( 0 );
    s_angA[1][i] = int16_t( 0 ); s_angL[1][i] = int16_t( 0 );
  }
  if( lid == 0 )
  {
    s_next = -1;
  }
  for( ;; )
  {
    if( lid < 6 )
    {
      s_red[lid] = 0;
    }
    // the next block: the dependent this workgroup released last, else a queue position and (once filled) the
    // block at it; blocks handed over directly never enter the queue, so a position may stay empty: the workgroup
    // stops when all blocks are reconstructed
    SYNC();
    if( lid == 0 )
    {
      int b = s_next;
      s_next = -1;
      if( b < 0 )
      {
        b = pc.numTus;
        const int pos = atomicAdd( CBufI32( P.counter ).v[0], 1 );
        if( pos < pc.numTus )
        {
          for( ;; )
          {
            const int q = atomicLoad( CBufI32( P.queue ).v[pos], gl_ScopeQueueFamily, gl_StorageSemanticsBuffer, gl_SemanticsAcquire );
            if( q >= 0 )
            {
              b = q;
              break;
            }
            if( atomicLoad( CBufI32( P.counter ).v[2], gl_ScopeQueueFamily, 0, gl_SemanticsRelaxed ) >= pc.numTus )
            {
              break;
            }
          }
        }
      }
      s_ti = b;
    }
    SYNC();
    g_ti = s_ti;
    if( g_ti >= pc.numTus )
    {
      break;
    }
    Tu t = BufTu( P.tus ).v[g_ti];
    // the dependents, prefetched (their release ends the block)
    const int d0 = BufI32( P.depOffset ).v[g_ti], d1 = BufI32( P.depOffset ).v[g_ti + 1];
    if( lid < d1 - d0 )
    {
      s_deps[lid] = BufI32( P.depList ).v[d0 + lid];
    }
    int  angClear  = 0;
    bool angClear2 = false;
    // the predicted region (the block, or the 4-wide region of ISP sub-partitions 1 or 2 wide: storeRegion keeps the
    // block's columns) and the arm lengths of its references (m_topRefLength / m_leftRefLength: 8x the block, for ISP
    // the CU's size plus the region's)
    const int W = t.regW, H = t.h, N = W * H;
    const bool isp = t.isp != 0;
    const int topLen = isp ? t.cuW + W : W << 3, leftLen = isp ? t.cuH + H : H << 3;
    const int maxPel = ( 1 << t.bitDepth ) - 1;
    const int mrl = t.mrl;   // the reference line (MRL excludes planar, PDPC, the reference filter, MIP and ISP)
    const int predStride = topLen + 1 + mrl, predSize = topLen, predHSize = leftLen;
    const bool fusion = t.fusion != 0;

    // ----- LMCS chroma residual scaling (Reshape::calculateChromaAdjVpduNei with LMCS_CHROMA_CALC_CU): the rounded
    // mean of the luma column left of and the row above the CU (rows / columns beyond the picture replaced by the last
    // one), clipped, selects the scale; without neighbours the mid-level value does
    g_crs      = ( t.lmcs & 2 ) != 0;
    g_crsScale = 0;
    if( g_crs )
    {
      const bool hasLeft = ( t.crsAvail & 1 ) != 0, hasAbove = ( t.crsAvail & 2 ) != 0;
      int sum = 0;
      for( int k = lid; hasLeft && k < t.crsH; k += NT ) sum += recoAt( 0, t.crsX - 1, min( t.crsY + k, P.height[0] - 1 ) );
      for( int k = lid; hasAbove && k < t.crsW; k += NT ) sum += recoAt( 0, min( t.crsX + k, P.width[0] - 1 ), t.crsY - 1 );
      const int total  = wgSum2( sum, 0, 0 ).x;
      const int pelnum = ( hasLeft ? t.crsH : 0 ) + ( hasAbove ? t.crsW : 0 );
      const int lumaValue = pelnum > 0 ? clip3i( P.lumaClipMin, P.lumaClipMax, ( total + ( pelnum >> 1 ) ) / pelnum ) : P.lmcsLutSize >> 1;
      g_crsScale = BufI32( P.lmcs ).v[2 * P.lmcsLutSize + lumaValue];
    }

    // ----- reference samples (and the second line of intra fusion)
    fillReferencePar( t, 0, predStride, lid, NT );
    if( fusion )
    {
      fillReferencePar( t, 1, predStride + 1, lid, NT );
    }
    SYNC();
    if( t.refFilter != 0 )   // xFilterReferenceSamples (multiRefIdx 0), in place
    {
      for( int i = lid; i <= predStride + predHSize; i += NT )
      {
        int v;
        if( i == 0 || i == predStride )
        {
          v = ( int( s_ref[0][0] ) + int( s_ref[0][1] ) + int( s_ref[0][predStride] ) + int( s_ref[0][predStride + 1] ) + 2 ) >> 2;
        }
        else if( i == predSize || i == predStride + predHSize )
        {
          v = int( s_ref[0][i] );
        }
        else
        {
          v = ( int( s_ref[0][i - 1] ) + 2 * int( s_ref[0][i] ) + int( s_ref[0][i + 1] ) + 2 ) >> 2;
        }
        s_tmp[i] = int16_t( v );
      }
      SYNC();
      for( int i = lid; i <= predStride + predHSize; i += NT ) s_ref[0][i] = s_tmp[i];
      SYNC();
    }

    // ----- the intra bilateral filter (bilateralFilterPredDiamond5x5Clip, luma of intra slices; the host checked
    // the size, mode and QP): angular modes skip it for textured references (xPredIntaAng's isRefSampleMadSkipBf, the
    // mean absolute deviation of the (filtered) top and left reference arrays)
    bool bf = t.bf == 1;
    if( t.bf == 2 )
    {
      // the arms are 8x the block (never ISP), W, H <= 32: one sample per invocation
      const int a = lid < topLen ? int( s_ref[0][lid] ) : 0, b = lid < leftLen ? int( s_ref[0][predStride + lid] ) : 0;
      const ivec2 sum = wgSum2( a, b, 0 );
      const int lT = findMSB( topLen ), lL = findMSB( leftLen );
      const int avgT = ( sum.x + ( 1 << ( lT - 1 ) ) ) >> lT, avgL = ( sum.y + ( 1 << ( lL - 1 ) ) ) >> lL;
      const ivec2 dev = wgSum2( lid < topLen ? abs( a - avgT ) : 0, lid < leftLen ? abs( b - avgL ) : 0, 2 );
      const int madT = ( dev.x + ( 1 << ( lT - 1 ) ) ) >> lT, madL = ( dev.y + ( 1 << ( lL - 1 ) ) ) >> lL;
      bf = min( ( ( madT + madL + 1 ) >> 1 ) >> 4, 15 ) <= 10;
    }

    // ----- prediction and reconstruction
    if( t.mipMatrix >= 0 )   // MIP (MatrixIntraPrediction::prepareInputForPred, computeReducedPred, predictionUpsampling)
    {
      const int bs = t.mipSizeId == 0 ? 2 : 4, ps = t.mipSizeId < 2 ? 4 : 8, inSize = 2 * bs;
      // the reduced boundary: the Haar-downsampled top (entries 0 .. bs - 1) and left (bs .. 2 bs - 1) references
      if( lid < inSize )
      {
        const bool top = lid < bs;
        const int  k = top ? lid : lid - bs, f = ( top ? W : H ) / bs, lg = findMSB( f );
        int sum = 0;
        for( int j = 0; j < f; j++ ) sum += int( s_ref[0][( top ? 1 : predStride + 1 ) + k * f + j] );
        s_mipBdry[lid] = f > 1 ? ( sum + ( 1 << ( lg - 1 ) ) ) >> lg : sum;
      }
      SYNC();
      // the matrix input: [top, left], transposed [left, top], rebased on its first entry; that entry becomes the
      // difference to the mid level, or 0 for the large size class, whose matrices have no weight for it
      const bool transposed = t.mipTransposed != 0;
      int mipIn[8];
      for( int i = 0; i < inSize; i++ ) mipIn[i] = s_mipBdry[transposed ? ( i < bs ? bs + i : i - bs ) : i];
      const int inputOffset = mipIn[0];
      mipIn[0] = t.mipSizeId < 2 ? ( 1 << ( t.bitDepth - 1 ) ) - inputOffset : 0;
      int inSum = mipIn[0];
      for( int i = 1; i < inSize; i++ )
      {
        mipIn[i] -= inputOffset;
        inSum += mipIn[i];
      }
      // the reduced prediction, one sample per invocation (computed in the transposed order when transposed); the
      // large class's rows hold the weights of inputs 1 ..
      if( lid < ps * ps )
      {
        const int rowLen = t.mipSizeId == 2 ? inSize - 1 : inSize, first = t.mipSizeId == 2 ? 1 : 0;
        int sum = 0;
        for( int i = first; i < inSize; i++ ) sum += mipIn[i] * BufI32( P.matrices ).v[t.mipMatrix + lid * rowLen + i - first];
        const int offset = ( 1 << ( 6 - 1 ) ) - 32 * inSum;   // MIP_SHIFT_MATRIX 6, MIP_OFFSET_MATRIX 32
        s_mipRed[transposed ? ( lid % ps ) * ps + lid / ps : lid] = clip3i( 0, maxPel, ( ( sum + offset ) >> 6 ) + inputOffset );
      }
      SYNC();
      const int upH = W / ps, upV = H / ps;
      for( int i = lid; i < N; i += NT ) emitPred( t, i % W, i / W, mipSample( i % W, i / W, ps, upH, upV, predStride ), bf );
    }
    else if( t.dirMode == 0 || t.dirMode == 1 )   // planar / DC, then their PDPC
    {
      const int log2W = findMSB( W ), log2H = findMSB( H );
      if( t.dirMode == 1 && lid == 0 )   // xGetPredValDc: from entry multiRefIdx + 1 on
      {
        int denom = ( W == H ) ? ( W << 1 ) : max( W, H );
        int sum = 0;
        if( W >= H ) for( int k = 0; k < W; k++ ) sum += int( s_ref[0][mrl + 1 + k] );
        if( W <= H ) for( int k = 0; k < H; k++ ) sum += int( s_ref[0][predStride + mrl + 1 + k] );
        s_dc = ( sum + ( denom >> 1 ) ) >> findMSB( denom );
      }
      SYNC();
      const int topRight = int( s_ref[0][1 + W] ), bottomLeft = int( s_ref[0][predStride + 1 + H] );
      const int offset = 1 << ( log2W + log2H ), finalShift = 1 + log2W + log2H;
      const int pdpcScale = ( log2W - 2 + log2H - 2 + 2 ) >> 2;
      for( int i = lid; i < N; i += NT )
      {
        int x = i % W, y = i / W;
        int T = int( s_ref[0][1 + x] ), L = int( s_ref[0][predStride + 1 + y] );
        int v;
        if( t.dirMode == 1 )
        {
          v = s_dc;
        }
        else
        {
          int horPred  = ( L << log2W ) + ( x + 1 ) * ( topRight - L );
          int vertPred = ( T << log2H ) + ( y + 1 ) * ( bottomLeft - T );
          if( t.plIdx == 1 )      v = ( horPred + ( 1 << ( log2W - 1 ) ) ) >> log2W;
          else if( t.plIdx == 2 ) v = ( vertPred + ( 1 << ( log2H - 1 ) ) ) >> log2H;
          else                    v = ( ( horPred << log2H ) + ( vertPred << log2W ) + offset ) >> finalShift;
        }
        v = asPel( v );
        if( t.applyPDPC != 0 )   // xIntraPredPlanarDcPdpc
        {
          const int wT = 32 >> min( 31, ( y << 1 ) >> pdpcScale );
          const int wL = 32 >> min( 31, ( x << 1 ) >> pdpcScale );
          v = asPel( v + ( ( wL * ( L - v ) + wT * ( T - v ) + 32 ) >> 6 ) );
        }
        emitPred( t, i % W, i / W, v, bf );
      }
    }
    else   // angular (xPredIntraAng)
    {
      const bool isVer = t.isModeVer != 0;
      const int angle = t.intraPredAngle, absInvAngle = t.absInvAngle;
      // the arrays are zero on entry (cleared after use, like the CPU's persistent buffers); every entry below is
      // computed directly from the reference lines (the CPU's copies, padding, end replication and negative-angle
      // extension), so one barrier suffices
      const int topRefLength = topLen, leftRefLength = leftLen;
      const int mrl2 = mrl + 1, predStride2 = predStride + 1;   // the fusion line (multiRefIdx2nd)
      const int sizeSide = isVer ? H : W;
      const int refLength = isVer ? topRefLength : leftRefLength;
      const int log2Ratio = findMSB( W ) - findMSB( H );
      const int sh = max( 0, isVer ? log2Ratio : -log2Ratio );
      int mainBase, sideBase, mainBase2, sideBase2;
      if( angle < 0 )
      {
        mainBase = ( isVer ? H : W ) + PAD;
        sideBase = ( isVer ? W : H ) + PAD;
        for( int i = lid; i < W + PAD + 2 + mrl; i += NT ) s_angA[0][H + PAD + i] = s_ref[0][i];
        for( int i = lid; i < H + PAD + 2 + mrl; i += NT ) s_angL[0][W + PAD + i] = s_ref[0][predStride + i];
        // side entry j (copied above) = the reference line itself
        const int sideOff = isVer ? predStride : 0;
        const int sideRange = sizeSide + 2 + mrl;
        for( int k = -( sizeSide + PAD ) + lid; k <= -1; k += NT )
        {
          int frac32precision = ( -k * absInvAngle + 8 ) >> 4;
          int intpel = frac32precision >> 5, fracpel = frac32precision & 31;
          int left  = int( s_ref[0][sideOff + clip3i( 0, sideRange, intpel ) ] );
          int right = int( s_ref[0][sideOff + clip3i( 0, sideRange, intpel + 1 ) ] );
          int v;
          if( t.disableRefFilter != 0 )
          {
            v = fracpel > 15 ? right : left;
          }
          else
          {
            int lm1 = int( s_ref[0][sideOff + clip3i( 0, sideRange, intpel - 1 ) ] );
            int rp1 = int( s_ref[0][sideOff + clip3i( 0, sideRange, intpel + 2 ) ] );
            v = clip3i( 0, maxPel, ( weak4( fracpel, 0 ) * lm1 + weak4( fracpel, 1 ) * left + weak4( fracpel, 2 ) * right + weak4( fracpel, 3 ) * rp1 + 32 ) >> 6 );
          }
          mainW( isVer, 0, mainBase + k, v );
        }
        mainBase2 = mainBase + 1;
        sideBase2 = sideBase + 1;
        if( fusion )
        {
          for( int i = lid; i < topRefLength + PAD + mrl2; i += NT ) s_angA[1][H + PAD + 1 + i] = s_ref[1][i];
          for( int i = lid; i < leftRefLength + PAD + mrl2; i += NT ) s_angL[1][W + PAD + 1 + i] = s_ref[1][predStride2 + i];
          const int sideOff2 = isVer ? predStride2 : 0;
          const int sizeSideRange = ( isVer ? leftRefLength : topRefLength ) + mrl2;
          for( int k = -( sizeSide + 1 + PAD ) + lid; k <= -1; k += NT )
          {
            int frac32precision = ( -k * absInvAngle + 8 ) >> 4;
            int intpel = frac32precision >> 5, fracpel = frac32precision & 31;
            int left  = int( s_ref[1][sideOff2 + clip3i( 0, sizeSideRange, intpel ) ] );
            int right = int( s_ref[1][sideOff2 + clip3i( 0, sizeSideRange, intpel + 1 ) ] );
            int v;
            if( t.disableRefFilter != 0 )
            {
              v = fracpel > 15 ? right : left;
            }
            else
            {
              int lm1 = int( s_ref[1][sideOff2 + clip3i( 0, sizeSideRange, intpel - 1 ) ] );
              int rp1 = int( s_ref[1][sideOff2 + clip3i( 0, sizeSideRange, intpel + 2 ) ] );
              v = clip3i( 0, maxPel, ( weak4( fracpel, 0 ) * lm1 + weak4( fracpel, 1 ) * left + weak4( fracpel, 2 ) * right + weak4( fracpel, 3 ) * rp1 + 32 ) >> 6 );
            }
            mainW( isVer, 1, mainBase2 + k, v );
          }
        }
      }
      else
      {
        mainBase = PAD;
        sideBase = PAD;
        // above: PAD copies of entry 0, then the top row (read on past the row, as the CPU's memcpy does); left alike;
        // the main array's end (entry refLength + multiRefIdx) is replicated over maxIndex + PAD entries
        const int maxIndex = ( mrl << sh ) + 6;
        const int end0 = PAD + refLength + mrl;
        const int val  = int( s_ref[0][( isVer ? 0 : predStride ) + refLength + mrl] );
        const int lenA = isVer ? end0 + maxIndex + PAD + 1 : PAD + topRefLength + mrl + PAD;
        const int lenL = isVer ? PAD + leftRefLength + mrl + PAD : end0 + maxIndex + PAD + 1;
        for( int j = lid; j < lenA; j += NT )
        {
          const int v = isVer && j > end0 ? val : j < PAD ? int( s_ref[0][0] ) : int( s_ref[0][j - PAD] );
          s_angA[0][j] = int16_t( v );
        }
        for( int j = lid; j < lenL; j += NT )
        {
          const int v = !isVer && j > end0 ? val : j < PAD ? int( s_ref[0][predStride] ) : int( s_ref[0][predStride + j - PAD] );
          s_angL[0][j] = int16_t( v );
        }
        if( fusion )
        {
          const int maxIndex2 = ( mrl2 << sh ) + 6 + 4;
          const int end1 = PAD + refLength + mrl2;
          const int val2 = int( s_ref[1][( isVer ? 0 : predStride2 ) + refLength + mrl2] );
          const int lenA2 = isVer ? end1 + maxIndex2 + PAD + 1 : PAD + topRefLength + mrl2 + PAD;
          const int lenL2 = isVer ? PAD + leftRefLength + mrl2 + PAD : end1 + maxIndex2 + PAD + 1;
          for( int j = lid; j < lenA2; j += NT )
          {
            const int v = isVer && j > end1 ? val2 : j < PAD ? int( s_ref[1][0] ) : int( s_ref[1][j - PAD] );
            s_angA[1][j] = int16_t( v );
          }
          for( int j = lid; j < lenL2; j += NT )
          {
            const int v = !isVer && j > end1 ? val2 : j < PAD ? int( s_ref[1][predStride2] ) : int( s_ref[1][predStride2 + j - PAD] );
            s_angL[1][j] = int16_t( v );
          }
        }
        mainBase2 = PAD;
        sideBase2 = PAD;
      }
      // the prediction reads the arrays from the reference line's own corner on (refMain += multiRefIdx, refMain2nd +=
      // multiRefIdx2nd)
      mainBase += mrl;
      sideBase += mrl;
      mainBase2 += mrl2;
      sideBase2 += mrl2;
      // cleared after the block (IntraPrediction's angRefClearEnd)
      angClear = min( ANG, 2 * ( W + H ) + max( topRefLength, leftRefLength ) + 2 * PAD + 2 * mrl2 + ( mrl2 << abs( log2Ratio ) ) + 16 );
      angClear2 = fusion;
      SYNC();
      // rows along the main direction (width/height swapped for horizontal modes)
      const int w = isVer ? W : H, h = isVer ? H : W;
      const bool isLuma = t.comp == 0;
      int taps = 0;
      if( isLuma )
      {
        taps = t.useCubic != 0 ? 16 : 6;
        if( w < 8 && taps > 10 ) taps = 10;
      }
      const int numExtra = taps / 2 - 2;
      const bool intSlope = ( abs( angle ) & 31 ) == 0;
      const bool big = W >= 32 && H >= 32;
      const int pdpcLimit = t.applyPDPC != 0 ? min( 3 << ( angle == 0 ? ( ( findMSB( w ) + findMSB( h ) - 2 ) >> 2 ) : t.angularScale ), w ) : 0;
      for( int i = lid; i < N; i += NT )
      {
        int x = i % w, y = i / w;   // position in the (possibly transposed) block
        int v;
        if( angle == 0 )
        {
          v = mainR( isVer, 0, mainBase + 1 + x );
          if( x < pdpcLimit )
          {
            const int scale = ( findMSB( w ) + findMSB( h ) - 2 ) >> 2;
            const int topLeft = mainR( isVer, 0, mainBase ), left = sideR( isVer, 0, sideBase + 1 + y );
            const int wL = 32 >> ( 2 * x >> scale );
            v = clip3i( 0, maxPel, v + ( ( wL * ( left - topLeft ) + 32 ) >> 6 ) );
          }
        }
        else
        {
          const int deltaPos = angle * ( y + 1 + mrl );
          const int deltaInt = deltaPos >> 5, deltaFract = deltaPos & 31;
          if( intSlope )
          {
            v = mainR( isVer, 0, mainBase + deltaInt + 1 + x );
          }
          else if( isLuma )
          {
            const bool cubic = t.useCubic != 0;
            const int c0 = lumaConv( isVer, 0, mainBase + deltaInt + x - numExtra, taps, cubic, big, deltaFract );
            int val32;
            if( fusion )
            {
              const int deltaInt2 = ( deltaPos + angle ) >> 5, deltaFract2 = ( deltaPos + angle ) & 31;
              const int c1 = lumaConv( isVer, 1, mainBase2 + deltaInt2 + x - numExtra, taps, cubic, big, deltaFract2 );
              val32 = ( 3 * c0 + 1 * c1 + 128 * 4 ) >> ( 8 + 2 );
            }
            else
            {
              val32 = ( c0 + 128 ) >> 8;
            }
            v = clip3i( 0, maxPel, clip3i( 0, maxPel, val32 ) );
          }
          else
          {
            const int p0 = mainR( isVer, 0, mainBase + deltaInt + x + 1 ), p1 = mainR( isVer, 0, mainBase + deltaInt + x + 2 );
            v = asPel( p0 + ( ( deltaFract * ( p1 - p0 ) + 16 ) >> 5 ) );
          }
          v = asPel( v );
          if( x < pdpcLimit )
          {
            const int scale = t.angularScale;
            const int wL = 32 >> ( 2 * x >> scale );
            if( t.gradPDPC != 0 )
            {
              const int left = sideR( isVer, 0, sideBase + 1 + y );
              const int m0 = mainR( isVer, 0, mainBase + deltaInt ), m1 = mainR( isVer, 0, mainBase + deltaInt + 1 );
              const int topLeft = asPel( m0 + ( ( deltaFract * ( m1 - m0 ) + 16 ) >> 5 ) );
              v = clip3i( 0, maxPel, v + ( ( wL * ( left - topLeft ) + 32 ) >> 6 ) );
            }
            else
            {
              const int invAngleSum = 256 + ( x + 1 ) * absInvAngle;
              const int left = sideR( isVer, 0, sideBase + y + ( invAngleSum >> 9 ) + 1 );
              v = asPel( v + ( ( wL * ( left - v ) + 32 ) >> 6 ) );
            }
          }
        }
        const int ox = isVer ? x : y, oy = isVer ? y : x;
        emitPred( t, ox, oy, asPel( v ), bf );
      }
    }
    SYNC();
    if( bf )
    {
      // with LMCS the filter works on the inverse-mapped prediction and reconstruction, and its output (also when the
      // gate skips the filter) is mapped back (bilateralFilterPredDiamond5x5Clip)
      const bool lmcsBf = ( t.lmcs & 1 ) != 0;
      if( lmcsBf )
      {
        for( int i = lid; i < N; i += NT ) s_tmp[BF_PRED + i] = int16_t( invLut( int( s_tmp[BF_PRED + i] ) ) );
        SYNC();
      }
      // getFilterLutParameters: the mean absolute deviation of the prediction gates the filter and sets its strength
      const int log2W = findMSB( W ), log2H = findMSB( H ), whlog2 = log2W + log2H;
      const int bdShift = max( 0, t.bitDepth - 10 );
      if( lid < 48 )
      {
        s_bfLut[lid] = int16_t( BufI32( P.filters ).v[BF_LUT + clip3i( 0, 25, t.qp - 17 ) * 48 + lid] );
      }
      int acc = 0;
      for( int i = lid; i < N; i += NT ) acc += int( s_tmp[BF_PRED + i] );
      const int avg = ( wgSum2( acc, 0, 4 ).x + ( 1 << ( whlog2 - 1 ) ) ) >> whlog2;
      acc = 0;
      for( int i = lid; i < N; i += NT ) acc += abs( int( s_tmp[BF_PRED + i] ) - avg );
      int mad = ( wgSum2( 0, acc, 4 ).y + ( 1 << ( whlog2 - 1 ) ) ) >> whlog2;
      mad = ( mad + ( bdShift == 0 ? 0 : 1 << ( bdShift - 1 ) ) ) >> bdShift;
      mad = min( mad >> 4, 15 );
      if( mad < 10 )
      {
        const int bfac = BufI32( P.filters ).v[BF_SIZE + min( log2W, 7 ) * 8 + min( log2H, 7 )] + BufI32( P.filters ).v[BF_MAD + mad];
        // the block padded by two samples as the CPU builds it in rows of S samples (iWidthExtSIMD): the prediction
        // mirrored (columns, then rows), then the reconstruction around the CU's origin (for ISP sub-partitions the
        // CU's, with the CU's units) where its neighbours are available: with all of them the corner, the W above and
        // H left samples; else the corner, the left units but the bottom one and the above units but the last one.
        // Those writes go row by row at the CPU's stride, so the above units of an ISP sub-partition narrower than its
        // CU run past the row into the next ones; the last write wins (the CPU's order: corner, left, above, each
        // column writing row y - 2 at 2 + c and row y - 1 at S + 2 + c)
        const int PW = W + 4, S = W < 8 ? 12 : ( W + 4 ) | 4;
        const int bx = isp ? t.cuX : t.x, by = isp ? t.cuY : t.y;
        const int numAbove = max( ( isp ? t.cuW : W ) / t.unitW, 1 ), numLeft = max( ( isp ? t.cuH : H ) / t.unitH, 1 );
        const int corner = t.bfAvail[0], pA = t.bfAvail[1], pL = t.bfAvail[2];
        const bool all = corner != 0 && pA == numAbove && pL == numLeft;
        const int topRec  = all ? W : min( pA, numAbove - 1 ) * t.unitW;   // the above columns written
        const int leftRec = all ? H : min( pL, numLeft - 1 ) * t.unitH;    // the left rows written
        for( int i = lid; i < PW * ( H + 4 ); i += NT )
        {
          const int py = i / PW, px = i % PW;
          const int y = py - 2, x = px - 2;
          const int L = py * S + px, c0 = L - 2, c1 = L - S - 2;   // the position at the CPU's stride, its columns
          int sx = 0, sy = 0;
          bool rec = true;
          if( c0 >= 0 && c0 < topRec )
          {
            sx = bx + c0;
            sy = by - 2;
          }
          else if( c1 >= 0 && c1 < topRec )
          {
            sx = bx + c1;
            sy = by - 1;
          }
          else if( px < 2 && y >= 0 && y < leftRec )
          {
            sx = bx - 2 + px;
            sy = by + y;
          }
          else if( px < 2 && py < 2 && corner != 0 )
          {
            sx = bx - 2 + px;
            sy = by - 2 + py;
          }
          else
          {
            rec = false;
          }
          int v;
          if( rec )
          {
            v = recoAt( 0, sx, sy );
            v = lmcsBf ? invLut( v ) : v;
          }
          else
          {
            const int my = py == 0 ? 1 : py == 1 ? 0 : py == H + 3 ? H - 2 : py == H + 2 ? H - 1 : y;
            const int mx = px == 0 ? 1 : px == 1 ? 0 : px == W + 3 ? W - 2 : px == W + 2 ? W - 1 : x;
            v = int( s_tmp[BF_PRED + my * W + mx] );
          }
          s_tmp[BF_BLK + i] = int16_t( v );
        }
        SYNC();
        // the 5x5 diamond (blockBilateralFilterDiamond5x5 with isIntraPredBf), then the prediction plus the
        // filtered difference, clipped
        const int cutBits = 3 + bdShift;
        for( int i = lid; i < N; i += NT )
        {
          const int x = i % W, y = i / W;
          const int c = BF_BLK + ( y + 2 ) * PW + x + 2;
          const int p = int( s_tmp[c] );
          int modsum = 0;
          modsum += bfLut( int( s_tmp[c - 1] ) - p, 0, cutBits, bdShift );
          modsum += bfLut( int( s_tmp[c + 1] ) - p, 0, cutBits, bdShift );
          modsum += bfLut( int( s_tmp[c - PW] ) - p, 0, cutBits, bdShift );
          modsum += bfLut( int( s_tmp[c + PW] ) - p, 0, cutBits, bdShift );
          modsum += bfLut( int( s_tmp[c - PW - 1] ) - p, 16, cutBits, bdShift );
          modsum += bfLut( int( s_tmp[c - PW + 1] ) - p, 16, cutBits, bdShift );
          modsum += bfLut( int( s_tmp[c + PW - 1] ) - p, 16, cutBits, bdShift );
          modsum += bfLut( int( s_tmp[c + PW + 1] ) - p, 16, cutBits, bdShift );
          modsum += bfLut( int( s_tmp[c - 2] ) - p, 32, cutBits, bdShift );
          modsum += bfLut( int( s_tmp[c + 2] ) - p, 32, cutBits, bdShift );
          modsum += bfLut( int( s_tmp[c - 2 * PW] ) - p, 32, cutBits, bdShift );
          modsum += bfLut( int( s_tmp[c + 2 * PW] ) - p, 32, cutBits, bdShift );
          const int filt = asPel( ( modsum * bfac + 128 ) >> 8 );   // (BIF_ROUND_ADD / 2) << 3, BIF_ROUND_SHIFT - 1 + 3
          const int filtered = clip3i( 0, maxPel, filt + p );
          storeRegion( t, x, y, lmcsBf ? fwdLut( filtered ) : filtered );
        }
      }
      else
      {
        for( int i = lid; i < N; i += NT )
        {
          const int pr = int( s_tmp[BF_PRED + i] );
          storeRegion( t, i % W, i / W, lmcsBf ? fwdLut( pr ) : pr );
        }
      }
    }
    if( t.spCoded >= 0 )   // the prediction is complete: decide the signs, reconstruct
    {
      SYNC();
      signPrediction( t, lid, NT );
    }

    // the block's samples (device-coherent stores of all invocations) happen before its dependents are released:
    // the last dependency of a block to finish takes it over (one per block, the workgroup continues with it) or
    // queues it
    controlBarrier( gl_ScopeWorkgroup, gl_ScopeQueueFamily, gl_StorageSemanticsBuffer, gl_SemanticsAcquireRelease );
    for( int k = lid; k < d1 - d0; k += NT )
    {
      const int d = k < 256 ? s_deps[k] : BufI32( P.depList ).v[d0 + k];
      if( atomicAdd( CBufI32( P.depCount ).v[d], -1, gl_ScopeQueueFamily, gl_StorageSemanticsBuffer, gl_SemanticsAcquireRelease ) == 1 )
      {
        if( atomicCompSwap( s_next, -1, d ) != -1 )
        {
          const int pos = atomicAdd( CBufI32( P.counter ).v[1], 1 );
          atomicStore( CBufI32( P.queue ).v[pos], d, gl_ScopeQueueFamily, gl_StorageSemanticsBuffer, gl_SemanticsRelease );
        }
      }
    }
    if( lid == 0 )
    {
      atomicAdd( CBufI32( P.counter ).v[2], 1 );   // reconstructed blocks
    }
    for( int i = lid; i < angClear; i += NT )
    {
      s_angA[0][i] = int16_t( 0 );
      s_angL[0][i] = int16_t( 0 );
      if( angClear2 )
      {
        s_angA[1][i] = int16_t( 0 );
        s_angL[1][i] = int16_t( 0 );
      }
    }
  }
}
