#version 460
#pragma use_vulkan_memory_model
// residuals of all intra transform blocks of a picture at once (they depend on no other block): dequantization
// (Quant::dequant, or DepQuant's dequantBlock with dependent quantization, either with QCS; without scaling lists)
// folded into the first inverse transform stage, then the second stage (TrQuant::xIT: two clipped matrix stages with
// the matrices the host reads back from xIT's transform functions, DCT-II or the MTS types, whose integer sums and
// single rounding equal those of the functions, butterflies included; one stage for the 1-D transforms of ISP
// sub-partitions 1 wide or high), or with transform skip the dequantized levels
// themselves (BDPCM: the host accumulates the levels first). With LFNST the host gives the dequantized, inverse-LFNST'ed
// coefficients, with NSPT the residual itself (Tu::precomputed). The result
// goes to the residual buffer intra_rec adds to its prediction, with joint CbCr together with the other chroma
// component's residual derived from it. With sign prediction the predicted signs are positive here, and the templates
// of the predicted coefficients go to the signPred buffer: intra_rec decides the signs and, where one is negative,
// computes the residual again. Persistent workgroups take blocks by index.
// Don't keep the first stage's output in a global scratch buffer: while other processes shared the GPU (RTX 3070),
// whole warps of the second stage read it before the other warps' writes had reached it, although the barrier between
// the stages had workgroup and even device scope.
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
#include "intra_common.glsl"

layout( local_size_x = 256 ) in;

// the first stage's output, clipped to the transform range (16 bits without extended precision, which the host
// rejects): column xf of the levels at xf * H + y
shared int16_t s_stage1[128 * 128];

int clip3i( int lo, int hi, int v )
{
  return min( max( v, lo ), hi );
}

void main()
{
  const int lid = int( gl_LocalInvocationID.x );
  const int NT  = int( gl_WorkGroupSize.x );
  Params P = BufParams( pc.params ).p;
  BufI32 cf = BufI32( P.coeffs );
  BufI32 mt = BufI32( P.matrices );
  BufI16 resi = BufI16( P.dbgResi );

  for( int ti = int( gl_WorkGroupID.x ); ti < pc.numTus; ti += int( gl_NumWorkGroups.x ) )
  {
    const Tu t = BufTu( P.tus ).v[ti];
    const int W = t.w, H = t.h, N = W * H;
    if( t.jccr == 4 )   // the Cr block of a joint CbCr pair: the Cb block writes its residual
    {
      continue;
    }
    // where the residual goes: with joint CbCr, the coded component's, and the derived one's
    const int codedOffset   = abs( t.jccr ) == 3 ? t.jccrOffset : t.dbgOffset;
    const int derivedOffset = abs( t.jccr ) == 3 ? t.dbgOffset : t.jccrOffset;
    if( t.cbf == 0 )
    {
      for( int i = lid; i < N; i += NT ) resi.v[t.dbgOffset + i] = int16_t( 0 );
      for( int i = lid; t.jccr != 0 && i < N; i += NT ) resi.v[t.jccrOffset + i] = int16_t( 0 );
      continue;
    }
    const int offH = t.mtxV, offW = t.mtxH;
    const int rnd1 = 1 << ( t.shift1 - 1 ), rnd2 = 1 << ( t.shift2 - 1 );
    const int addDq = dequantAdd( t );
    // the levels lie in rows < nzRows, columns < nzCols: the skipped terms are zero, and so is the first stage of an
    // all-zero column ((0 + rnd1) >> shift1), which the second stage then needs not read
    const int nzR = t.nzRows, nzC = t.nzCols;
    // TrQuant::xITransformSkip: the residual is the dequantized level (clipped to 16 bits); or the host's residual
    if( t.transformSkip != 0 || t.precomputed == 2 )
    {
      for( int i = lid; i < N; i += NT )
      {
        const int y = i / W, x = i % W;
        const int q = y < nzR && x < nzC ? cf.v[t.coeffOffset + y * nzC + x] : 0;
        const int r = t.precomputed == 2 || q == 0 ? q : dequant( t, q, addDq, mt, P.qcsOffset );
        resi.v[codedOffset + i] = int16_t( r );
        if( t.jccr != 0 )
        {
          resi.v[derivedOffset + i] = int16_t( jccrDerived( t.jccr, r ) );
        }
      }
      continue;
    }
    // TrQuant::xIT's 1-D transform (ISP sub-partitions 1 wide or high): one stage along the block, shift_2nd + 1,
    // over the coefficients k < nzRows (a column) or k < nzCols (a row), stored at k either way
    if( W == 1 || H == 1 )
    {
      const int off = W == 1 ? t.mtxV : t.mtxH, nz = W == 1 ? nzR : nzC, shift = t.shift2 + 1;
      for( int i = lid; i < N; i += NT )
      {
        int sum = 0;
        for( int k = 0; k < nz; k++ )
        {
          const int q = cf.v[t.coeffOffset + k];
          if( q != 0 )
          {
            sum += mt.v[off + k * N + i] * ( t.precomputed != 0 ? q : dequant( t, q, addDq, mt, P.qcsOffset ) );
          }
        }
        resi.v[codedOffset + i] = int16_t( clip3i( t.trMin, t.trMax, ( sum + ( 1 << ( shift - 1 ) ) ) >> shift ) );
      }
      continue;
    }
    // sign prediction (TrQuant::predCoeffSigns' templates, createTemplate): per predicted coefficient the left column
    // (bottom-up) and the top row of the residual of that coefficient alone with the amplitude 1 << 8 (xIT of one
    // coefficient: one product per stage), times its dequantized magnitude, >> 8. The host gave the predicted
    // coefficients positive: the residual below is the one the decision in intra_rec starts from
    if( t.spOffset >= 0 )
    {
      BufI32 sp = BufI32( P.signPred );
      const int len = W + H, num = sp.v[t.spOffset + SP_NUM];
      for( int i = lid; i < num * len; i += NT )
      {
        const int k = i / len, j = i % len;
        const int pos = sp.v[t.spOffset + SP_POS + k], px = pos & 0xffff, py = pos >> 16;
        const int r = j < H ? H - 1 - j : 0, c = j < H ? 0 : j - H;
        const int stage1   = clip3i( t.trMin, t.trMax, ( mt.v[offH + py * H + r] * 256 + rnd1 ) >> t.shift1 );
        const int basis    = clip3i( t.trMin, t.trMax, ( mt.v[offW + px * W + c] * stage1 + rnd2 ) >> t.shift2 );
        const int coeffVal = dequant( t, cf.v[t.coeffOffset + py * nzC + px], addDq, mt, P.qcsOffset );
        sp.v[t.spOffset + SP_TEMPLATES + i] = int( int16_t( ( coeffVal * basis + 128 ) >> 8 ) );   // a Pel
      }
    }
    // first stage (vertical): s_stage1[xf * H + y] from the dequantized coefficient column xf
    for( int i = lid; i < nzC * H; i += NT )
    {
      const int xf = i / H, y = i % H;
      int sum = 0;
      for( int k = 0; k < nzR; k++ )
      {
        const int q = cf.v[t.coeffOffset + k * nzC + xf];
        if( q != 0 )
        {
          sum += mt.v[offH + k * H + y] * ( t.precomputed != 0 ? q : dequant( t, q, addDq, mt, P.qcsOffset ) );
        }
      }
      s_stage1[xf * H + y] = int16_t( clip3i( t.trMin, t.trMax, ( sum + rnd1 ) >> t.shift1 ) );
    }
    barrier();
    // second stage (horizontal): residual[y * W + x]
    for( int i = lid; i < N; i += NT )
    {
      const int y = i / W, x = i % W;
      int sum = 0;
      for( int k = 0; k < nzC; k++ ) sum += mt.v[offW + k * W + x] * int( s_stage1[k * H + y] );
      const int r = clip3i( t.trMin, t.trMax, ( sum + rnd2 ) >> t.shift2 );
      resi.v[codedOffset + i] = int16_t( r );
      if( t.jccr != 0 )
      {
        resi.v[derivedOffset + i] = int16_t( jccrDerived( t.jccr, r ) );
      }
    }
    barrier();
  }
}
