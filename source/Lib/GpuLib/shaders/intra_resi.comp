#version 460
#pragma use_vulkan_memory_model
// residuals of all intra transform blocks of a picture at once (they depend on no other block): dequantization
// (Quant::dequant, or DepQuant's dequantBlock with dependent quantization, either with QCS; without scaling lists)
// folded into the first inverse transform stage, then the second stage (TrQuant::xIT: two clipped matrix stages with
// the matrices the host reads back from xIT's transform functions, DCT-II or the MTS types, whose integer sums and
// single rounding equal those of the functions, butterflies included; one stage for the 1-D transforms of ISP
// sub-partitions 1 wide or high), or with transform skip the dequantized levels
// themselves (BDPCM: the host accumulates the levels first). With LFNST (TrQuant::xInvLfnst) the coefficients of the
// top-left region go through its matrix before the primary transform; NSPT's matrix (xInvNspt) replaces the primary
// transform (both matrices are the CPU's int8 tables, chosen by the host). The result
// goes to the residual buffer intra_rec adds to its prediction, with joint CbCr together with the other chroma
// component's residual derived from it. With sign prediction the predicted signs are positive here, and the templates
// of the predicted coefficients go to the signPred buffer: intra_rec decides the signs and, where one is negative,
// computes the residual again. Persistent workgroups take blocks by index.
// Don't keep the first stage's output in a global scratch buffer: while other processes shared the GPU (RTX 3070),
// whole warps of the second stage read it before the other warps' writes had reached it, although the barrier between
// the stages had workgroup and even device scope.
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
#include "intra_common.glsl"

layout( local_size_x = 256 ) in;

// the first stage's output, clipped to the transform range (16 bits without extended precision, which the host
// rejects): column xf of the levels at xf * H + y
shared int16_t s_stage1[128 * 128];
// LFNST / NSPT: their inputs (dequantized, in scan order); LFNST: the dequantized coefficients of the top-left region
// (16 x 16 at most) with its outputs written over them, and its outputs before that
shared int     s_secIn[64];
shared int     s_lfnst[16 * 16];
shared int     s_lfnstOut[96];

int clip3i( int lo, int hi, int v )
{
  return min( max( v, lo ), hi );
}

void main()
{
  const int lid = int( gl_LocalInvocationID.x );
  const int NT  = int( gl_WorkGroupSize.x );
  Params P = BufParams( pc.params ).p;
  BufI32 cf = BufI32( P.coeffs );
  BufI32 mt = BufI32( P.matrices );
  BufI16 resi = BufI16( P.dbgResi );

  for( int ti = int( gl_WorkGroupID.x ); ti < pc.numTus; ti += int( gl_NumWorkGroups.x ) )
  {
    const Tu t = BufTu( P.tus ).v[ti];
    const int W = t.w, H = t.h, N = W * H;
    // a CU's mode derivation (intra_rec), or the Cr block of a joint CbCr pair, whose residual the Cb block writes
    if( ( t.derive & DERIVE_NODE ) != 0 || t.jccr == 4 )
    {
      continue;
    }
    // where the residual goes: with joint CbCr, the coded component's, and the derived one's
    const int codedOffset   = abs( t.jccr ) == 3 ? t.jccrOffset : t.dbgOffset;
    const int derivedOffset = abs( t.jccr ) == 3 ? t.dbgOffset : t.jccrOffset;
    if( t.cbf == 0 )
    {
      for( int i = lid; i < N; i += NT ) resi.v[t.dbgOffset + i] = int16_t( 0 );
      for( int i = lid; t.jccr != 0 && i < N; i += NT ) resi.v[t.jccrOffset + i] = int16_t( 0 );
      continue;
    }
    const int offH = t.mtxV, offW = t.mtxH;
    const int rnd1 = 1 << ( t.shift1 - 1 ), rnd2 = 1 << ( t.shift2 - 1 );
    const int addDq = dequantAdd( t );
    // the levels lie in rows < nzRows, columns < nzCols: the skipped terms are zero, and so is the first stage of an
    // all-zero column ((0 + rnd1) >> shift1), which the second stage then needs not read
    const int nzR = t.nzRows, nzC = t.nzCols;
    // TrQuant::xITransformSkip: the residual is the dequantized level (clipped to 16 bits)
    if( t.transformSkip != 0 )
    {
      for( int i = lid; i < N; i += NT )
      {
        const int y = i / W, x = i % W;
        const int q = y < nzR && x < nzC ? cf.v[t.coeffOffset + y * nzC + x] : 0;
        const int r = q == 0 ? 0 : dequant( t, q, addDq, mt, P.qcsOffset );
        resi.v[codedOffset + i] = int16_t( r );
        if( t.jccr != 0 )
        {
          resi.v[derivedOffset + i] = int16_t( jccrDerived( t.jccr, r ) );
        }
      }
      continue;
    }
    // TrQuant::xIT's 1-D transform (ISP sub-partitions 1 wide or high): one stage along the block, shift_2nd + 1,
    // over the coefficients k < nzRows (a column) or k < nzCols (a row), stored at k either way
    if( W == 1 || H == 1 )
    {
      const int off = W == 1 ? t.mtxV : t.mtxH, nz = W == 1 ? nzR : nzC, shift = t.shift2 + 1;
      for( int i = lid; i < N; i += NT )
      {
        int sum = 0;
        for( int k = 0; k < nz; k++ )
        {
          const int q = cf.v[t.coeffOffset + k];
          if( q != 0 )
          {
            sum += mt.v[off + k * N + i] * dequant( t, q, addDq, mt, P.qcsOffset );
          }
        }
        resi.v[codedOffset + i] = int16_t( clip3i( t.trMin, t.trMax, ( sum + ( 1 << ( shift - 1 ) ) ) >> shift ) );
      }
      continue;
    }
    BufI8 kernels = BufI8( P.secKernels );
    // NSPT (TrQuant::xInvNspt, computeInvNspt): the first secNumIn dequantized coefficients in scan order times its
    // matrix are the residual, each rounded and shifted by shift_1st + shift_2nd - 7 and clipped
    if( t.secKind == SEC_NSPT )
    {
      for( int i = lid; i < t.secNumIn; i += NT )
      {
        const int pos = mt.v[t.secScan + i], x = pos & 0xffff, y = pos >> 16;
        const int q   = y < nzR && x < nzC ? cf.v[t.coeffOffset + y * nzC + x] : 0;
        s_secIn[i] = q != 0 ? dequant( t, q, addDq, mt, P.qcsOffset ) : 0;
      }
      barrier();
      const int shift = t.shift1 + t.shift2 - 7;
      for( int i = lid; i < N; i += NT )
      {
        const int y = i / W, x = i % W, j = t.secTranspose != 0 ? x * H + y : i;
        int sum = 0;
        for( int k = 0; k < t.secNumIn; k++ ) sum += s_secIn[k] * int( kernels.v[t.secMatrix + k * t.secRowLength + j] );
        const int r = clip3i( t.trMin, t.trMax, ( sum + ( 1 << ( shift - 1 ) ) ) >> shift );
        resi.v[codedOffset + i] = int16_t( r );
        if( t.jccr != 0 )
        {
          resi.v[derivedOffset + i] = int16_t( jccrDerived( t.jccr, r ) );
        }
      }
      // sign prediction (TrQuant::predCoeffSigns' templates of LFNST / NSPT blocks, createTemplateLFNST): NSPT of a
      // predicted coefficient alone (amplitude 1 << 8 at its scan index) is its residual; at the border, times the
      // coefficient's dequantized magnitude, >> 8
      if( t.spOffset >= 0 )
      {
        BufI32    sp  = BufI32( P.signPred );
        const int len = W + H, num = sp.v[t.spOffset + SP_NUM];
        for( int i = lid; i < num * len; i += NT )
        {
          const int k = i / len, j = i % len;
          const int pos = sp.v[t.spOffset + SP_POS + k], px = pos & 0xffff, py = pos >> 16;
          int       scanIdx = 0;   // its index in the scan (the predicted coefficients lie among the first 16)
          while( scanIdx < t.secNumIn && mt.v[t.secScan + scanIdx] != pos )
          {
            scanIdx++;
          }
          const int r = j < H ? H - 1 - j : 0, c = j < H ? 0 : j - H;
          const int jj = t.secTranspose != 0 ? c * H + r : r * W + c;
          const int k8 = scanIdx < t.secNumIn ? int( kernels.v[t.secMatrix + scanIdx * t.secRowLength + jj] ) : 0;
          const int basis    = clip3i( t.trMin, t.trMax, ( 256 * k8 + ( 1 << ( shift - 1 ) ) ) >> shift );
          const int coeffVal = dequant( t, cf.v[t.coeffOffset + py * nzC + px], addDq, mt, P.qcsOffset );
          sp.v[t.spOffset + SP_TEMPLATES + i] = int( int16_t( ( coeffVal * basis + 128 ) >> 8 ) );   // a Pel
        }
      }
      barrier();
      continue;
    }
    // LFNST (TrQuant::xInvLfnst, invLfnstNxN): the coefficients' region is its top-left square (nzRows = nzCols =
    // secSize); its first secNumIn dequantized coefficients in scan order times its matrix, rounded by 7 bits and
    // clipped, overwrite the coefficients at its output positions
    if( t.secKind == SEC_LFNST )
    {
      for( int i = lid; i < nzR * nzC; i += NT )
      {
        const int q = cf.v[t.coeffOffset + i];
        s_lfnst[i] = q != 0 ? dequant( t, q, addDq, mt, P.qcsOffset ) : 0;
      }
      barrier();
      for( int i = lid; i < t.secNumIn; i += NT )
      {
        const int pos = mt.v[t.secScan + i];
        s_secIn[i] = s_lfnst[( pos >> 16 ) * nzC + ( pos & 0xffff )];
      }
      barrier();
      for( int j = lid; j < t.secRowLength; j += NT )
      {
        int sum = 0;
        for( int k = 0; k < t.secNumIn; k++ ) sum += s_secIn[k] * int( kernels.v[t.secMatrix + k * t.secRowLength + j] );
        s_lfnstOut[j] = clip3i( t.trMin, t.trMax, ( sum + 64 ) >> 7 );
      }
      barrier();
      for( int j = lid; j < t.secRowLength; j += NT )
      {
        const int pos = mt.v[t.secLayout + j];
        s_lfnst[( pos >> 16 ) * nzC + ( pos & 0xffff )] = s_lfnstOut[j];
      }
      barrier();
    }
    // sign prediction (TrQuant::predCoeffSigns' templates, createTemplate): per predicted coefficient the left column
    // (bottom-up) and the top row of the residual of that coefficient alone with the amplitude 1 << 8 (xIT of one
    // coefficient: one product per stage), times its dequantized magnitude, >> 8 (with LFNST after the residual, below).
    // The host gave the predicted coefficients positive: the residual below is the one the decision in intra_rec
    // starts from
    if( t.spOffset >= 0 && t.secKind == SEC_NONE )
    {
      BufI32 sp = BufI32( P.signPred );
      const int len = W + H, num = sp.v[t.spOffset + SP_NUM];
      for( int i = lid; i < num * len; i += NT )
      {
        const int k = i / len, j = i % len;
        const int pos = sp.v[t.spOffset + SP_POS + k], px = pos & 0xffff, py = pos >> 16;
        const int r = j < H ? H - 1 - j : 0, c = j < H ? 0 : j - H;
        const int stage1   = clip3i( t.trMin, t.trMax, ( mt.v[offH + py * H + r] * 256 + rnd1 ) >> t.shift1 );
        const int basis    = clip3i( t.trMin, t.trMax, ( mt.v[offW + px * W + c] * stage1 + rnd2 ) >> t.shift2 );
        const int coeffVal = dequant( t, cf.v[t.coeffOffset + py * nzC + px], addDq, mt, P.qcsOffset );
        sp.v[t.spOffset + SP_TEMPLATES + i] = int( int16_t( ( coeffVal * basis + 128 ) >> 8 ) );   // a Pel
      }
    }
    // first stage (vertical): s_stage1[xf * H + y] from the dequantized coefficient column xf (with LFNST its output)
    for( int i = lid; i < nzC * H; i += NT )
    {
      const int xf = i / H, y = i % H;
      int sum = 0;
      for( int k = 0; k < nzR; k++ )
      {
        if( t.secKind == SEC_LFNST )
        {
          sum += mt.v[offH + k * H + y] * s_lfnst[k * nzC + xf];
          continue;
        }
        const int q = cf.v[t.coeffOffset + k * nzC + xf];
        if( q != 0 )
        {
          sum += mt.v[offH + k * H + y] * dequant( t, q, addDq, mt, P.qcsOffset );
        }
      }
      s_stage1[xf * H + y] = int16_t( clip3i( t.trMin, t.trMax, ( sum + rnd1 ) >> t.shift1 ) );
    }
    barrier();
    // second stage (horizontal): residual[y * W + x]
    for( int i = lid; i < N; i += NT )
    {
      const int y = i / W, x = i % W;
      int sum = 0;
      for( int k = 0; k < nzC; k++ ) sum += mt.v[offW + k * W + x] * int( s_stage1[k * H + y] );
      const int r = clip3i( t.trMin, t.trMax, ( sum + rnd2 ) >> t.shift2 );
      resi.v[codedOffset + i] = int16_t( r );
      if( t.jccr != 0 )
      {
        resi.v[derivedOffset + i] = int16_t( jccrDerived( t.jccr, r ) );
      }
    }
    barrier();
    // sign prediction's templates of an LFNST block (createTemplateLFNST): per predicted coefficient the region with the
    // LFNST of that coefficient alone (amplitude 1 << 8 at its scan index, the others zero), its first stage and the
    // second stage at the border, times the coefficient's dequantized magnitude, >> 8 (s_lfnst and s_stage1 are free
    // again)
    if( t.spOffset >= 0 && t.secKind == SEC_LFNST )
    {
      BufI32    sp  = BufI32( P.signPred );
      const int len = W + H, num = sp.v[t.spOffset + SP_NUM];
      for( int k = 0; k < num; k++ )
      {
        const int pos = sp.v[t.spOffset + SP_POS + k];
        int       scanIdx = 0;   // its index in the scan (the predicted coefficients lie among the first 16)
        while( scanIdx < t.secNumIn && mt.v[t.secScan + scanIdx] != pos )
        {
          scanIdx++;
        }
        for( int i = lid; i < nzR * nzC; i += NT )
        {
          s_lfnst[i] = 0;
        }
        barrier();
        for( int j = lid; j < t.secRowLength && scanIdx < t.secNumIn; j += NT )
        {
          const int lp = mt.v[t.secLayout + j];
          s_lfnst[( lp >> 16 ) * nzC + ( lp & 0xffff )] =
            clip3i( t.trMin, t.trMax, ( 256 * int( kernels.v[t.secMatrix + scanIdx * t.secRowLength + j] ) + 64 ) >> 7 );
        }
        barrier();
        for( int i = lid; i < nzC * H; i += NT )
        {
          const int xf = i / H, y = i % H;
          int sum = 0;
          for( int ky = 0; ky < nzR; ky++ ) sum += mt.v[offH + ky * H + y] * s_lfnst[ky * nzC + xf];
          s_stage1[xf * H + y] = int16_t( clip3i( t.trMin, t.trMax, ( sum + rnd1 ) >> t.shift1 ) );
        }
        barrier();
        const int coeffVal = dequant( t, cf.v[t.coeffOffset + ( pos >> 16 ) * nzC + ( pos & 0xffff )], addDq, mt, P.qcsOffset );
        for( int j = lid; j < len; j += NT )
        {
          const int r = j < H ? H - 1 - j : 0, c = j < H ? 0 : j - H;
          int sum = 0;
          for( int xf = 0; xf < nzC; xf++ ) sum += mt.v[offW + xf * W + c] * int( s_stage1[xf * H + r] );
          const int basis = clip3i( t.trMin, t.trMax, ( sum + rnd2 ) >> t.shift2 );
          sp.v[t.spOffset + SP_TEMPLATES + k * len + j] = int( int16_t( ( coeffVal * basis + 128 ) >> 8 ) );   // a Pel
        }
        barrier();
      }
    }
  }
}
