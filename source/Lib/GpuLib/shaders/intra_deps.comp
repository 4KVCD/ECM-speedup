#version 460
// the scheduling data of intra_rec, computed on the GPU from the block records: geometry, decoding order and syntax
// only, with the same rules as GpuIntraRec's host version (which the verification mode compares). One invocation
// per block; pc.verify selects the pass:
//   0  the owner maps (each block writes its index over its units; the maps are -1 before). ISP sub-partitions 1 or
//      2 wide or high share units: the last one owns them, as on the host (atomicMax)
//   1  per block the read ranges and the availability (written into the block record) and its number of
//      dependencies (depCount)
//   2  the dependencies (depTmp at depStart, the exclusive prefix sum of pass 1) and per block the number of its
//      dependents (numDep)
//   3  the dependents lists (depList at depOffset, the prefix sum of numDep; numDep is zero again and counts the
//      entries) and the queue seeded with the blocks without dependencies
// Passes 2 and 3 write nothing when the dependencies exceed edgeCap (intra_rec then does nothing either and the
// host computes the data itself).
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
#include "intra_common.glsl"

layout( local_size_x = 64 ) in;

const int PAD  = 6;    // interpFilterNumPadded
const int UNIQ = 32;   // the dependencies of a block deduplicated exactly (beyond: duplicates, harmless)

Params P;
int    g_i, g_ch, g_pass;
int    g_count, g_base;
int    g_uniq[UNIQ];
int    g_numUniq;

int ownerAt( int c, int x, int y )
{
  if( x < 0 || y < 0 || ( x >> P.unitLog2X[g_ch] ) >= P.ownerW[g_ch] || ( y >> P.unitLog2Y[g_ch] ) >= P.ownerH[g_ch] )
  {
    return -1;
  }
  return BufI32( P.owner[c] ).v[( y >> P.unitLog2Y[g_ch] ) * P.ownerW[g_ch] + ( x >> P.unitLog2X[g_ch] )];
}

// the block owning luma sample (x, y) inside the picture (the reads of chroma residual scaling)
int ownerLumaAt( int x, int y )
{
  return BufI32( P.owner[0] ).v[( y >> P.unitLog2Y[0] ) * P.ownerW[0] + ( x >> P.unitLog2X[0] )];
}

bool availAt( int c, int x, int y )
{
  const int a = ownerAt( c, x, y );
  return a >= 0 && a < g_i;
}

void addDep( int o )
{
  if( o < 0 || o >= g_i )
  {
    return;
  }
  for( int k = 0; k < g_numUniq; k++ )
  {
    if( g_uniq[k] == o )
    {
      return;
    }
  }
  if( g_numUniq < UNIQ )
  {
    g_uniq[g_numUniq++] = o;
  }
  if( g_pass == 2 )
  {
    BufI32( P.depTmp ).v[g_base + g_count] = o;
    atomicAdd( BufI32( P.numDep ).v[o], 1 );
  }
  g_count++;
}

// GpuIntraRec::endPicture's dependency loop for block g_i (passes 1 and 2); pass 1 writes the availability, read
// ranges and ISP side flag into the block record, which refSource reads (from the local copy) and pass 2 reloads
void dependencies( int comp )
{
  Tu t = BufTu( P.tus ).v[g_i];
  const int availComp = t.comp == 0 ? 0 : 1;
  for( int ln = 0; ln < 2; ln++ )
  {
    for( int k = 0; k < 7; k++ ) t.avail[ln][k] = 0;
    t.readMax[ln][0] = 0;
    t.readMax[ln][1] = 0;
  }
  for( int k = 0; k < 3; k++ ) t.bfAvail[k] = 0;
  t.ispSide = 0;
  // the area the references are filled for: the block with arms of 8x its size, for ISP the CU with arms of twice its
  // size; the prediction's arm lengths (m_topRefLength / m_leftRefLength): 8x the block, for ISP the CU's size plus
  // the prediction region's
  const bool isp = t.isp != 0;
  const int  fx = isp ? t.cuX : t.x, fy = isp ? t.cuY : t.y, fw = isp ? t.cuW : t.w, fh = isp ? t.cuH : t.h;
  const int  predSize = isp ? 2 * t.cuW : t.w << 3, predHSize = isp ? 2 * t.cuH : t.h << 3;
  const int  numAbove = max( fw / t.unitW, 1 ), numLeft = max( fh / t.unitH, 1 );
  const int  tAU = predSize / t.unitW, tLU = predHSize / t.unitH;
  const int  W = t.regW, H = t.h, topLen = isp ? t.cuW + W : W << 3, leftLen = isp ? t.cuH + H : H << 3;
  if( isp )   // the side of the sub-partition along the split (initIntraPatternChTypeISP's isLeftAvail / isAboveAvail)
  {
    t.ispSide = ( t.isp == 1 ? availAt( availComp, t.cuX - 1, t.y ) : availAt( availComp, t.regX, t.cuY - 1 ) ) ? 1 : 0;
  }
  for( int ln = 0; ln <= ( t.fusion != 0 ? 1 : 0 ); ln++ )
  {
    const int mrl = t.mrl + ln;   // the reference line (multiRefIdx; the fusion line is the next one)
    // the read range: the main line (multiRefIdx k = t.mrl), or the fusion line (k + 1, non-integer slopes)
    const int rf = t.refFilter != 0 ? 1 : 0;
    int topMax, leftMax;
    if( t.dirMode == 0 )   // never with MRL
    {
      topMax  = W + 1 + rf;
      leftMax = H + 1 + rf;
    }
    else if( t.dirMode == 1 )   // from entry multiRefIdx + 1 on
    {
      topMax  = W + 1 + mrl;
      leftMax = H + 1 + mrl;
    }
    else
    {
      const bool ver = t.isModeVer != 0;
      const int  w = ver ? W : H, h = ver ? H : W, refLength = ver ? topLen : leftLen, sideLength = ver ? leftLen : topLen;
      const int  angle = t.intraPredAngle;
      int mainMax, sideMax;
      if( ln == 0 )
      {
        if( angle == 0 )
        {
          mainMax = w + 1 + mrl;
          sideMax = t.applyPDPC != 0 ? h + 1 : 1 + mrl;
        }
        else if( angle < 0 )
        {
          mainMax = w + PAD + 2 + mrl;
          sideMax = h + PAD + 2 + mrl;
        }
        else
        {
          mainMax = min( refLength + mrl, ( ( angle * ( h + mrl ) ) >> 5 ) + w + 10 + mrl );
          sideMax = 1 + mrl;
          if( t.applyPDPC != 0 )
          {
            const int limit = min( 3 << t.angularScale, w );
            sideMax = t.gradPDPC != 0 ? h + 1 : min( sideLength, h + ( ( 256 + limit * t.absInvAngle ) >> 9 ) + 1 );
          }
        }
        mainMax += rf;
        sideMax += rf;
      }
      else
      {
        if( angle < 0 )
        {
          mainMax = w + PAD + 9 + mrl;
          sideMax = min( sideLength + mrl, ( ( ( h + 1 + PAD ) * t.absInvAngle + 8 ) >> 4 >> 5 ) + 2 + mrl );
        }
        else
        {
          mainMax = min( refLength + mrl, ( ( angle * ( h + mrl ) ) >> 5 ) + w + 11 + mrl );
          sideMax = mrl;
        }
      }
      topMax  = ver ? mainMax : sideMax;
      leftMax = ver ? sideMax : mainMax;
    }
    if( t.bf == 2 && ln == 0 )
    {
      topMax  = topLen;
      leftMax = leftLen;
    }
    t.readMax[ln][0] = max( mrl, min( topMax, topLen + mrl ) );
    t.readMax[ln][1] = max( mrl, min( leftMax, leftLen + mrl ) );

    // the availability (ISP: the CU's unit groups scanned whole)
    const int x0 = fx - 1 - mrl, y0 = fy - 1 - mrl;
    const int lM = mrl / t.unitH, aM = mrl / t.unitW;
    const int unitsTop  = isp ? tAU : t.readMax[ln][0] >= 1 + mrl ? ( t.readMax[ln][0] - 1 - mrl ) / t.unitW + 1 : 0;
    const int unitsLeft = isp ? tLU : t.readMax[ln][1] >= 1 + mrl ? ( t.readMax[ln][1] - 1 - mrl ) / t.unitH + 1 : 0;
    const int limA  = max( 1, min( numAbove, unitsTop ) );
    const int limAR = max( 1, min( tAU - numAbove, unitsTop - numAbove ) );
    const int limL  = max( 1, min( numLeft, unitsLeft ) );
    const int limBL = max( 1, min( tLU - numLeft, unitsLeft - numLeft ) );
    t.avail[ln][0] = availAt( availComp, x0, y0 ) ? 1 : 0;
    int k;
    for( k = 0; k < limA && availAt( availComp, fx + k * t.unitW, y0 ); k++ ) {}
    t.avail[ln][1] = k;
    for( k = 0; k < limAR && availAt( availComp, fx + fw - 1 + t.unitW + k * t.unitW, y0 ); k++ ) {}
    t.avail[ln][2] = k;
    for( k = 0; k < limL && availAt( availComp, x0, fy + k * t.unitH ); k++ ) {}
    t.avail[ln][3] = k;
    for( k = 0; k < limBL && availAt( availComp, x0, fy + fh - 1 + t.unitH + k * t.unitH ); k++ ) {}
    t.avail[ln][4] = k;
    for( k = 0; k < lM && availAt( availComp, x0, fy - lM * t.unitH + k * t.unitH ); k++ ) {}   // left MRL, downwards
    t.avail[ln][5] = k;
    for( k = 0; k < aM && availAt( availComp, fx - aM * t.unitW + k * t.unitW, y0 ); k++ ) {}   // above MRL, rightwards
    t.avail[ln][6] = k;

    if( t.bf != 0 && ln == 0 )   // the bilateral filter's neighbours (rows y-2, y-1; columns x-2, x-1)
    {
      // its padding: line 0's corner and above / left units of the CU (the block, for ISP the CU, whose origin it
      // pads at), also with MRL; a superset of the samples it copies
      int bfA, bfL;
      for( bfA = 0; bfA < numAbove && availAt( availComp, fx + bfA * t.unitW, fy - 1 ); bfA++ ) {}
      for( bfL = 0; bfL < numLeft && availAt( availComp, fx - 1, fy + bfL * t.unitH ); bfL++ ) {}
      t.bfAvail[0] = availAt( availComp, fx - 1, fy - 1 ) ? 1 : 0;
      t.bfAvail[1] = bfA;
      t.bfAvail[2] = bfL;
      if( t.bfAvail[0] != 0 )
      {
        addDep( ownerAt( comp, fx - 2, fy - 2 ) );
        addDep( ownerAt( comp, fx - 1, fy - 2 ) );
        addDep( ownerAt( comp, fx - 2, fy - 1 ) );
        addDep( ownerAt( comp, fx - 1, fy - 1 ) );
      }
      for( int x = 0; x < bfA * t.unitW; x++ )
      {
        addDep( ownerAt( comp, fx + x, fy - 2 ) );
        addDep( ownerAt( comp, fx + x, fy - 1 ) );
      }
      for( int y = 0; y < bfL * t.unitH; y++ )
      {
        addDep( ownerAt( comp, fx - 2, fy + y ) );
        addDep( ownerAt( comp, fx - 1, fy + y ) );
      }
    }
    // the owners of the samples in range (intra_rec's fill rule); consecutive samples mostly share an owner
    int lastOwner = -2;
    for( int side = 0; side < 2; side++ )
    {
      for( int idx = 0; idx <= t.readMax[ln][side]; idx++ )
      {
        int sx, sy;
        if( refSource( t, ln, side == 0, idx, sx, sy ) )
        {
          const int o = ownerAt( comp, sx, sy );
          if( o != lastOwner )
          {
            addDep( o );
            lastOwner = o;
          }
        }
      }
    }
  }
  if( t.ispPrev >= 0 )   // the chain of an ISP CU's sub-partitions
  {
    addDep( t.ispPrev );
  }
  if( g_pass == 1 )
  {
    BufTu( P.tus ).v[g_i].avail   = t.avail;
    BufTu( P.tus ).v[g_i].readMax = t.readMax;
    BufTu( P.tus ).v[g_i].bfAvail = t.bfAvail;
    BufTu( P.tus ).v[g_i].ispSide = t.ispSide;
  }
  if( ( t.lmcs & 2 ) != 0 )   // LMCS chroma residual scaling: the luma column left of and the row above the CU, clipped
  {
    if( ( t.crsAvail & 1 ) != 0 )
    {
      for( int k = 0; k < t.crsH; k++ ) addDep( ownerLumaAt( t.crsX - 1, min( t.crsY + k, P.height[0] - 1 ) ) );
    }
    if( ( t.crsAvail & 2 ) != 0 )
    {
      for( int k = 0; k < t.crsW; k++ ) addDep( ownerLumaAt( min( t.crsX + k, P.width[0] - 1 ), t.crsY - 1 ) );
    }
  }
}

void main()
{
  g_i    = int( gl_GlobalInvocationID.x );
  g_pass = pc.verify;
  if( g_i >= pc.numTus )
  {
    return;
  }
  P = BufParams( pc.params ).p;
  const int comp = BufTu( P.tus ).v[g_i].comp;
  g_ch = comp == 0 ? 0 : 1;
  const int total = BufI32( P.depStart ).v[pc.numTus];   // valid in passes 2 and 3 (after the prefix sum)
  if( g_pass == 0 )
  {
    const Tu t = BufTu( P.tus ).v[g_i];
    for( int uy = t.y >> P.unitLog2Y[g_ch]; uy <= ( t.y + t.h - 1 ) >> P.unitLog2Y[g_ch]; uy++ )
    {
      for( int ux = t.x >> P.unitLog2X[g_ch]; ux <= ( t.x + t.w - 1 ) >> P.unitLog2X[g_ch]; ux++ )
      {
        atomicMax( BufI32( P.owner[comp] ).v[uy * P.ownerW[g_ch] + ux], g_i );
      }
    }
  }
  else if( g_pass == 1 || g_pass == 2 )
  {
    if( g_pass == 2 && total > P.edgeCap )
    {
      return;
    }
    g_count   = 0;
    g_numUniq = 0;
    g_base    = g_pass == 2 ? BufI32( P.depStart ).v[g_i] : 0;
    dependencies( comp );
    if( g_pass == 1 )
    {
      BufI32( P.depCount ).v[g_i] = g_count;
    }
  }
  else
  {
    if( total > P.edgeCap )
    {
      return;
    }
    const int b = BufI32( P.depStart ).v[g_i], e = BufI32( P.depStart ).v[g_i + 1];
    for( int k = b; k < e; k++ )
    {
      const int d = BufI32( P.depTmp ).v[k];
      BufI32( P.depList ).v[BufI32( P.depOffset ).v[d] + atomicAdd( BufI32( P.numDep ).v[d], 1 )] = g_i;
    }
    if( e == b )
    {
      BufI32( P.queue ).v[atomicAdd( BufI32( P.counter ).v[1], 1 )] = g_i;
    }
  }
}
