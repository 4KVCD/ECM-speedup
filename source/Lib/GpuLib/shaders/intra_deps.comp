#version 460
// the scheduling data of intra_rec, computed on the GPU from the block records: geometry, decoding order and syntax
// only, with the same rules as GpuIntraRec's host version (which the verification mode compares). One invocation
// per block; pc.verify selects the pass:
//   0  the owner maps (each block writes its index over its units; the maps are -1 before). ISP sub-partitions 1 or
//      2 wide or high share units: the last one owns them, as on the host (atomicMax)
//   1  per block the read ranges and the availability (written into the block record) and its number of
//      dependencies (depCount)
//   2  the dependencies (depTmp at depStart, the exclusive prefix sum of pass 1) and per block the number of its
//      dependents (numDep)
//   3  the dependents lists (depList at depOffset, the prefix sum of numDep; numDep is zero again and counts the
//      entries) and the queue seeded with the blocks without dependencies
// Passes 2 and 3 write nothing when the dependencies exceed edgeCap (intra_rec then does nothing either and the
// host computes the data itself).
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
#include "intra_common.glsl"
#include "intra_modes.glsl"

layout( local_size_x = 64 ) in;

const int PAD  = 6;    // interpFilterNumPadded
const int UNIQ = 32;   // the dependencies of a block deduplicated exactly (beyond: duplicates, harmless)

Params P;
int    g_i, g_ch, g_pass;
int    g_count, g_base;
int    g_uniq[UNIQ];
int    g_numUniq;

int ownerAt( int c, int x, int y )
{
  if( x < 0 || y < 0 || ( x >> P.unitLog2X[g_ch] ) >= P.ownerW[g_ch] || ( y >> P.unitLog2Y[g_ch] ) >= P.ownerH[g_ch] )
  {
    return -1;
  }
  return BufI32( P.owner[c] ).v[( y >> P.unitLog2Y[g_ch] ) * P.ownerW[g_ch] + ( x >> P.unitLog2X[g_ch] )];
}

// the block owning luma sample (x, y) inside the picture (the reads of chroma residual scaling)
int ownerLumaAt( int x, int y )
{
  return BufI32( P.owner[0] ).v[( y >> P.unitLog2Y[0] ) * P.ownerW[0] + ( x >> P.unitLog2X[0] )];
}

// component c's owner map (its units those of the block's channel type)
OwnerMap ownerMap( int c )
{
  return OwnerMap( BufI32( P.owner[c] ), P.ownerW[g_ch], P.ownerH[g_ch], P.unitLog2X[g_ch], P.unitLog2Y[g_ch] );
}

bool availAt( int c, int x, int y )
{
  return decodedBefore( ownerMap( c ), x, y, g_i );
}

// block g_i waits for block o
void addEdge( int o )
{
  if( o < 0 || o == g_i )
  {
    return;
  }
  for( int k = 0; k < g_numUniq; k++ )
  {
    if( g_uniq[k] == o )
    {
      return;
    }
  }
  if( g_numUniq < UNIQ )
  {
    g_uniq[g_numUniq++] = o;
  }
  if( g_pass == 2 )
  {
    BufI32( P.depTmp ).v[g_base + g_count] = o;
    atomicAdd( BufI32( P.numDep ).v[o], 1 );
  }
  g_count++;
}

// block g_i reads samples of block o, the owner of a unit: only an owner decoded before it (a later one has not
// written the unit yet when the CPU reads it)
void addDep( int o )
{
  if( o < g_i )
  {
    addEdge( o );
  }
}

// the highest entries of the top and the left arm of line ln (0: multiRefIdx, 1: intra fusion's next one) the
// prediction of block t reads (a superset; topLen / leftLen: the arms' lengths, m_topRefLength / m_leftRefLength);
// the intra bilateral filter's gate of angular modes reads the whole arms
void readRange( Tu t, int ln, int topLen, int leftLen, out int topMax, out int leftMax )
{
  const int W = t.regW, H = t.h;
  const int mrl = t.mrl + ln;
  const int rf  = t.refFilter != 0 ? 1 : 0;
  if( t.dirMode == 0 )   // never with MRL
  {
    topMax  = W + 1 + rf;
    leftMax = H + 1 + rf;
  }
  else if( t.dirMode == 1 )   // from entry multiRefIdx + 1 on
  {
    topMax  = W + 1 + mrl;
    leftMax = H + 1 + mrl;
  }
  else if( ( t.lm & LM_ACTIVE ) != 0 )   // CCLM's template: entries 1 .. 2W / 2H (MDLM's longest)
  {
    topMax  = 2 * W;
    leftMax = 2 * H;
  }
  else
  {
    const bool ver = t.isModeVer != 0;
    const int  w = ver ? W : H, h = ver ? H : W, refLength = ver ? topLen : leftLen, sideLength = ver ? leftLen : topLen;
    const int  angle = t.intraPredAngle;
    int mainMax, sideMax;
    if( ln == 0 )
    {
      if( angle == 0 )
      {
        mainMax = w + 1 + mrl;
        sideMax = t.applyPDPC != 0 ? h + 1 : 1 + mrl;
      }
      else if( angle < 0 )
      {
        mainMax = w + PAD + 2 + mrl;
        sideMax = h + PAD + 2 + mrl;
      }
      else
      {
        mainMax = min( refLength + mrl, ( ( angle * ( h + mrl ) ) >> 5 ) + w + 10 + mrl );
        sideMax = 1 + mrl;
        if( t.applyPDPC != 0 )
        {
          const int limit = min( 3 << t.angularScale, w );
          sideMax = t.gradPDPC != 0 ? h + 1 : min( sideLength, h + ( ( 256 + limit * t.absInvAngle ) >> 9 ) + 1 );
        }
      }
      mainMax += rf;
      sideMax += rf;
    }
    else
    {
      if( angle < 0 )
      {
        mainMax = w + PAD + 9 + mrl;
        sideMax = min( sideLength + mrl, ( ( ( h + 1 + PAD ) * t.absInvAngle + 8 ) >> 4 >> 5 ) + 2 + mrl );
      }
      else
      {
        mainMax = min( refLength + mrl, ( ( angle * ( h + mrl ) ) >> 5 ) + w + 11 + mrl );
        sideMax = mrl;
      }
    }
    topMax  = ver ? mainMax : sideMax;
    leftMax = ver ? sideMax : mainMax;
  }
  if( t.bf == 2 && ln == 0 )
  {
    topMax  = topLen;
    leftMax = leftLen;
  }
}

// a dependency on the node that publishes CU n's mode: none for a mode the host knows (a MIP CU's node with MTSS
// derives only MTSS's list)
void addModeDep( int n )
{
  if( BufCu( P.cus ).v[n].kind != CU_KNOWN )
  {
    addDep( BufCu( P.cus ).v[n].node );
  }
}

// a dependency on the blocks owning the samples of component comp in [x0, x1] x [y0, y1]
void addAreaDeps( int comp, int x0, int y0, int x1, int y1 )
{
  const int ch = comp == 0 ? 0 : 1;
  for( int uy = y0 >> P.unitLog2Y[ch]; uy <= y1 >> P.unitLog2Y[ch]; uy++ )
  {
    for( int ux = x0 >> P.unitLog2X[ch]; ux <= x1 >> P.unitLog2X[ch]; ux++ )
    {
      if( ux >= 0 && uy >= 0 && ux < P.ownerW[ch] && uy < P.ownerH[ch] )
      {
        addDep( BufI32( P.owner[comp] ).v[uy * P.ownerW[ch] + ux] );
      }
    }
  }
}

// a dependency on the blocks owning the samples the template predictions of CU c read, its template's arms tw, th (0:
// none; GpuIntraRec.cpp's templateReadAreas): the reference row and column of the template's block (8 x its sides),
// the template above the CU with the corner and the template left of it
void addTemplateDeps( Cu c, int tw, int th )
{
  if( tw > 0 || th > 0 )
  {
    const int x0 = c.x - tw - 1, y0 = c.y - th - 1;
    addAreaDeps( 0, x0, y0, x0 + ( ( c.w + tw ) << 3 ), y0 );
    addAreaDeps( 0, x0, y0, x0, y0 + ( ( c.h + th ) << 3 ) );
    addAreaDeps( 0, c.x - tw, c.y - th, c.x + c.w - 1, c.y - 1 );
    addAreaDeps( 0, c.x - tw, c.y, c.x - 1, c.y + c.h - 1 );
  }
}

// a dependency on the blocks owning the samples of the whole arms of reference line mrl of the area at (fx, fy) whose
// arms have predSize / predHSize samples (fillSource's samples, the padding's included)
void lineDeps( int comp, int fx, int fy, int predSize, int predHSize, int mrl )
{
  const int x0 = fx - 1 - mrl, y0 = fy - 1 - mrl;
  addAreaDeps( comp, x0, y0, fx - 1 + predSize, y0 );
  addAreaDeps( comp, x0, y0, x0, fy - 1 + predHSize );
}

// a dependency of CCLM block t on the blocks owning the luma samples its downsampling reads (xGetLumaRecPixels, 4:2:0):
// the co-located block, the rows above it (up to 3; MDLM's template 2W wide) and the columns left of it (3; 2H high)
void cclmDeps( Tu t )
{
  const int lx = t.x << 1, ly = t.y << 1, lw = t.w << 1, lh = t.h << 1;
  addAreaDeps( 0, lx, ly, lx + lw - 1, ly + lh - 1 );
  addAreaDeps( 0, lx - 1, ly - 3, lx + 2 * lw, ly - 1 );
  addAreaDeps( 0, lx - 3, ly - 1, lx - 1, ly + 2 * lh - 1 );
}

// a dependency of CCCM block t (intra_cccm.glsl) on the blocks owning the samples it reads, for the largest reference
// area it may have (up to 6 lines above / left, arms of twice the block): of both chroma components the template
// (which holds the offsets' samples, the costs' arms and the inside filter's neighbours), of luma the area's
// downsampling with a sample of padding around (with the luma offset's sample; without subsampling the area's luma
// with two samples around, within it; luma right of / below the block in a dual tree is its CTU's, decoded before)
void cccmDeps( Tu t )
{
  const int sx = min( t.x, 6 ), sy = min( t.y, 6 ), x1 = t.x + 2 * t.w - 1, y1 = t.y + 2 * t.h - 1;
  for( int comp = 1; comp <= 2; comp++ )
  {
    addAreaDeps( comp, t.x - sx, t.y - sy, x1, t.y - 1 );
    addAreaDeps( comp, t.x - sx, t.y, t.x - 1, y1 );
  }
  addAreaDeps( 0, 2 * ( t.x - sx - 1 ) - 1, 2 * ( t.y - sy - 1 ) - 1, 2 * ( x1 + 1 ) + 1, 2 * ( y1 + 1 ) + 1 );
}

// a dependency of CFLM block t (intra_cccm.glsl's cflmPrediction) on the blocks owning the samples it reads: of its
// component the reference line of the template's block (arms of twice its sides, the row's last unit up to sx samples
// beyond: intra_timd.glsl's timdFillReference) and the template with the corner (the chroma offset's sample;
// CFLM_TEMPLATE lines above / columns left of the block, those the picture has), of luma the area's downsampling (with
// the luma offset's sample)
void cflmDeps( Tu t )
{
  const int sx = min( t.x, CFLM_TEMPLATE ), sy = min( t.y, CFLM_TEMPLATE );
  if( sx > 0 || sy > 0 )
  {
    const int x0 = t.x - sx - 1, y0 = t.y - sy - 1;
    addAreaDeps( t.comp, x0, y0, x0 + 2 * ( t.w + sx ) + sx, y0 );
    addAreaDeps( t.comp, x0, y0, x0, y0 + 2 * ( t.h + sy ) );
    addAreaDeps( t.comp, t.x - sx, t.y - sy, t.x + t.w - 1, t.y - 1 );
    addAreaDeps( t.comp, t.x - sx, t.y, t.x - 1, t.y + t.h - 1 );
  }
  addAreaDeps( 0, 2 * ( t.x - sx ) - 1, 2 * ( t.y - sy ) - 1, 2 * ( t.x + t.w ) - 1, 2 * ( t.y + t.h ) - 1 );
}

// a dependency on the blocks writing CCP record r (CCP_WRITERS: its CU's chroma blocks)
void ccpWriterDeps( int r )
{
  for( int k = 0; k < CCP_WRITERS; k++ )
  {
    addDep( BufI32( P.ccpData ).v[r * CCP_WRITERS + k] );
  }
}

// a dependency of CCP merge block t (intra_ccp.glsl) on the blocks writing the models it reads: its sources' and its
// CTU row's history's (the samples its candidates' predictions read are a CCCM block's of any kind: cccmDeps, also
// CCLM's and GLM's luma, the costs' template, the inside filter's neighbours). Each block of the CU ranks the list
// itself: the Cr block waiting for the Cb block's record would close a cycle where joint CbCr's sign prediction has
// the Cb block wait for the Cr block (resiFrom), a deadlock
void ccpMergeDeps( Tu t )
{
  BufI32    d = BufI32( P.ccpData );
  const int e = t.ccpMerge;
  for( int s = 0; s < d.v[e + CCP_MERGE_NUM_SPATIAL]; s++ )
  {
    ccpWriterDeps( d.v[e + CCP_MERGE_SPATIAL + s] );
  }
  for( int h = 0; h < d.v[e + CCP_MERGE_HIST_NUM]; h++ )
  {
    ccpWriterDeps( d.v[d.v[e + CCP_MERGE_HIST] + h] );
  }
}

// a dependency of chroma TMRL CU c's node on the modes it reads - the luma CUs' at its five positions and the chroma
// neighbours' (Cu::nbr; the co-located luma CU's is the chroma nodes' own) - and on the blocks owning the samples it
// reads: of Cb and Cr each line's whole arms (2 x (the side + 1)) and the template, of luma the co-located block and
// its lines twice as far with arms of 2 x its sides, whose positional availability reads neither past the CTU's right
// edge above nor past its bottom edge on the left
void chromaTmrlDeps( Cu c )
{
  for( int k = CHROMA_TMRL_NBR_LUMA; k < CHROMA_TMRL_NBR_CHROMA + 5; k++ )
  {
    if( c.nbr[k] >= 0 )
    {
      addModeDep( c.nbr[k] );
    }
  }
  const int lx = c.x << 1, ly = c.y << 1, lw = c.w << 1, lh = c.h << 1;
  const int ctuRight = ( lx / P.ctuSize + 1 ) * P.ctuSize - 1, ctuBottom = ( ly / P.ctuSize + 1 ) * P.ctuSize - 1;
  for( int k = 0; k < chromaTmrlNumLines( c.y ); k++ )
  {
    const int line = CHROMA_TMRL_LINES[k];
    for( int comp = 1; comp <= 2; comp++ )
    {
      lineDeps( comp, c.x, c.y, ( c.w + 1 ) << 1, ( c.h + 1 ) << 1, line );
    }
    const int mrl = line << 1, x0 = lx - 1 - mrl, y0 = ly - 1 - mrl;
    addAreaDeps( 0, x0, y0, min( lx - 1 + ( lw << 1 ), ctuRight ), y0 );
    addAreaDeps( 0, x0, y0, x0, min( ly - 1 + ( lh << 1 ), ctuBottom ) );
  }
  for( int comp = 1; comp <= 2; comp++ )
  {
    addAreaDeps( comp, c.x, c.y - 1, c.x + c.w - 1, c.y - 1 );
    addAreaDeps( comp, c.x - 1, c.y, c.x - 1, c.y + c.h - 1 );
  }
  addAreaDeps( 0, lx, ly, lx + lw - 1, ly + lh - 1 );
}

// the intra bilateral filter's neighbours of block t (rows y-2, y-1; columns x-2, x-1): its padding - line 0's corner and
// above / left units of the area at (fx, fy) (the block, for ISP the CU, whose origin it pads at), also with MRL - into
// t.bfAvail, and a dependency on the owners of a superset of the samples it copies
void bilateralFilterDeps( inout Tu t, int comp, int availComp, int fx, int fy, int numAbove, int numLeft )
{
  int bfA, bfL;
  for( bfA = 0; bfA < numAbove && availAt( availComp, fx + bfA * t.unitW, fy - 1 ); bfA++ ) {}
  for( bfL = 0; bfL < numLeft && availAt( availComp, fx - 1, fy + bfL * t.unitH ); bfL++ ) {}
  t.bfAvail[0] = availAt( availComp, fx - 1, fy - 1 ) ? 1 : 0;
  t.bfAvail[1] = bfA;
  t.bfAvail[2] = bfL;
  if( t.bfAvail[0] != 0 )
  {
    addDep( ownerAt( comp, fx - 2, fy - 2 ) );
    addDep( ownerAt( comp, fx - 1, fy - 2 ) );
    addDep( ownerAt( comp, fx - 2, fy - 1 ) );
    addDep( ownerAt( comp, fx - 1, fy - 1 ) );
  }
  for( int x = 0; x < bfA * t.unitW; x++ )
  {
    addDep( ownerAt( comp, fx + x, fy - 2 ) );
    addDep( ownerAt( comp, fx + x, fy - 1 ) );
  }
  for( int y = 0; y < bfL * t.unitH; y++ )
  {
    addDep( ownerAt( comp, fx - 2, fy + y ) );
    addDep( ownerAt( comp, fx - 1, fy + y ) );
  }
}

// GpuIntraRec::endPicture's dependency loop for block g_i (passes 1 and 2); pass 1 writes the availability, read
// ranges and ISP side flag into the block record, which refSource reads (from the local copy) and pass 2 reloads
void dependencies( int comp )
{
  Tu t = BufTu( P.tus ).v[g_i];
  if( ( t.derive & DERIVE_NODE ) != 0 )   // a CU's mode: the derived modes it reads, from those CUs' nodes
  {
    const Cu c = BufCu( P.cus ).v[t.cu];
    if( c.kind == CU_MPM || c.kind == CU_TIMD || c.kind == CU_TMRL )
    {
      for( int k = 0; k < MPM_NEIGHBOURS; k++ )
      {
        if( c.nbr[k] >= 0 )
        {
          addModeDep( c.nbr[k] );
        }
      }
    }
    else if( c.lumaCu >= 0 )
    {
      addModeDep( c.lumaCu );
    }
    for( int k = 0; c.obic >= 0 && k < OBIC_NBRS; k++ )   // OBIC: the modes of its neighbours
    {
      const int n = BufObicNbr( P.obicNbrs ).v[c.obic * OBIC_NBRS + k].cu;
      if( n >= 0 )
      {
        addModeDep( n );
      }
    }
    // DIMD and MTSS's mode list: the samples their histograms' gradients read (GpuIntraRec.cpp's dimdCallArea: each
    // histogram's region and one sample around it, in the plane of its component), from the blocks owning them
    const int numMtss = c.mtss >= 0 ? MTSS_CALLS : 0;
    for( int n = 0; n < c.dimdNum + numMtss; n++ )
    {
      const DimdCall k = BufDimdCall( P.dimdCalls ).v[n < c.dimdNum ? c.dimd + n : c.mtss + n - c.dimdNum];
      if( k.kind != 0 )
      {
        addAreaDeps( k.comp, k.x - 1, k.y - 1, k.x + k.width, k.y + k.height );
      }
    }
    // intra merge: the parameters of its neighbours (their nodes), its template
    if( c.merge >= 0 )
    {
      BufI32    md     = BufI32( P.mergeData );
      const int nbrNum = md.v[c.merge + 1];
      for( int k = 0; k < nbrNum; k++ )
      {
        addDep( BufCu( P.cus ).v[md.v[c.merge + MERGE_HEAD + 2 * k]].node );
      }
      addTemplateDeps( c, md.v[c.merge + MERGE_HEAD_T], md.v[c.merge + MERGE_HEAD_T + 1] );
    }
    if( c.timd >= 0 )   // TIMD: its template (TIMD-SAD: also deriveTimdModeSad's; TIMD merge: its candidates' TIMD)
    {
      BufI32 td = BufI32( P.timdData );
      addTemplateDeps( c, td.v[c.timd + TIMD_HEAD_T], td.v[c.timd + TIMD_HEAD_T + 1] );
      if( td.v[c.timd + TIMD_HEAD_SAD] != 0 )
      {
        addTemplateDeps( c, td.v[c.timd + TIMD_HEAD_TS], td.v[c.timd + TIMD_HEAD_TS + 1] );
      }
      for( int k = 0; k < td.v[c.timd + TIMD_HEAD_MERGE]; k++ )
      {
        addModeDep( td.v[c.timd + TIMD_HEAD_MERGE + 1 + k] );
      }
    }
    if( c.tmrl >= 0 && c.kind == CU_TMRL )   // TMRL: the reference lines it tries (whole arms), its one-sample template
    {
      for( int k = 0; k < tmrlNumLines( c.y ); k++ )
      {
        lineDeps( 0, c.x, c.y, c.w << 3, c.h << 3, TMRL_LINES[k] );
      }
      addAreaDeps( 0, c.x, c.y - 1, c.x + c.w - 1, c.y - 1 );
      addAreaDeps( 0, c.x - 1, c.y, c.x - 1, c.y + c.h - 1 );
    }
    if( c.kind == CU_CHROMA_TMRL )   // chroma TMRL: chromaTmrlDeps
    {
      chromaTmrlDeps( c );
    }
    return;
  }
  const int availComp = t.comp == 0 ? 0 : 1;
  for( int ln = 0; ln < 2; ln++ )
  {
    for( int k = 0; k < 7; k++ ) t.avail[ln][k] = 0;
    t.readMax[ln][0] = 0;
    t.readMax[ln][1] = 0;
  }
  for( int k = 0; k < 3; k++ ) t.bfAvail[k] = 0;
  t.ispSide = 0;
  // the area the references are filled for: the block with arms of 8x its size, for ISP the CU with arms of twice its
  // size; the prediction's arm lengths (m_topRefLength / m_leftRefLength): 8x the block, for ISP the CU's size plus
  // the prediction region's
  const bool isp = t.isp != 0;
  const int  fx = isp ? t.cuX : t.x, fy = isp ? t.cuY : t.y, fw = isp ? t.cuW : t.w, fh = isp ? t.cuH : t.h;
  const int  predSize = isp ? 2 * t.cuW : t.w << 3, predHSize = isp ? 2 * t.cuH : t.h << 3;
  const int  numAbove = max( fw / t.unitW, 1 ), numLeft = max( fh / t.unitH, 1 );
  const int  tAU = predSize / t.unitW, tLU = predHSize / t.unitH;
  const int  W = t.regW, H = t.h, topLen = isp ? t.cuW + W : W << 3, leftLen = isp ? t.cuH + H : H << 3;
  if( isp )   // the side of the sub-partition along the split (initIntraPatternChTypeISP's isLeftAvail / isAboveAvail)
  {
    t.ispSide = ( t.isp == 1 ? availAt( availComp, t.cuX - 1, t.y ) : availAt( availComp, t.regX, t.cuY - 1 ) ) ? 1 : 0;
  }
  // a mode intra_rec derives is not known here: the union of the read ranges of the modes the syntax leaves (Cu::modes,
  // else all), the fusion line where one of them reads it, the bilateral filter's neighbours where it applies to one
  // A TIMD block's modes are of the 131-mode set, with wide angles beyond the regular ones, and blend, fused from the
  // next line also where the CU's fetchRef2nd is off: the whole arms of both lines, the filter's neighbours where it may
  // filter a blend
  // A TMRL block's line comes from its node, which intra_deps cannot know: the whole arms of every line the node may
  // choose and, for luma, of the next one (intra fusion's), the filter's neighbours where it may filter (DC); the block
  // finds its line's availability itself (its avail and readMax stay 0)
  const bool derived   = ( t.derive & DERIVE_MODE ) != 0;
  const bool timdBlock = ( t.derive & DERIVE_TIMD ) != 0;
  const bool tmrlBlock = ( t.derive & DERIVE_TMRL ) != 0;
  Cu         c;
  int        numModes = 1;
  if( derived )
  {
    c        = BufCu( P.cus ).v[t.cu];
    numModes = timdBlock ? 0 : c.modes[0] < 0 ? NUM_LUMA_MODE : c.modes[1] < 0 ? 1 : 2;
  }
  bool bfNeeded = ( !derived && t.bf != 0 ) || ( ( timdBlock || tmrlBlock ) && ( t.derive & DERIVE_BF ) != 0 );
  const bool lumaTmrl     = t.comp == 0;
  const int  numTmrlLines = !tmrlBlock ? 0 : lumaTmrl ? tmrlNumLines( t.y ) : chromaTmrlNumLines( t.y );
  for( int k = 0; k < numTmrlLines; k++ )
  {
    const int line = lumaTmrl ? TMRL_LINES[k] : CHROMA_TMRL_LINES[k];
    lineDeps( comp, fx, fy, predSize, predHSize, line );
    if( lumaTmrl )
    {
      lineDeps( comp, fx, fy, predSize, predHSize, line + 1 );
    }
  }
  for( int ln = 0; ln < 2 && !tmrlBlock; ln++ )
  {
    const int mrl = t.mrl + ln;   // the reference line (multiRefIdx; the fusion line is the next one)
    int topMax = timdBlock ? topLen + mrl : -1, leftMax = timdBlock ? leftLen + mrl : -1;   // -1: the line is not read
    for( int k = 0; k < numModes; k++ )
    {
      Tu tm = t;
      if( derived )
      {
        applyModeParams( tm, c.modes[0] < 0 ? k : c.modes[k], c.plIdx );
      }
      if( ln == 1 && tm.fusion == 0 )
      {
        continue;
      }
      int a, b;
      readRange( tm, ln, topLen, leftLen, a, b );
      topMax  = max( topMax, a );
      leftMax = max( leftMax, b );
      bfNeeded = bfNeeded || tm.bf != 0;
    }
    if( topMax < 0 )
    {
      break;
    }
    t.readMax[ln][0] = max( mrl, min( topMax, topLen + mrl ) );
    t.readMax[ln][1] = max( mrl, min( leftMax, leftLen + mrl ) );

    // the availability (ISP: the CU's unit groups scanned whole)
    const int unitsTop  = isp ? tAU : t.readMax[ln][0] >= 1 + mrl ? ( t.readMax[ln][0] - 1 - mrl ) / t.unitW + 1 : 0;
    const int unitsLeft = isp ? tLU : t.readMax[ln][1] >= 1 + mrl ? ( t.readMax[ln][1] - 1 - mrl ) / t.unitH + 1 : 0;
    int av[7];
    refLineAvailability( ownerMap( availComp ), g_i, fx, fy, fw, fh, tAU, tLU, mrl, t.unitW, t.unitH, unitsTop, unitsLeft, av );
    t.avail[ln] = av;
    // the owners of the samples in range (intra_rec's fill rule); consecutive samples mostly share an owner. A CCLM block
    // with LFNST / NSPT that predicts the other chroma component too (cclmTransformMode) reads that component's line
    // at the same positions
    const int  otherComp = 3 - comp;
    const bool other     = ln == 0 && ( t.derive & DERIVE_CCLM_DIMD ) != 0
                           && ( t.lm & ( comp == 1 ? LM_HIST_CR : LM_HIST_CB ) ) != 0;
    int lastOwner = -2, lastOther = -2;
    for( int side = 0; side < 2; side++ )
    {
      for( int idx = 0; idx <= t.readMax[ln][side]; idx++ )
      {
        int sx, sy;
        if( refSource( t, ln, side == 0, idx, sx, sy ) )
        {
          const int o = ownerAt( comp, sx, sy );
          if( o != lastOwner )
          {
            addDep( o );
            lastOwner = o;
          }
          const int p = other ? ownerAt( otherComp, sx, sy ) : -2;
          if( p != lastOther )
          {
            addDep( p );
            lastOther = p;
          }
        }
      }
    }
  }
  if( bfNeeded )
  {
    bilateralFilterDeps( t, comp, availComp, fx, fy, numAbove, numLeft );
  }
  if( t.pdp >= 0 )   // PDP (intra_pdp.glsl): up to two lines above with the corner and left, arms of twice the sides
  {
    addAreaDeps( 0, t.x - 2, t.y - 2, t.x + 2 * t.w - 1, t.y - 1 );
    addAreaDeps( 0, t.x - 2, t.y, t.x - 1, t.y + 2 * t.h - 1 );
  }
  if( ( t.lm & LM_ACTIVE ) != 0 )   // CCLM: the luma it downsamples
  {
    cclmDeps( t );
  }
  if( ( ( t.lm >> LM_CCCM_SHIFT ) & 3 ) != 0 || t.ccpMerge >= 0 )   // (a merge block's candidates: any CCCM kind)
  {
    cccmDeps( t );
  }
  if( lmFusionType( t ) > 1 )
  {
    cflmDeps( t );
  }
  if( t.ccpMerge >= 0 )
  {
    ccpMergeDeps( t );
  }
  if( t.ispPrev >= 0 )   // the chain of an ISP CU's sub-partitions
  {
    addDep( t.ispPrev );
  }
  if( derived )   // the mode, from the CU's node
  {
    addDep( c.node );
  }
  else if( ( t.derive & DERIVE_MTSS ) != 0 )   // a MIP block: MTSS's mode list, from the CU's node
  {
    addDep( BufCu( P.cus ).v[t.cu].node );
  }
  if( t.spCoded >= 0 )   // sign prediction's border (TU::predBorderResi): the two columns left of / rows above the block
  {
    for( int k = 0; k < t.h && t.x > 0; k++ )
    {
      addDep( ownerAt( comp, t.x - 1, t.y + k ) );
      addDep( ownerAt( comp, t.x - 2, t.y + k ) );
    }
    for( int k = 0; k < t.w && t.y > 0; k++ )
    {
      addDep( ownerAt( comp, t.x + k, t.y - 1 ) );
      addDep( ownerAt( comp, t.x + k, t.y - 2 ) );
    }
  }
  // joint CbCr with sign prediction: the residual comes from the decision in the other block of the pair, before or
  // after this one
  addEdge( t.resiFrom );
  if( g_pass == 1 )
  {
    BufTu( P.tus ).v[g_i].avail   = t.avail;
    BufTu( P.tus ).v[g_i].readMax = t.readMax;
    BufTu( P.tus ).v[g_i].bfAvail = t.bfAvail;
    BufTu( P.tus ).v[g_i].ispSide = t.ispSide;
  }
  if( ( t.lmcs & 2 ) != 0 )   // LMCS chroma residual scaling: the luma column left of and the row above the CU, clipped
  {
    if( ( t.crsAvail & 1 ) != 0 )
    {
      for( int k = 0; k < t.crsH; k++ ) addDep( ownerLumaAt( t.crsX - 1, min( t.crsY + k, P.height[0] - 1 ) ) );
    }
    if( ( t.crsAvail & 2 ) != 0 )
    {
      for( int k = 0; k < t.crsW; k++ ) addDep( ownerLumaAt( min( t.crsX + k, P.width[0] - 1 ), t.crsY - 1 ) );
    }
  }
}

void main()
{
  g_i    = int( gl_GlobalInvocationID.x );
  g_pass = pc.verify;
  if( g_i >= pc.numTus )
  {
    return;
  }
  P = BufParams( pc.params ).p;
  const int comp = BufTu( P.tus ).v[g_i].comp;
  g_ch = comp == 0 ? 0 : 1;
  const int total = BufI32( P.depStart ).v[pc.numTus];   // valid in passes 2 and 3 (after the prefix sum)
  if( g_pass == 0 )
  {
    const Tu t = BufTu( P.tus ).v[g_i];
    if( ( t.derive & DERIVE_NODE ) != 0 && ( t.derive & DERIVE_CPU_FILL ) == 0 )   // no samples
    {
      return;
    }
    for( int uy = t.y >> P.unitLog2Y[g_ch]; uy <= ( t.y + t.h - 1 ) >> P.unitLog2Y[g_ch]; uy++ )
    {
      for( int ux = t.x >> P.unitLog2X[g_ch]; ux <= ( t.x + t.w - 1 ) >> P.unitLog2X[g_ch]; ux++ )
      {
        atomicMax( BufI32( P.owner[comp] ).v[uy * P.ownerW[g_ch] + ux], g_i );
      }
    }
  }
  else if( g_pass == 1 || g_pass == 2 )
  {
    if( g_pass == 2 && total > P.edgeCap )
    {
      return;
    }
    g_count   = 0;
    g_numUniq = 0;
    g_base    = g_pass == 2 ? BufI32( P.depStart ).v[g_i] : 0;
    dependencies( comp );
    if( g_pass == 1 )
    {
      BufI32( P.depCount ).v[g_i] = g_count;
    }
  }
  else
  {
    if( total > P.edgeCap )
    {
      return;
    }
    const int b = BufI32( P.depStart ).v[g_i], e = BufI32( P.depStart ).v[g_i + 1];
    for( int k = b; k < e; k++ )
    {
      const int d = BufI32( P.depTmp ).v[k];
      BufI32( P.depList ).v[BufI32( P.depOffset ).v[d] + atomicAdd( BufI32( P.numDep ).v[d], 1 )] = g_i;
    }
    if( e == b )
    {
      BufI32( P.queue ).v[atomicAdd( BufI32( P.counter ).v[1], 1 )] = g_i;
    }
  }
}
