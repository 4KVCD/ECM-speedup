#version 460
// Motion compensation of inter blocks (InterPrediction::xPredInterBlk with InterpolationFilter's filters), one
// workgroup per job: the prediction of a block (a TU's area of one component) of a PU from the CPU's final motion,
// written where intra_rec reads an inter block's prediction (Params::interPred, at the block's samples). The reference
// pictures are the CPU's (partial verification), uploaded with their margins (Picture::margin: the motion-compensated
// boundary padding of JVET-AA0096 / JVET-AK0085 lies there, so the reads beyond the picture are not a replication).
// Kinds of job (McJob's flags):
// - uni-prediction (InterPrediction::xPredInterUni with bi off, then xWeightedAverage's copyClip): the filters' last
//   stage rounded to the sample and clipped to the slice's range
// - bi-prediction (MC_BI: xPredInterBi without BDOF / DMVR, then xWeightedAverage's addWeightedAvg): each list at the
//   14-bit intermediate precision - JVET-AI0094's sharp luma filter where the pass's block is above 4 x 4 -, averaged
//   with BCW's weights; JVET-Z0136: where one list's reference sample lies more than half a sample outside the
//   picture (isMvOOB at the unclipped vector, per luma sample; chroma takes the luma sample at twice its position) the
//   other list alone
// - BDOF (MC_BDOF, xPredInterBi's bioApplied without DMVR): a first dispatch (mode 1) refines each luma sub-block of
//   the PU - min(16, W) x min(16, H), JVET-AG0067's scaleBDOF 4 - into pc.bdofOut (the PU's luma prediction), which the
//   luma jobs of its blocks then copy (mode 0); its chroma blocks are bi-prediction jobs. Per sub-block (bdofJob): both
//   lists' 14-bit predictions over the PU grown by 2 samples (xPredInterBlk with bioApplied: the sharp filter, as its
//   block is above 4 x 4) and padded by one more (the AF0159 replication), the SAD of dI (calAbsSum) against
//   bioBlockDistTh: below it addAvg, else subBlockBiOptFlow - JVET-AI0046's per-sample refinement: the 5 x 5 weighted
//   sums of the high-precision BIO parameters (calcBIOParameterHighPrecision, calcBIOParamSum5NOSIM with
//   JVET-AG0067's mean removal unless JVET-AL0081's noMeanRm4Sample), divTable's division into vx / vy (clipped to
//   +-31), addBIOAvgN's average at the sample moved by one where |v| > 16 - or without the move where the sub-block has
//   a sample out of boundary in either list (JVET-Z0136: those samples one list alone)
// - multi-pass DMVR (bdmvrRefine): one workgroup per PU (mode 2, dmvrJob) replays xPredInterBi's DMVR branch from the
//   CPU's sub-PU vectors into pc.bdofOut (luma and chroma), which all its blocks' jobs copy
// - OBMC (mode 3, after the blocks' jobs): per boundary segment of an OBMC CU what its blending needs that does not
//   read the current picture (obmcJob), for intra_rec, which chooses and blends in the dependency chain
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_GOOGLE_include_directive : require

#include "common.glsl"

layout( local_size_x = 64 ) in;

layout( push_constant ) uniform PushMc
{
  uint64_t jobs;      // McJob (MC_JOB int32 each)
  uint64_t refs;      // per reference slot and component: MC_REF_COMP int32 (the plane's origin, stride, size, margin)
  uint64_t planes;    // the reference planes (int16), where McRef's origins point
  uint64_t filters;   // InterpolationFilter's tables (MC_FILT_*: int32 taps)
  uint64_t outPred;   // Params::interPred (int16)
  uint64_t bdofOut;   // BDOF PUs' luma predictions, DMVR PUs' predictions (int16, McJob's MC_BDOF_OUT)
  uint64_t scratch;   // DMVR PUs' scratch (int32: their BDOF offsets, two tiles)
  uint64_t affine;    // affine PUs' records (int32, AF_*), LIC CUs' models (int32, MC_LIC)
  int      numJobs;
  int      mode;      // 0: the blocks' jobs, 1: BDOF's sub-block jobs, 2: DMVR's PUs (1 and 2 before 0), 3: OBMC's
                      // segments (pc.scratch: the blocks' jobs), 4: OBMC's inner sub-blocks
} pc;

// McJob (int32): the block (component, position and size in the component's samples), where its prediction goes in
// Params::interPred, the PU's size in the component's samples (the filter choice), list 0's (or the one list's)
// motion vector (1/16 luma samples, clipped by the host: clipMvInl) and reference slot, the flags, the bit depth and
// the clipping range; with MC_BI list 1's vector and slot, BCW's weights, which lists are out of boundary somewhere
// (MC_OOB: bit 0 list 0, bit 1 list 1), the unclipped vectors, the PU's luma position and the picture's luma size;
// with MC_BDOF where the PU's luma prediction is in pc.bdofOut (MC_BDOF_OUT). A BDOF job (mode 1): the sub-block
// (MC_X, MC_Y, MC_W, MC_H relative to the PU), the PU's luma size, its two lists' vectors (clipped at the position
// grown by BIO_EXTEND_SIZE + 1, as xPredInterUni clips with bioApplied), the SAD threshold (MC_BDOF_TH) and
// MC_NO_MEAN
const int MC_COMP = 0, MC_X = 1, MC_Y = 2, MC_W = 3, MC_H = 4, MC_DST = 5, MC_PU_W = 6, MC_PU_H = 7, MC_MVX = 8;
const int MC_MVY = 9, MC_REF = 10, MC_FLAGS = 11, MC_BD = 12, MC_CLIP_MIN = 13, MC_CLIP_MAX = 14, MC_BDOF_TH = 15;
const int MC_MV1X = 16, MC_MV1Y = 17, MC_REF1 = 18, MC_W0 = 19, MC_W1 = 20, MC_OOB = 21, MC_RAW0X = 22, MC_RAW0Y = 23;
const int MC_RAW1X = 24, MC_RAW1Y = 25, MC_PU_X = 26, MC_PU_Y = 27, MC_PIC_W = 28, MC_PIC_H = 29;
const int MC_BDOF_OUT = 30, MC_JOB = 32;
const int MC_ALT_HPEL = 1;   // AMVR's half-sample precision: the alternative half-sample luma filter (8 taps)
const int MC_BI       = 2;   // two lists, averaged
const int MC_BDOF     = 4;   // BDOF's luma
const int MC_NO_MEAN  = 8;   // BDOF without the mean removal (noMeanRm4Sample)
const int MC_L1       = 64;  // uni-prediction from list 1 (LIC's model)
const int MC_AFFINE   = 128; // an affine PU's block: its record at MC_BDOF_OUT in pc.affine (afSample)
const int MC_LIC      = 256; // a LIC CU's block: its models at MC_BDOF_OUT in pc.affine (per list and component)
const int MC_NLIC     = 512; // a non-local LIC CU's block: its model at MC_NLIC_AT in pc.affine (per component), on
                             // the final prediction (xPredInterBi's altLMParaUnit)
const int MC_NLIC_AT  = 31;
// McRef (int32) per slot and component: the index of sample (0, 0) in pc.planes, the stride, the size, the margin
const int MC_REF_ORIGIN = 0, MC_REF_STRIDE = 1, MC_REF_W = 2, MC_REF_H = 3, MC_REF_MARGIN = 4;
const int MC_REF_COMP = 5;
// the filters (int32 taps): m_lumaFilter12 (16 fractions x 12), m_lumaFilter12bi (16 x 12), m_lumaAltHpelIFilter (8),
// m_chromaFilter (32 x 6), g_bdofWeight (1600: calcBIOParamSumHighPrecision_SSE's weights)
const int MC_FILT_LUMA = 0, MC_FILT_LUMA_BI = 16 * 12, MC_FILT_ALT = 2 * 16 * 12, MC_FILT_CHROMA = MC_FILT_ALT + 8;
const int MC_FILT_BDOF_W = MC_FILT_CHROMA + 32 * 6;
const int MC_FILT_CUBIC  = MC_FILT_BDOF_W + 1600;   // g_aiExtIntraCubicFilter (64 x 4): the TM filter (JVET-AL0161)
const int MC_FILT_L64    = MC_FILT_CUBIC + 64 * 4;   // m_lumaFilter64 (64 x 12): affine's 1/64 luma (JVET-AJ0158)

const int IF_INTERNAL_PREC = 14, IF_FILTER_PREC = 8, IF_INTERNAL_OFFS = 1 << ( IF_INTERNAL_PREC - 1 );
const int BCW_LOG2_WEIGHT_BASE = 3;   // g_bcwLog2WeightBase

int refAt( int slot, int comp, int x, int y )
{
  BufI32    r = BufI32( pc.refs );
  const int b = ( slot * 3 + comp ) * MC_REF_COMP;
  return int( BufI16( pc.planes ).v[r.v[b + MC_REF_ORIGIN] + y * r.v[b + MC_REF_STRIDE] + x] );
}

bool mcTm  = false;   // mcPredictTaps: the 4-tap TM filter for luma (filterIdx 1 with use4TapTM)
bool mcF64 = false;   // affine: m_lumaFilter64's 1/64 taps for luma (filterIdx -2)

// the taps of one pass: the table's start and the tap count (filterHor / filterVer's choice for this fraction; the
// sharp bi-prediction filter where the pass's block is above 4 x 4)
ivec2 mcTaps( bool luma, int frac, bool altHpel, bool sharp )
{
  if( mcTm && luma )
  {
    return ivec2( MC_FILT_CUBIC + ( frac << 2 ) * 4, 4 );
  }
  if( mcF64 && luma )
  {
    return ivec2( MC_FILT_L64 + frac * 12, 12 );
  }
  if( !luma )
  {
    return ivec2( MC_FILT_CHROMA + frac * 6, 6 );
  }
  if( frac == 8 && altHpel )
  {
    return ivec2( MC_FILT_ALT, 8 );
  }
  return ivec2( ( sharp ? MC_FILT_LUMA_BI : MC_FILT_LUMA ) + frac * 12, 12 );
}

// InterpolationFilter::filter's sum of n taps at (x, y) along the direction (dx, dy), from the first sample n / 2 - 1
// before it
int mcSum( int slot, int comp, int x, int y, int dx, int dy, ivec2 taps )
{
  BufI32    f    = BufI32( pc.filters );
  int       sum  = 0;
  const int back = taps.y / 2 - 1;
  for( int k = 0; k < taps.y; k++ )
  {
    sum += refAt( slot, comp, x + ( k - back ) * dx, y + ( k - back ) * dy ) * f.v[taps.x + k];
  }
  return sum;
}

// the prediction of one list at sample (x, y) of the reference (the block's position moved by the vector's integer
// part): the last stage rounded to the sample and clipped (uni-prediction), or the 14-bit intermediate (bi: rndRes
// off); each stage's result a 16-bit Pel. W, H: the PU's size in the component (the sharp filter's condition)
int mcPredict( int slot, int comp, int x, int y, int xFrac, int yFrac, bool alt, bool bi, int W, int H, int bd,
               int clipMin, int clipMax )
{
  const bool luma     = comp == 0;
  const int  headRoom = max( 2, IF_INTERNAL_PREC - bd );   // IF_INTERNAL_FRAC_BITS
  if( xFrac == 0 && yFrac == 0 )   // m_filterCopy: the samples, for bi shifted to the intermediate
  {
    const int s = refAt( slot, comp, x, y );
    return bi ? int( int16_t( ( s << headRoom ) - IF_INTERNAL_OFFS ) ) : s;
  }
  if( yFrac == 0 || xFrac == 0 )   // one pass, the first: the last one too without bi
  {
    const ivec2 taps = mcTaps( luma, yFrac == 0 ? xFrac : yFrac, alt, bi && W > 4 && H > 4 );
    const int   sum  = yFrac == 0 ? mcSum( slot, comp, x, y, 1, 0, taps ) : mcSum( slot, comp, x, y, 0, 1, taps );
    if( bi )
    {
      const int shift = IF_FILTER_PREC - headRoom, offset = -IF_INTERNAL_OFFS << shift;
      return int( int16_t( ( sum + offset ) >> shift ) );
    }
    return clamp( int( int16_t( ( sum + ( 1 << ( IF_FILTER_PREC - 1 ) ) ) >> IF_FILTER_PREC ) ), clipMin, clipMax );
  }
  // horizontal (first, not last; its block H + the vertical taps - 1 rows high: the sharp filter where W > 4) into
  // 16-bit rows, then vertical (last without bi)
  const ivec2 tapsH = mcTaps( luma, xFrac, alt, bi && W > 4 );
  const ivec2 tapsV = mcTaps( luma, yFrac, alt, bi && W > 4 && H > 4 );
  const int   shift1 = IF_FILTER_PREC - headRoom, offset1 = -IF_INTERNAL_OFFS << shift1;
  BufI32      f    = BufI32( pc.filters );
  const int   back = tapsV.y / 2 - 1;
  int         sum  = 0;
  for( int k = 0; k < tapsV.y; k++ )
  {
    const int h = int( int16_t( ( mcSum( slot, comp, x, y + k - back, 1, 0, tapsH ) + offset1 ) >> shift1 ) );
    sum += h * f.v[tapsV.x + k];
  }
  if( bi )
  {
    return int( int16_t( sum >> IF_FILTER_PREC ) );
  }
  const int shift2 = IF_FILTER_PREC + headRoom, offset2 = ( 1 << ( shift2 - 1 ) ) + ( IF_INTERNAL_OFFS << IF_FILTER_PREC );
  return clamp( int( int16_t( ( sum + offset2 ) >> shift2 ) ), clipMin, clipMax );
}

// mcPredict with the 4-tap TM filter (xPredInterBlk's filterIdx 1 with use4TapTM: g_aiExtIntraCubicFilter at the
// fraction's quadruple)
int mcPredictTaps( int slot, int comp, int x, int y, int xFrac, int yFrac, bool tm, bool bi, int W, int H, int bd,
                   int clipMin, int clipMax )
{
  mcTm        = tm;
  const int v = mcPredict( slot, comp, x, y, xFrac, yFrac, false, bi, W, H, bd, clipMin, clipMax );
  mcTm        = false;
  return v;
}

// isMvOOB's mask at luma sample (px, py) of the PU (relative to it) for an unclipped vector: more than half a sample
// outside the picture
bool mcOutOfBoundary( BufI32 jb, int o, int px, int py, int rawX, int rawY )
{
  const int offsetX = ( ( jb.v[o + MC_PU_X] + px ) << 4 ) + rawX, offsetY = ( ( jb.v[o + MC_PU_Y] + py ) << 4 ) + rawY;
  const int horMax = ( ( jb.v[o + MC_PIC_W] - 1 ) << 4 ) + 8, verMax = ( ( jb.v[o + MC_PIC_H] - 1 ) << 4 ) + 8;
  return offsetX <= -8 || offsetX >= horMax || offsetY <= -8 || offsetY >= verMax;
}

// ----- BDOF: a block's luma predictions grown by 2 samples with one replicated sample more around them (a tile), in
// shared memory (mode 1: a sub-block of at most 16 x 16) or in pc.scratch (mode 2: a block of a DMVR PU)

layout( buffer_reference, std430, buffer_reference_align = 4 ) coherent buffer BufC32 { int v[]; };
layout( buffer_reference, std430, buffer_reference_align = 2 ) coherent buffer BufC16 { int16_t v[]; };

const int BDOF_TILE = 16 + 6;
shared int sP0[BDOF_TILE * BDOF_TILE], sP1[BDOF_TILE * BDOF_TILE];
shared int sSad, sOob, sFlag;
shared int sAcc[9];
int        bdofX0, bdofY0, bdofTw;   // the tile's first sample (relative to the PU) and width
bool       bdofGlobal = false;       // the tile in pc.scratch, list 0's at bdofG0, list 1's at bdofG1
int        bdofG0, bdofG1;

// list l's prediction at (qx, qy) relative to the PU (in the tile)
int bdofP( int l, int qx, int qy )
{
  const int i = ( qy - bdofY0 ) * bdofTw + qx - bdofX0;
  if( bdofGlobal )
  {
    return BufC32( pc.scratch ).v[( l == 0 ? bdofG0 : bdofG1 ) + i];
  }
  return l == 0 ? sP0[i] : sP1[i];
}

// gradFilter: list l's gradients at (qx, qy)
ivec2 bdofGrad( int l, int qx, int qy )
{
  return ivec2( int( int16_t( ( bdofP( l, qx + 1, qy ) >> 6 ) - ( bdofP( l, qx - 1, qy ) >> 6 ) ) ),
                int( int16_t( ( bdofP( l, qx, qy + 1 ) >> 6 ) - ( bdofP( l, qx, qy - 1 ) >> 6 ) ) ) );
}

// calcBIOParameterHighPrecision's dI (a Pel)
int bdofDI( int qx, int qy )
{
  return int( int16_t( ( bdofP( 1, qx, qy ) >> 4 ) - ( bdofP( 0, qx, qy ) >> 4 ) ) );
}

// (subBlockBiOptFlow's divTable)
const int BDOF_DIV[32] = int[]( 32, 31, 30, 29, 28, 28, 27, 26, 26, 25, 24, 24, 23, 23, 22, 22, 21, 21, 20, 20, 20, 19, 19,
                                19, 18, 18, 18, 17, 17, 17, 17, 16 );

// (sum * 8 * invD + offsetD) >> shiftD for divisor d (> 0), clipped to +-limit
int bdofDiv( int num, int d, int limit )
{
  const int log2D = findMSB( d ), msbD = ( ( d << 5 ) >> log2D ) & 31, shiftD = log2D + 5;
  return clamp( ( num * BDOF_DIV[msbD] + ( 1 << ( shiftD - 1 ) ) ) >> shiftD, -limit, limit );
}

// subBlockBiOptFlow at sample (x, y) relative to the PU, before the clipping (p0, p1: its predictions; oobBlock: a
// sample of its sub-block out of boundary in either list; noMean: noMeanRm4Sample): calcBIOParamSum5NOSIM's 5 x 5
// weighted sums (1 2 4 2 1 by row and column) with JVET-AG0067's mean removal, divTable's division into vx / vy
// (+-31), addBIOAvgN's average - JVET-AI0046: at the sample moved by one where |v| > 16, without the move where oobBlock
void bdofSampleSums( int x, int y, bool noMean, out int vx, out int vy )
{
  int sGx2 = 0, sGy2 = 0, sGxDI = 0, sGyDI = 0, sGxGy = 0, mean = 0, absMean = 0, sX0 = 0, sX1 = 0;
  for( int yy = 0; yy < 5; yy++ )
  {
    for( int xx = 0; xx < 5; xx++ )
    {
      const int   qx = x - 2 + xx, qy = y - 2 + yy;
      const int   w  = ( xx == 2 ? 4 : xx == 0 || xx == 4 ? 1 : 2 ) * ( yy == 2 ? 4 : yy == 0 || yy == 4 ? 1 : 2 );
      const ivec2 g  = bdofGrad( 0, qx, qy ) + bdofGrad( 1, qx, qy );
      const int   d  = bdofDI( qx, qy );
      sGx2 += w * g.x * g.x;
      sGy2 += w * g.y * g.y;
      sGxDI += w * g.x * d;
      sGyDI += w * g.y * d;
      sGxGy += w * g.x * g.y;
      mean += d;
      absMean += abs( d );
      sX0 -= w * g.x;
      sX1 -= w * g.y;
    }
  }
  const int meanDiff = noMean || absMean > 2 * abs( mean ) ? 0 : ( mean + 32 ) >> 6;
  sGxDI += sX0 * meanDiff;
  sGyDI += sX1 * meanDiff;
  sGxDI += ( sGxDI + 2 ) >> 2;
  sGyDI += ( sGyDI + 2 ) >> 2;
  sGx2 += 2528;
  sGy2 += 2528;
  vx = sGx2 > 0 ? bdofDiv( sGxDI << 3, sGx2, 31 ) : 0;
  vy = sGy2 > 0 ? bdofDiv( ( sGyDI << 3 ) - ( ( vx * sGxGy ) >> 1 ), sGy2, 31 ) : 0;
}

int bdofSample( int x, int y, int p0, int p1, bool oobBlock, bool noMean, int shiftNum, int offset )
{
  int vx, vy;
  bdofSampleSums( x, y, noMean, vx, vy );
  if( oobBlock )   // addBIOAvgN's out-of-boundary branch: no move
  {
    const ivec2 g0 = bdofGrad( 0, x, y ), g1 = bdofGrad( 1, x, y );
    return ( p0 + p1 + vx * ( g0.x - g1.x ) + vy * ( g0.y - g1.y ) + offset ) >> shiftNum;
  }
  const int   pX = vx > 16 ? 1 : vx < -16 ? -1 : 0, pY = vy > 16 ? 1 : vy < -16 ? -1 : 0;
  const ivec2 g0 = bdofGrad( 0, x + pX, y + pY ), g1 = bdofGrad( 1, x - pX, y - pY );
  return ( bdofP( 0, x + pX, y + pY ) + bdofP( 1, x - pX, y - pY ) + ( vx - 32 * pX ) * ( g0.x - g1.x )
           + ( vy - 32 * pY ) * ( g0.y - g1.y ) + offset )
         >> shiftNum;
}

// ----- BDOF without DMVR (mode 1): one sub-block of a PU per job

void bdofJob( BufI32 jb, int o, int lid )
{
  const int  sx = jb.v[o + MC_X], sy = jb.v[o + MC_Y], bw = jb.v[o + MC_W], bh = jb.v[o + MC_H];
  const int  W = jb.v[o + MC_PU_W], H = jb.v[o + MC_PU_H], puX = jb.v[o + MC_PU_X], puY = jb.v[o + MC_PU_Y];
  const int  flags = jb.v[o + MC_FLAGS], bd = jb.v[o + MC_BD];
  const int  clipMin = jb.v[o + MC_CLIP_MIN], clipMax = jb.v[o + MC_CLIP_MAX];
  const bool alt = ( flags & MC_ALT_HPEL ) != 0;
  const ivec2 mv0 = ivec2( jb.v[o + MC_MVX], jb.v[o + MC_MVY] ), mv1 = ivec2( jb.v[o + MC_MV1X], jb.v[o + MC_MV1Y] );
  const int   slot0 = jb.v[o + MC_REF], slot1 = jb.v[o + MC_REF1], oob = jb.v[o + MC_OOB];
  bdofX0 = sx - 3;
  bdofY0 = sy - 3;
  bdofTw = bw + 6;
  if( lid == 0 )
  {
    sSad = 0;
    sOob = 0;
  }
  // the predictions over the PU grown by 2 (the sharp filter: W + 4 x H + 4 is above 4 x 4), the ring beyond them a
  // replication
  for( int i = lid; i < bdofTw * ( bh + 6 ); i += 64 )
  {
    const int cx = clamp( bdofX0 + i % bdofTw, -2, W + 1 ), cy = clamp( bdofY0 + i / bdofTw, -2, H + 1 );
    sP0[i] = mcPredict( slot0, 0, puX + cx + ( mv0.x >> 4 ), puY + cy + ( mv0.y >> 4 ), mv0.x & 15, mv0.y & 15, alt, true,
                        W + 4, H + 4, bd, clipMin, clipMax );
    sP1[i] = mcPredict( slot1, 0, puX + cx + ( mv1.x >> 4 ), puY + cy + ( mv1.y >> 4 ), mv1.x & 15, mv1.y & 15, alt, true,
                        W + 4, H + 4, bd, clipMin, clipMax );
  }
  barrier();
  // the sub-block's SAD of dI and its samples out of boundary
  for( int i = lid; i < bw * bh; i += 64 )
  {
    const int x = sx + i % bw, y = sy + i / bw;
    atomicAdd( sSad, abs( bdofDI( x, y ) ) );
    if( oob != 0 )
    {
      const bool o0 = ( oob & 1 ) != 0 && mcOutOfBoundary( jb, o, x, y, jb.v[o + MC_RAW0X], jb.v[o + MC_RAW0Y] );
      const bool o1 = ( oob & 2 ) != 0 && mcOutOfBoundary( jb, o, x, y, jb.v[o + MC_RAW1X], jb.v[o + MC_RAW1Y] );
      atomicOr( sOob, ( o0 ? 1 : 0 ) | ( o1 ? 2 : 0 ) );
    }
  }
  barrier();
  const bool skip     = sSad < jb.v[o + MC_BDOF_TH];
  const bool noMean   = ( flags & MC_NO_MEAN ) != 0;
  const int  headRoom = max( 2, IF_INTERNAL_PREC - bd );
  const int  shiftNum = headRoom + 1, offset = ( 1 << ( shiftNum - 1 ) ) + 2 * IF_INTERNAL_OFFS;
  for( int i = lid; i < bw * bh; i += 64 )
  {
    const int x = sx + i % bw, y = sy + i / bw;
    const int p0 = bdofP( 0, x, y ), p1 = bdofP( 1, x, y );
    bool      o0 = false, o1 = false;
    if( oob != 0 )
    {
      o0 = ( oob & 1 ) != 0 && mcOutOfBoundary( jb, o, x, y, jb.v[o + MC_RAW0X], jb.v[o + MC_RAW0Y] );
      o1 = ( oob & 2 ) != 0 && mcOutOfBoundary( jb, o, x, y, jb.v[o + MC_RAW1X], jb.v[o + MC_RAW1Y] );
    }
    int v;
    if( o0 != o1 )   // one list alone (addAvg's and addBIOAvgN's out-of-boundary branch)
    {
      v = ( ( o0 ? p1 : p0 ) + ( offset >> 1 ) ) >> ( shiftNum - 1 );
    }
    else if( skip )   // addAvg
    {
      v = ( p0 + p1 + offset ) >> shiftNum;
    }
    else
    {
      v = bdofSample( x, y, p0, p1, sOob != 0, noMean, shiftNum, offset );
    }
    BufI16( pc.bdofOut ).v[jb.v[o + MC_DST] + y * W + x] = int16_t( clamp( v, clipMin, clipMax ) );
  }
  barrier();   // (the shared tile's next job)
}

// ----- multi-pass DMVR (mode 2): one PU per job, xPredInterBi's bdmvrRefine branch and motionCompensation's
// xPredInterBiSubPuBDOF in their order, from DMVR's sub-PU vectors (the CPU's, DecCu's m_mvBufBDMVR):
// - without BDOF: per run of 16 x 16 sub-PUs of one vector pair (rows, or columns where H > W) bi-prediction with
//   BCW's weights (xPredInterBiBDMVR, addWeightedAvg)
// - with BDOF (bioApplied): JVET-AG0067 / JVET-AE0091's iterations: first (unless JVET-AL0081's same direction or a
//   small PU) per run its BDOF blocks' vector offsets (applyBiOptFlow with isBdofMvRefine: min(16, W) x min(16, H)
//   blocks, their SAD against bioBlockDistTh, calcBIOParamSum4HighPrecision's weighted sums - g_bdofWeight's
//   tables -, the 2 x 2 solve with divTable), then two passes of xPredInterBiBDMVR2 over the blocks of equal offsets
//   that write the luma of the blocks whose offset converged (addAvg, subBlockBiOptFlow), then
//   xPredInterBiSubPuBDOF: the luma of the rest again at the final vectors with subBlockBiOptFlow, and the chroma of
//   all (bi-prediction at the final vectors)

// a DMVR job (int32): the PU (luma position and size), where its prediction goes in pc.bdofOut (luma, then Cb and Cr
// of a quarter each), clipMvInl's bounds before the position (the picture's size and the CTU's grown by
// 8 + MC_PAD_SIZE), the reference slots, the flags, the bit depth and clipping range, BCW's weights, bioBlockDistTh's
// QP shift, the picture's size, where its scratch starts (pc.scratch: the offsets, two tiles) and its vectors (in
// pc.jobs: per 16 x 16 sub-PU list 0's and list 1's)
const int DM_X = 1, DM_Y = 2, DM_W = 3, DM_H = 4, DM_DST = 5, DM_HMAX = 6, DM_HMIN = 7, DM_VMAX = 8, DM_VMIN = 9;
const int DM_REF0 = 10, DM_FLAGS = 11, DM_BD = 12, DM_CLIP_MIN = 13, DM_CLIP_MAX = 14, DM_QP = 15, DM_REF1 = 18;
const int DM_W0 = 19, DM_W1 = 20, DM_PIC_W = 28, DM_PIC_H = 29, DM_SCRATCH = 30, DM_MVS = 31;
const int DM_BIO      = 16;    // bioApplied
const int DM_SAME_DIR = 32;    // isBiPredFromSameDirUnEqDistPoc (JVET-AJ0097)
const int DM_LDB      = 64;    // the SPS's MvLdbRefineSwitch (getLdbMvRefineMode 2)
const int DM_SKIP_A   = 128;   // no first pass (JVET-AL0081's same direction, JVET-AG0067's small PU): offsets 0

int  dmO, dmX, dmY, dmW, dmH, dmFlags, dmBd, dmClipMin, dmClipMax, dmSlot0, dmSlot1, dmS, dmNux, dmDst;
bool dmAlt;

int dmJ( int f )
{
  return BufI32( pc.jobs ).v[dmO + f];
}

// clipMvInl at luma position (x, y) of the picture
ivec2 dmClip( ivec2 mv, int x, int y )
{
  return ivec2( clamp( mv.x, ( dmJ( DM_HMIN ) - x ) << 4, ( dmJ( DM_HMAX ) - x ) << 4 ),
                clamp( mv.y, ( dmJ( DM_VMIN ) - y ) << 4, ( dmJ( DM_VMAX ) - y ) << 4 ) );
}

// DMVR's vector of list l at (x, y) relative to the PU
ivec2 dmMv( int l, int x, int y )
{
  BufI32    jb = BufI32( pc.jobs );
  const int i  = dmJ( DM_MVS ) + ( ( y >> 4 ) * dmNux + ( x >> 4 ) ) * 4 + l * 2;
  return ivec2( jb.v[i], jb.v[i + 1] );
}

bool dmMvSame( int x, int y, int x2, int y2 )
{
  return dmMv( 0, x, y ) == dmMv( 0, x2, y2 ) && dmMv( 1, x, y ) == dmMv( 1, x2, y2 );
}

// the BDOF vector offset of the 4 x 4 unit at (x, y) relative to the PU (m_bdofSubPuMvOffset; second:
// m_bdofSubPuMvOffse2, the last iteration's)
int dmOffIdx( bool second, int x, int y )
{
  return dmS + ( ( second ? ( dmW >> 2 ) * ( dmH >> 2 ) : 0 ) + ( y >> 2 ) * ( dmW >> 2 ) + ( x >> 2 ) ) * 2;
}

ivec2 dmOff( bool second, int x, int y )
{
  const int i = dmOffIdx( second, x, y );
  return ivec2( BufC32( pc.scratch ).v[i], BufC32( pc.scratch ).v[i + 1] );
}

void dmSetOff( bool second, int x, int y, ivec2 v )
{
  const int i = dmOffIdx( second, x, y );
  BufC32( pc.scratch ).v[i]     = v.x;
  BufC32( pc.scratch ).v[i + 1] = v.y;
}

// isMvOOB's mask at luma sample (x, y) relative to the PU for vector mv
bool dmOob( int x, int y, ivec2 mv )
{
  const int ox = ( ( dmX + x ) << 4 ) + mv.x, oy = ( ( dmY + y ) << 4 ) + mv.y;
  return ox <= -8 || ox >= ( ( dmJ( DM_PIC_W ) - 1 ) << 4 ) + 8 || oy <= -8 || oy >= ( ( dmJ( DM_PIC_H ) - 1 ) << 4 ) + 8;
}

// (Mv's >>= 1)
ivec2 dmHalf( ivec2 v )
{
  return ( v + 1 - ivec2( greaterThanEqual( v, ivec2( 0 ) ) ) ) >> 1;
}

// getLdbMvRefineMode of a sub-PU of area samples
int dmLdbMode( int area )
{
  return area <= 32 ? 0 : ( dmFlags & DM_LDB ) != 0 ? 2 : 1;
}

// getMean
int dmGetMean( int sum, int div )
{
  const int DIV16[16] = int[]( 0, 7, 6, 5, 5, 4, 4, 3, 3, 2, 2, 1, 1, 1, 1, 0 );
  int       sign      = 1;
  if( sum < 0 )
  {
    sum  = -sum;
    sign = -1;
  }
  int       x    = findMSB( div );
  const int norm = ( ( div << 4 ) >> x ) & 15, v = DIV16[norm] | 8;
  x += norm != 0 ? 1 : 0;
  int shift = 13 - x, ret;
  if( shift < 0 )
  {
    shift = -shift;
    ret   = ( sum * v + ( 1 << ( shift - 1 ) ) ) >> shift;
  }
  else
  {
    ret = ( sum * v ) << shift;
  }
  return sign * ( ret >> 16 );
}

void dmSync()
{
  memoryBarrierBuffer();
  memoryBarrierShared();
  barrier();
}

void dmOut( int comp, int x, int y, int v )
{
  const int base = dmDst + ( comp == 0 ? 0 : dmW * dmH + ( comp - 1 ) * ( dmW >> 1 ) * ( dmH >> 1 ) );
  BufC16( pc.bdofOut ).v[base + y * ( comp == 0 ? dmW : dmW >> 1 ) + x] = int16_t( clamp( v, dmClipMin, dmClipMax ) );
}

// a block's luma tile (xPredInterBlk with bioApplied: the vectors clipped at the position grown by BIO_EXTEND_SIZE + 1,
// the sharp filter as the grown block is above 4 x 4)
void dmTile( int bx, int by, int bw, int bh, ivec2 mv0, ivec2 mv1 )
{
  const int   lid = int( gl_LocalInvocationID.x );
  const ivec2 c0 = dmClip( mv0, dmX + bx - 4, dmY + by - 4 ), c1 = dmClip( mv1, dmX + bx - 4, dmY + by - 4 );
  dmSync();
  bdofGlobal = true;
  bdofX0     = bx - 3;
  bdofY0     = by - 3;
  bdofTw     = bw + 6;
  bdofG0     = dmS + 4 * ( dmW >> 2 ) * ( dmH >> 2 );
  bdofG1     = bdofG0 + ( dmW + 6 ) * ( dmH + 6 );
  BufC32 s   = BufC32( pc.scratch );
  for( int i = lid; i < bdofTw * ( bh + 6 ); i += 64 )
  {
    const int cx = clamp( bdofX0 + i % bdofTw, bx - 2, bx + bw + 1 ), cy = clamp( bdofY0 + i / bdofTw, by - 2, by + bh + 1 );
    s.v[bdofG0 + i] = mcPredict( dmSlot0, 0, dmX + cx + ( c0.x >> 4 ), dmY + cy + ( c0.y >> 4 ), c0.x & 15, c0.y & 15, dmAlt,
                                 true, bw + 4, bh + 4, dmBd, dmClipMin, dmClipMax );
    s.v[bdofG1 + i] = mcPredict( dmSlot1, 0, dmX + cx + ( c1.x >> 4 ), dmY + cy + ( c1.y >> 4 ), c1.x & 15, c1.y & 15, dmAlt,
                                 true, bw + 4, bh + 4, dmBd, dmClipMin, dmClipMax );
  }
  dmSync();
}

// the average of two lists' intermediate predictions with BCW's weights (addWeightedAvg; a sample out of boundary in
// one list the other alone)
int dmAvg( int p0, int p1, bool o0, bool o1 )
{
  const int headRoom = max( 2, IF_INTERNAL_PREC - dmBd );
  if( o0 != o1 )
  {
    return ( ( o0 ? p1 : p0 ) + ( 1 << ( headRoom - 1 ) ) + IF_INTERNAL_OFFS ) >> headRoom;
  }
  const int shiftNum = headRoom + BCW_LOG2_WEIGHT_BASE;
  return ( p0 * dmJ( DM_W0 ) + p1 * dmJ( DM_W1 ) + ( 1 << ( shiftNum - 1 ) ) + ( IF_INTERNAL_OFFS << BCW_LOG2_WEIGHT_BASE ) )
         >> shiftNum;
}

// the chroma of block (bx, by, bw, bh) (luma, relative to the PU) at vectors mv0 / mv1: bi-prediction (clipped at the
// grown position with bioApplied, xPredInterUni)
void dmChroma( int bx, int by, int bw, int bh, ivec2 mv0, ivec2 mv1, bool bio )
{
  const int   lid = int( gl_LocalInvocationID.x );
  const int   g   = bio ? 4 : 0;
  const ivec2 c0 = dmClip( mv0, dmX + bx - g, dmY + by - g ), c1 = dmClip( mv1, dmX + bx - g, dmY + by - g );
  const int   cw = bw >> 1, ch = bh >> 1;
  for( int i = lid; i < 2 * cw * ch; i += 64 )
  {
    const int comp = 1 + i / ( cw * ch ), x = ( bx >> 1 ) + i % cw, y = ( by >> 1 ) + ( i / cw ) % ch;
    const int ax = ( dmX >> 1 ) + x, ay = ( dmY >> 1 ) + y;
    const int p0 = mcPredict( dmSlot0, comp, ax + ( c0.x >> 5 ), ay + ( c0.y >> 5 ), c0.x & 31, c0.y & 31, dmAlt, true, cw,
                              ch, dmBd, dmClipMin, dmClipMax );
    const int p1 = mcPredict( dmSlot1, comp, ax + ( c1.x >> 5 ), ay + ( c1.y >> 5 ), c1.x & 31, c1.y & 31, dmAlt, true, cw,
                              ch, dmBd, dmClipMin, dmClipMax );
    dmOut( comp, x, y, dmAvg( p0, p1, dmOob( 2 * x, 2 * y, mv0 ), dmOob( 2 * x, 2 * y, mv1 ) ) );
  }
}

// without BDOF: the luma of a run, bi-prediction at its block size
void dmLuma( int bx, int by, int bw, int bh, ivec2 mv0, ivec2 mv1 )
{
  const int   lid = int( gl_LocalInvocationID.x );
  const ivec2 c0 = dmClip( mv0, dmX + bx, dmY + by ), c1 = dmClip( mv1, dmX + bx, dmY + by );
  for( int i = lid; i < bw * bh; i += 64 )
  {
    const int x = bx + i % bw, y = by + i / bw;
    const int p0 = mcPredict( dmSlot0, 0, dmX + x + ( c0.x >> 4 ), dmY + y + ( c0.y >> 4 ), c0.x & 15, c0.y & 15, dmAlt, true,
                              bw, bh, dmBd, dmClipMin, dmClipMax );
    const int p1 = mcPredict( dmSlot1, 0, dmX + x + ( c1.x >> 4 ), dmY + y + ( c1.y >> 4 ), c1.x & 15, c1.y & 15, dmAlt, true,
                              bw, bh, dmBd, dmClipMin, dmClipMax );
    dmOut( 0, x, y, dmAvg( p0, p1, dmOob( x, y, mv0 ), dmOob( x, y, mv1 ) ) );
  }
}

// the out-of-boundary lists of BDOF block (x0, y0, w, h) (bits) and, if sad, its SAD of dI into sSad, sOob
void dmBlockStats( int x0, int y0, int w, int h, ivec2 mv0, ivec2 mv1, bool sad )
{
  const int lid = int( gl_LocalInvocationID.x );
  if( lid == 0 )
  {
    sSad = 0;
    sOob = 0;
  }
  dmSync();
  for( int i = lid; i < w * h; i += 64 )
  {
    const int x = x0 + i % w, y = y0 + i / w;
    if( sad )
    {
      atomicAdd( sSad, abs( bdofDI( x, y ) ) );
    }
    atomicOr( sOob, ( dmOob( x, y, mv0 ) ? 1 : 0 ) | ( dmOob( x, y, mv1 ) ? 2 : 0 ) );
  }
  dmSync();
}

// the luma of BDOF block (x0, y0, w, h): addAvg (avg) or subBlockBiOptFlow
void dmBlockOut( int x0, int y0, int w, int h, ivec2 mv0, ivec2 mv1, bool avg, bool noMean )
{
  const int  lid      = int( gl_LocalInvocationID.x );
  const int  shiftNum = max( 2, IF_INTERNAL_PREC - dmBd ) + 1, offset = ( 1 << ( shiftNum - 1 ) ) + 2 * IF_INTERNAL_OFFS;
  const bool oobBlock = sOob != 0;
  for( int i = lid; i < w * h; i += 64 )
  {
    const int  x = x0 + i % w, y = y0 + i / w;
    const int  p0 = bdofP( 0, x, y ), p1 = bdofP( 1, x, y );
    const bool o0 = dmOob( x, y, mv0 ), o1 = dmOob( x, y, mv1 );
    int        v;
    if( o0 != o1 )
    {
      v = ( ( o0 ? p1 : p0 ) + ( offset >> 1 ) ) >> ( shiftNum - 1 );
    }
    else if( avg )
    {
      v = ( p0 + p1 + offset ) >> shiftNum;
    }
    else
    {
      v = bdofSample( x, y, p0, p1, oobBlock, noMean, shiftNum, offset );
    }
    dmOut( 0, x, y, v );
  }
}

// (g_bdofWeight's tables: per window width 8 / 12 / 20 and height 8 / 12 / 20)
const int DM_WEIGHT_OFFSET[9] = int[]( 0, 64, 160, 320, 416, 560, 800, 960, 1200 );

// applyBiOptFlow with isBdofMvRefine (iteration iter) on the tile's block (bx, by, bw, bh) at vectors mv0 / mv1
void dmRefine( int bx, int by, int bw, int bh, ivec2 mv0, ivec2 mv1, int iter )
{
  const int  lid     = int( gl_LocalInvocationID.x );
  const int  area    = dmW * dmH;
  const int  scale   = iter == 0 ? 4 : iter == 1 ? ( area < 256 ? 1 : 2 ) : ( area < 2048 ? 1 : 2 );
  const int  bioDx   = min( bw, 4 * scale ), bioDy = min( bh, 4 * scale );
  const int  th      = ( bioDx * bioDy ) << ( 2 + ( iter == 2 ? 0 : dmJ( DM_QP ) ) );
  const bool sameDir = ( dmFlags & DM_SAME_DIR ) != 0;
  const bool noMean  = sameDir && !( bw * bh >= 2048 && dmLdbMode( bw * bh ) == 2 );
  const int  ww = bioDx + 4, wh = bioDy + 4;
  const int  wOff = MC_FILT_BDOF_W + DM_WEIGHT_OFFSET[( ww == 8 ? 0 : ww == 12 ? 3 : 6 ) + ( wh == 8 ? 0 : wh == 12 ? 1 : 2 )];
  for( int yb = 0; yb < bh; yb += bioDy )
  {
    for( int xb = 0; xb < bw; xb += bioDx )
    {
      const int x0 = bx + xb, y0 = by + yb;
      dmBlockStats( x0, y0, bioDx, bioDy, mv0, mv1, true );
      const bool below = sSad < th;
      if( below )
      {
        if( iter != 0 )
        {
          if( lid == 0 )
          {
            for( int u = 0; u < max( 1, bioDy >> 2 ) * max( 1, bioDx >> 2 ); u++ )
            {
              dmSetOff( true, x0 + 4 * ( u % max( 1, bioDx >> 2 ) ), y0 + 4 * ( u / max( 1, bioDx >> 2 ) ), ivec2( 0 ) );
            }
          }
          dmBlockOut( x0, y0, bioDx, bioDy, mv0, mv1, true, noMean );
        }
        dmSync();
        continue;
      }
      // calcBIOParamSum4HighPrecision over the block grown by 2: S1 = gx^2, S2 = gx gy, S3 = gx dI, S5 = gy^2,
      // S6 = gy dI weighted, the weighted gradients and dI's sums for the mean's removal
      if( lid < 9 )
      {
        sAcc[lid] = 0;
      }
      dmSync();
      for( int i = lid; i < ww * wh; i += 64 )
      {
        const int   qx = x0 - 2 + i % ww, qy = y0 - 2 + i / ww;
        const int   w  = BufI32( pc.filters ).v[wOff + i];
        const ivec2 g  = bdofGrad( 0, qx, qy ) + bdofGrad( 1, qx, qy );
        const int   d  = bdofDI( qx, qy );
        atomicAdd( sAcc[0], w * g.x * g.x );
        atomicAdd( sAcc[1], w * g.x * g.y );
        atomicAdd( sAcc[2], w * g.x * d );
        atomicAdd( sAcc[3], w * g.y * g.y );
        atomicAdd( sAcc[4], w * g.y * d );
        atomicAdd( sAcc[5], w * g.x );
        atomicAdd( sAcc[6], w * g.y );
        atomicAdd( sAcc[7], d );
        atomicAdd( sAcc[8], abs( d ) );
      }
      dmSync();
      if( lid == 0 )
      {
        int md = 0;   // (noMR: JVET-AL0081's same direction keeps the mean)
        if( !sameDir )
        {
          const int mean = sAcc[8] > 2 * abs( sAcc[7] ) ? 0 : sAcc[7];
          md             = dmGetMean( mean + ww * wh, ( ww * wh ) << 1 );
        }
        int reg = 2048;
        reg >>= bioDx == 4 ? 1 : 0;
        reg >>= bioDy == 4 ? 1 : 0;
        reg <<= bioDx == 16 || bioDy == 16 ? 1 : 0;
        const int s1 = sAcc[0] + reg, s2 = sAcc[1], s3 = sAcc[2] - md * sAcc[5], s5 = sAcc[3] + reg, s6 = sAcc[4] - md * sAcc[6];
        int64_t       dD = int64_t( s1 ) * int64_t( s5 ) - int64_t( s2 ) * int64_t( s2 );
        const int64_t xD = ( int64_t( s3 ) * int64_t( s5 ) - int64_t( s6 ) * int64_t( s2 ) ) << 4;
        const int64_t yD = ( int64_t( s1 ) * int64_t( s6 ) - int64_t( s3 ) * int64_t( s2 ) ) << 4;
        int           tx = 0, ty = 0;
        const int64_t signD = dD > int64_t( 0 ) ? int64_t( 1 ) : int64_t( -1 );
        dD = dD < int64_t( 0 ) ? -dD : dD;
        if( dD > int64_t( 9 ) )
        {
          const int DIV16[16] = int[]( 0, 7, 6, 5, 5, 4, 4, 3, 3, 2, 2, 1, 1, 1, 1, 0 );
          const int hi = int( dD >> 32 );
          int log2D = hi != 0 ? 32 + findMSB( hi ) : findMSB( uint( dD ) );
          const int msbD = int( ( dD << 4 ) >> log2D ) & 15, invD = DIV16[msbD] | 8;
          log2D += msbD != 0 ? 1 : 0;
          const int     shiftD  = log2D + 3;
          const int64_t offsetD = int64_t( int( 1u << uint( ( shiftD - 1 ) & 31 ) ) );   // (a 32-bit shift on x86)
          tx = int( ( signD * xD * int64_t( invD ) + offsetD ) >> ( shiftD & 63 ) );
          ty = int( ( signD * yD * int64_t( invD ) + offsetD ) >> ( shiftD & 63 ) );
        }
        tx = clamp( tx, -256, 256 );
        ty = clamp( ty, -256, 256 );
        ivec2 bioMv = ivec2( tx >= 0 ? ( tx + 2 ) >> 2 : -( ( -tx + 2 ) >> 2 ), ty >= 0 ? ( ty + 2 ) >> 2 : -( ( -ty + 2 ) >> 2 ) );
        if( iter == 0 || ( iter == 1 && ( area >= 2048 || area < 256 ) ) )
        {
          bioMv = dmHalf( bioMv );
        }
        for( int u = 0; u < max( 1, bioDy >> 2 ) * max( 1, bioDx >> 2 ); u++ )
        {
          const int ux = x0 + 4 * ( u % max( 1, bioDx >> 2 ) ), uy = y0 + 4 * ( u / max( 1, bioDx >> 2 ) );
          dmSetOff( false, ux, uy, ( iter == 0 ? ivec2( 0 ) : dmOff( false, ux, uy ) ) + bioMv );
          dmSetOff( true, ux, uy, bioMv );
        }
        sFlag = iter != 0 && bioMv == ivec2( 0 ) ? 1 : 0;
      }
      dmSync();
      if( sFlag != 0 )
      {
        dmBlockOut( x0, y0, bioDx, bioDy, mv0, mv1, false, noMean );
      }
      dmSync();
    }
  }
}

// xPredInterBiBDMVR2's iteration iter (1, 2): the blocks of equal offsets again at their vectors with the offset
void dmIter( int iter )
{
  const int scale = iter == 1 ? 4 : dmW * dmH < 256 ? 1 : 2;
  const int dx = min( dmW, 4 * scale ), dy = min( dmH, 4 * scale );
  for( int y = 0; y < dmH; y += dy )
  {
    int dx2;
    for( int x = 0; x < dmW; x += dx2 )
    {
      dx2 = dx;
      while( x + dx2 < dmW && dmOff( false, x, y ) == dmOff( false, x + dx2, y ) && dmOff( true, x, y ) == dmOff( true, x + dx2, y )
             && ( ( x >> 4 ) == ( ( x + dx2 ) >> 4 ) || dmMvSame( x, y, x + dx2, y ) ) )
      {
        dx2 += dx;
      }
      dx2 = dx2 == 4 ? 4 : ( dx2 >> 3 ) << 3;
      if( iter == 2 && dmOff( true, x, y ) == ivec2( 0 ) )
      {
        continue;
      }
      const ivec2 bioMv = dmOff( false, x, y );
      const ivec2 mv0 = dmMv( 0, x, y ) + bioMv, mv1 = dmMv( 1, x, y ) - bioMv;
      dmTile( x, y, dx2, dy, mv0, mv1 );
      dmRefine( x, y, dx2, dy, mv0, mv1, iter );
    }
  }
}

// xPredInterBiSubPuBDOF: per block of equal offsets the luma again where the last iteration moved it
// (applyBiOptFlow without isBdofMvRefine: subBlockBiOptFlow everywhere), the chroma of all
void dmFinal()
{
  const int scale = dmW * dmH < 2048 ? 1 : 2;
  const int bioDx = min( dmW, 4 * scale ), bioDy = min( dmH, 4 * scale );
  for( int y = 0; y < dmH; y += bioDy )
  {
    int dx2;
    for( int x = 0; x < dmW; x += dx2 )
    {
      dx2 = bioDx;
      while( x + dx2 < dmW && dmOff( true, x, y ) == dmOff( true, x + dx2, y ) && dmOff( false, x, y ) == dmOff( false, x + dx2, y )
             && ( ( x >> 4 ) == ( ( x + dx2 ) >> 4 ) || dmMvSame( x, y, x + dx2, y ) ) )
      {
        dx2 += bioDx;
      }
      const ivec2 bioMv = dmOff( false, x, y );
      const ivec2 mv0 = dmMv( 0, x, y ) + bioMv, mv1 = dmMv( 1, x, y ) - bioMv;
      if( dmOff( true, x, y ) != ivec2( 0 ) )
      {
        dmTile( x, y, dx2, bioDy, mv0, mv1 );
        const int  sc     = dx2 % 8 == 4 && dx2 != 4 ? 1 : 2;
        const int  bdx    = min( dx2, 4 * sc ), bdy = min( bioDy, 4 * sc );
        const bool noMean = ( dmFlags & DM_SAME_DIR ) != 0 && !( dx2 * bioDy >= 2048 && dmLdbMode( dx2 * bioDy ) == 2 );
        for( int yb = 0; yb < bioDy; yb += bdy )
        {
          for( int xb = 0; xb < dx2; xb += bdx )
          {
            dmBlockStats( x + xb, y + yb, bdx, bdy, mv0, mv1, false );
            dmBlockOut( x + xb, y + yb, bdx, bdy, mv0, mv1, false, noMean );
            dmSync();
          }
        }
      }
      dmChroma( x, y, dx2, bioDy, mv0, mv1, true );
      dmSync();
    }
  }
}

void dmvrJob( int o )
{
  const int lid = int( gl_LocalInvocationID.x );
  dmO       = o;
  dmX       = dmJ( DM_X );
  dmY       = dmJ( DM_Y );
  dmW       = dmJ( DM_W );
  dmH       = dmJ( DM_H );
  dmFlags   = dmJ( DM_FLAGS );
  dmBd      = dmJ( DM_BD );
  dmClipMin = dmJ( DM_CLIP_MIN );
  dmClipMax = dmJ( DM_CLIP_MAX );
  dmSlot0   = dmJ( DM_REF0 );
  dmSlot1   = dmJ( DM_REF1 );
  dmS       = dmJ( DM_SCRATCH );
  dmDst     = dmJ( DM_DST );
  dmNux     = ( dmW + 15 ) >> 4;
  dmAlt     = ( dmFlags & MC_ALT_HPEL ) != 0;
  const bool bio = ( dmFlags & DM_BIO ) != 0;
  for( int i = lid; i < 4 * ( dmW >> 2 ) * ( dmH >> 2 ); i += 64 )   // the offsets 0
  {
    BufC32( pc.scratch ).v[dmS + i] = 0;
  }
  dmSync();
  // the runs of DMVR's sub-PUs (columns where H > W): without BDOF their prediction, with it the first pass
  if( !bio || ( dmFlags & DM_SKIP_A ) == 0 )
  {
    const int dx = min( dmW, 16 ), dy = min( dmH, 16 );
    for( int a = 0; a < ( dmH > dmW ? dmW : dmH ); a += ( dmH > dmW ? dx : dy ) )
    {
      int len;
      for( int b = 0; b < ( dmH > dmW ? dmH : dmW ); b += len )
      {
        const int x = dmH > dmW ? a : b, y = dmH > dmW ? b : a;
        len = dmH > dmW ? dy : dx;
        while( b + len < ( dmH > dmW ? dmH : dmW ) && ( dmH > dmW ? dmMvSame( x, y + len, x, y ) : dmMvSame( x + len, y, x, y ) ) )
        {
          len += dmH > dmW ? dy : dx;
        }
        const int   w = dmH > dmW ? dx : len, h = dmH > dmW ? len : dy;
        const ivec2 mv0 = dmMv( 0, x, y ), mv1 = dmMv( 1, x, y );
        if( bio )
        {
          dmTile( x, y, w, h, mv0, mv1 );
          dmRefine( x, y, w, h, mv0, mv1, 0 );
        }
        else
        {
          dmLuma( x, y, w, h, mv0, mv1 );
          dmChroma( x, y, w, h, mv0, mv1, false );
          dmSync();
        }
      }
    }
  }
  if( bio )
  {
    dmIter( 1 );
    dmIter( 2 );
    dmFinal();
  }
  dmSync();
  bdofGlobal = false;
}

// ----- the blocks' jobs (mode 0)

// ----- affine (InterPrediction::xPredAffineBlk per list, then xPredInterBi's average): a block's job with MC_AFFINE
// reads its PU's record in pc.affine (AF_*), per sample: its sub-block of the list's adaptive size (from the control
// points' deltas: 4 x 4 and up, or JVET-AC0158's pixel blocks below 4), the sub-block's vector (rounded to 1/16 and
// clipped; luma at 1/64 with m_lumaFilter64 where its integer part agrees - JVET-AJ0158 -, chroma the average of the
// stored luma motion of the sub-block's corner units, or with pixel blocks its own vector), with PROF (luma sub-blocks
// of 4 x 4 and up: the intermediate refined by the per-position vector offsets and the 3-tap gradients, the ring
// around the sub-block integer samples), bi-prediction's average with BCW and the out-of-boundary samples per
// sub-block
const int AF_X = 0, AF_Y = 1, AF_W = 2, AF_H = 3, AF_BI = 4, AF_LIST = 5, AF_SHIFT = 6, AF_W0 = 7, AF_W1 = 8;
const int AF_HMAX = 9, AF_HMIN = 10, AF_VMAX = 11, AF_VMIN = 12, AF_PIC_W = 13, AF_PIC_H = 14, AF_BD = 15;
const int AF_CLIP_MIN = 16, AF_CLIP_MAX = 17, AF_MVF = 18, AF_LIC = 19, AF_C0 = 20;
// per list and component class (luma, chroma): the base vector (mvLT << iBit), the deltas, the sub-block size, pixel
// blocks, PROF, the slot
const int AF_MVH = 0, AF_MVV = 1, AF_DHX = 2, AF_DHY = 3, AF_DVX = 4, AF_DVY = 5, AF_BW = 6, AF_BH = 7, AF_1X1 = 8;
const int AF_PROF = 9, AF_SLOT = 10, AF_C = 12;

int afJ( int r, int f )
{
  return BufI32( pc.affine ).v[r + f];
}

// roundAffineMv
ivec2 afRound( ivec2 v, int s )
{
  return ( v + ( 1 << ( s - 1 ) ) - ivec2( greaterThanEqual( v, ivec2( 0 ) ) ) ) >> s;
}

// clipToStorageBitDepth, then clipMvInl at the PU
ivec2 afClip( int r, ivec2 mv )
{
  mv = clamp( mv, ivec2( -( 1 << 17 ) ), ivec2( ( 1 << 17 ) - 1 ) );
  return ivec2( clamp( mv.x, ( afJ( r, AF_HMIN ) - afJ( r, AF_X ) ) << 4, ( afJ( r, AF_HMAX ) - afJ( r, AF_X ) ) << 4 ),
                clamp( mv.y, ( afJ( r, AF_VMIN ) - afJ( r, AF_Y ) ) << 4, ( afJ( r, AF_VMAX ) - afJ( r, AF_Y ) ) << 4 ) );
}

// list l's sub-block of component comp's sample (x, y) relative to the PU: its origin, size, vector (1/16 luma), luma's
// 1/64 fractions
void afSubBlock( int r, int l, int comp, int x, int y, out ivec2 org, out ivec2 size, out ivec2 mv, out ivec2 frac64 )
{
  const int  c  = r + AF_C0 + ( l * 2 + ( comp == 0 ? 0 : 1 ) ) * AF_C;
  const int  bw = afJ( c, AF_BW ), bh = afJ( c, AF_BH ), shift = afJ( r, AF_SHIFT );
  const bool px = afJ( c, AF_1X1 ) != 0;
  org  = ivec2( x - x % bw, y - y % bh );
  size = ivec2( bw, bh );
  if( comp != 0 && !px )   // (chroma: the stored luma motion of the corner units, xPredAffineBlk's miLine / miLine2)
  {
    BufI32    a  = BufI32( pc.affine );
    const int uw = afJ( r, AF_W ) >> 2;
    const int u0 = afJ( r, AF_MVF ) + ( ( org.y >> 1 ) * uw + ( org.x >> 1 ) ) * 4 + l * 2;
    const int u1 = u0 + ( uw + 1 ) * 4;
    mv     = afRound( ivec2( a.v[u0] + a.v[u1], a.v[u0 + 1] + a.v[u1 + 1] ), 1 );
    mv     = ivec2( clamp( mv.x, ( afJ( r, AF_HMIN ) - afJ( r, AF_X ) ) << 4, ( afJ( r, AF_HMAX ) - afJ( r, AF_X ) ) << 4 ),
                    clamp( mv.y, ( afJ( r, AF_VMIN ) - afJ( r, AF_Y ) ) << 4, ( afJ( r, AF_VMAX ) - afJ( r, AF_Y ) ) << 4 ) );
    frac64 = ivec2( 0 );
    return;
  }
  const ivec2 base = ivec2( afJ( c, AF_MVH ), afJ( c, AF_MVV ) )
                     + ( ( ivec2( afJ( c, AF_DHX ), afJ( c, AF_DHY ) ) * bw + ivec2( afJ( c, AF_DVX ), afJ( c, AF_DVY ) ) * bh ) >> 1 );
  const ivec2 v  = base + ivec2( afJ( c, AF_DHX ), afJ( c, AF_DHY ) ) * org.x + ivec2( afJ( c, AF_DVX ), afJ( c, AF_DVY ) ) * org.y;
  const ivec2 hp = afRound( v, shift - 2 );
  mv             = afClip( r, afRound( v, shift ) );
  if( comp == 0 )   // (the 1/64 fraction where its integer part is the clipped vector's, else the 1/16 one's)
  {
    frac64 = ( hp >> 6 ) == ( mv >> 4 ) ? hp & 63 : ( mv & 15 ) << 2;
    if( ( hp.x >> 6 ) != ( mv.x >> 4 ) || ( hp.y >> 6 ) != ( mv.y >> 4 ) )
    {
      frac64 = ( mv & 15 ) << 2;
    }
  }
  else
  {
    frac64 = ivec2( 0 );
  }
}

// list l's prediction of component comp at sample (x, y) relative to the PU before PROF (bi: the intermediate)
int afPredict( int r, int l, int comp, int x, int y, ivec2 mv, ivec2 frac64, ivec2 size, bool bi )
{
  const int c  = r + AF_C0 + ( l * 2 + ( comp == 0 ? 0 : 1 ) ) * AF_C, slot = afJ( c, AF_SLOT );
  const int cs = comp == 0 ? 0 : 1;
  const int ax = ( afJ( r, AF_X ) >> cs ) + x, ay = ( afJ( r, AF_Y ) >> cs ) + y;
  const int bd = afJ( r, AF_BD ), clipMin = afJ( r, AF_CLIP_MIN ), clipMax = afJ( r, AF_CLIP_MAX );
  if( comp == 0 )
  {
    mcF64       = true;
    const int v = mcPredict( slot, 0, ax + ( mv.x >> 4 ), ay + ( mv.y >> 4 ), frac64.x, frac64.y, false, bi, size.x, size.y, bd,
                             clipMin, clipMax );
    mcF64       = false;
    return v;
  }
  return mcPredict( slot, comp, ax + ( mv.x >> 5 ), ay + ( mv.y >> 5 ), mv.x & 31, mv.y & 31, false, bi, size.x, size.y, bd,
                    clipMin, clipMax );
}

// PROF's intermediate at (u, v) relative to the PU: inside the sub-block its prediction, on the ring around it the
// integer sample at the rounded vector (leftShift_round - IF_INTERNAL_OFFS)
int afProfP( int r, int l, int u, int v, ivec2 org, ivec2 size, ivec2 mv, ivec2 frac64 )
{
  if( u >= org.x && u < org.x + size.x && v >= org.y && v < org.y + size.y )
  {
    return afPredict( r, l, 0, u, v, mv, frac64, size, true );
  }
  const int c = r + AF_C0 + l * 2 * AF_C, shift = max( 2, IF_INTERNAL_PREC - afJ( r, AF_BD ) );
  const int s = refAt( afJ( c, AF_SLOT ), 0, afJ( r, AF_X ) + u + ( mv.x >> 4 ) + ( frac64.x >> 5 ),
                       afJ( r, AF_Y ) + v + ( mv.y >> 4 ) + ( frac64.y >> 5 ) );
  return int( int16_t( ( s << shift ) - IF_INTERNAL_OFFS ) );
}

// list l's sample of component comp at (x, y) relative to the PU (uni: final; bi: the 14-bit intermediate)
int afList( int r, int l, int comp, int x, int y, bool bi )
{
  ivec2 org, size, mv, frac64;
  afSubBlock( r, l, comp, x, y, org, size, mv, frac64 );
  const int c = r + AF_C0 + ( l * 2 + ( comp == 0 ? 0 : 1 ) ) * AF_C;
  if( comp != 0 || afJ( c, AF_PROF ) == 0 )
  {
    return afPredict( r, l, comp, x, y, mv, frac64, size, bi );
  }
  // PROF: the 4 x 4 pattern of vector offsets (rounded by 1 << (iBit + 1), clipped to +-31), the gradients
  const int src = afPredict( r, l, 0, x, y, mv, frac64, size, true );
  const int gx  = int( int16_t( ( afProfP( r, l, x + 1, y, org, size, mv, frac64 ) >> 6 )
                                - ( afProfP( r, l, x - 1, y, org, size, mv, frac64 ) >> 6 ) ) );
  const int gy  = int( int16_t( ( afProfP( r, l, x, y + 1, org, size, mv, frac64 ) >> 6 )
                                - ( afProfP( r, l, x, y - 1, org, size, mv, frac64 ) >> 6 ) ) );
  const ivec2 dh = ivec2( afJ( c, AF_DHX ), afJ( c, AF_DHY ) ), dv = ivec2( afJ( c, AF_DVX ), afJ( c, AF_DVY ) );
  const ivec2 d0 = ( ( dh + dv ) << 1 ) - ( ( ( dh << 2 ) + ( dv << 2 ) ) << 1 );
  const ivec2 dm = clamp( afRound( d0 + ( dh << 2 ) * ( x & 3 ) + ( dv << 2 ) * ( y & 3 ), afJ( r, AF_SHIFT ) + 1 ), ivec2( -31 ),
                          ivec2( 31 ) );
  const int bd = afJ( r, AF_BD ), lim = 1 << max( bd + 1, 13 );
  const int dI = clamp( dm.x * gx + dm.y * gy, -lim, lim - 1 );
  const int p  = int( int16_t( src + dI ) );
  if( bi )
  {
    return p;
  }
  const int shiftNum = max( 2, IF_INTERNAL_PREC - bd );
  return clamp( ( p + ( 1 << ( shiftNum - 1 ) ) + IF_INTERNAL_OFFS ) >> shiftNum, afJ( r, AF_CLIP_MIN ), afJ( r, AF_CLIP_MAX ) );
}

// isMvOOBSubBlk of list l at luma sample (lx, ly) relative to the PU: its sub-block's (at least 4 x 4) clipped vector
bool afOob( int r, int l, int lx, int ly )
{
  const int c  = r + AF_C0 + l * 2 * AF_C;
  const int bw = afJ( c, AF_BW ), bh = afJ( c, AF_BH );
  const int sw = max( bw, 4 ), sh = max( bh, 4 );
  ivec2     org, size, mv, frac64;
  afSubBlock( r, l, 0, lx - lx % sw, ly - ly % sh, org, size, mv, frac64 );
  const int ox = ( ( afJ( r, AF_X ) + lx ) << 4 ) + mv.x, oy = ( ( afJ( r, AF_Y ) + ly ) << 4 ) + mv.y;
  return ox <= -8 || ox >= ( ( afJ( r, AF_PIC_W ) - 1 ) << 4 ) + 8 || oy <= -8 || oy >= ( ( afJ( r, AF_PIC_H ) - 1 ) << 4 ) + 8;
}

int mcLic( BufI32 jb, int lo, int l, int comp, int v, int clipMin, int clipMax );
int mcLicBi( BufI32 jb, int lo, int l, int comp, int p, int bd, int clipMin, int clipMax );

// an affine PU's sample of component comp at (x, y) (the component's coordinates); with LIC (AF_LIC: where the CU's
// models are) xPredAffineBlk's model on uni-prediction's final samples, xLicCompAdj's per list on bi-prediction's
// intermediate
int afSample( int r, int comp, int x, int y )
{
  const int cs = comp == 0 ? 0 : 1;
  const int px = x - ( afJ( r, AF_X ) >> cs ), py = y - ( afJ( r, AF_Y ) >> cs );
  const int bd = afJ( r, AF_BD ), clipMin = afJ( r, AF_CLIP_MIN ), clipMax = afJ( r, AF_CLIP_MAX );
  const int lic = afJ( r, AF_LIC );
  if( afJ( r, AF_BI ) == 0 )
  {
    const int l = afJ( r, AF_LIST ), v = afList( r, l, comp, px, py, false );
    return lic < 0 ? v : mcLic( BufI32( pc.affine ), lic, l, comp, v, clipMin, clipMax );
  }
  int        p0 = afList( r, 0, comp, px, py, true ), p1 = afList( r, 1, comp, px, py, true );
  const bool o0 = afOob( r, 0, px << cs, py << cs ), o1 = afOob( r, 1, px << cs, py << cs );
  const int  headRoom = max( 2, IF_INTERNAL_PREC - bd );
  if( lic >= 0 )
  {
    p0 = mcLicBi( BufI32( pc.affine ), lic, 0, comp, p0, bd, clipMin, clipMax );
    p1 = mcLicBi( BufI32( pc.affine ), lic, 1, comp, p1, bd, clipMin, clipMax );
  }
  if( o0 != o1 )
  {
    return clamp( ( ( o0 ? p1 : p0 ) + ( 1 << ( headRoom - 1 ) ) + IF_INTERNAL_OFFS ) >> headRoom, clipMin, clipMax );
  }
  const int shiftNum = headRoom + BCW_LOG2_WEIGHT_BASE;
  return clamp( ( p0 * afJ( r, AF_W0 ) + p1 * afJ( r, AF_W1 ) + ( 1 << ( shiftNum - 1 ) ) + ( IF_INTERNAL_OFFS << BCW_LOG2_WEIGHT_BASE ) )
                  >> shiftNum,
                clipMin, clipMax );
}

// LIC's model of list l and component comp at lo (scale, offset: the CU's or the neighbour's stored one, JVET-AD0213)
// on a sample (linearTransform: (scale v >> 5) + offset, clipped)
int mcLic( BufI32 jb, int lo, int l, int comp, int v, int clipMin, int clipMax )
{
  const int k = lo + ( l * 3 + comp ) * 2;
  return clamp( ( ( jb.v[k] * v ) >> 5 ) + jb.v[k + 1], clipMin, clipMax );
}

// ... on a 14-bit intermediate (xLicCompAdj's OBMC branch: toLast, the model, back to the intermediate)
int mcLicBi( BufI32 jb, int lo, int l, int comp, int p, int bd, int clipMin, int clipMax )
{
  const int headRoom = max( 2, IF_INTERNAL_PREC - bd );
  const int q = clamp( ( p + ( 1 << ( headRoom - 1 ) ) + IF_INTERNAL_OFFS ) >> headRoom, clipMin, clipMax );
  return int( int16_t( ( mcLic( jb, lo, l, comp, q, clipMin, clipMax ) << ( IF_INTERNAL_PREC - bd ) ) - IF_INTERNAL_OFFS ) );
}

// component comp's sample (x, y) (the component's coordinates) predicted with job o's motion (MC_MVX.., MC_REF..,
// MC_FLAGS' MC_ALT_HPEL / MC_BI / MC_BDOF, MC_W0 / MC_W1, MC_OOB with the unclipped vectors, MC_PU_X / MC_PU_Y its PU's
// luma position, MC_PIC_W / MC_PIC_H, MC_BDOF_OUT), its PU of puW x puH samples in the component (the sharp filter),
// clipped to [clipMin, clipMax]; with lo >= 0 each list's LIC model (mcLic: uni-prediction's list MC_L1 or 0), with
// MC_LIC the CU's own
int mcSampleBase( BufI32 jb, int o, int comp, int x, int y, int puW, int puH, int bd, int clipMin, int clipMax, int lo )
{
  const int   flags = jb.v[o + MC_FLAGS];
  BufI32      lb    = jb;   // (where the models are)
  if( ( flags & MC_LIC ) != 0 )
  {
    lb = BufI32( pc.affine );
    lo = jb.v[o + MC_BDOF_OUT];
  }
  const bool  luma = comp == 0, alt = ( flags & MC_ALT_HPEL ) != 0, bi = ( flags & MC_BI ) != 0;
  const int   cs = luma ? 0 : 1;   // (4:2:0)
  const int   shift = 4 + cs, mask = ( 1 << shift ) - 1;
  const ivec2 mv0 = ivec2( jb.v[o + MC_MVX], jb.v[o + MC_MVY] ), mv1 = ivec2( jb.v[o + MC_MV1X], jb.v[o + MC_MV1Y] );
  const int   slot0 = jb.v[o + MC_REF], slot1 = jb.v[o + MC_REF1];
  const int   headRoom = max( 2, IF_INTERNAL_PREC - bd );
  if( ( flags & MC_AFFINE ) != 0 )
  {
    return afSample( jb.v[o + MC_BDOF_OUT], comp, x, y );
  }
  if( ( flags & MC_BDOF ) != 0 )   // the PU's BDOF / DMVR prediction
  {
    return int( BufI16( pc.bdofOut )
                  .v[jb.v[o + MC_BDOF_OUT] + ( y - ( jb.v[o + MC_PU_Y] >> cs ) ) * puW + x - ( jb.v[o + MC_PU_X] >> cs )] );
  }
  if( !bi )
  {
    const int v = mcPredict( slot0, comp, x + ( mv0.x >> shift ), y + ( mv0.y >> shift ), mv0.x & mask, mv0.y & mask, alt,
                             false, puW, puH, bd, clipMin, clipMax );
    return lo < 0 ? v : mcLic( lb, lo, ( flags & MC_L1 ) != 0 ? 1 : 0, comp, v, clipMin, clipMax );
  }
  int p0 = mcPredict( slot0, comp, x + ( mv0.x >> shift ), y + ( mv0.y >> shift ), mv0.x & mask, mv0.y & mask, alt, true,
                      puW, puH, bd, clipMin, clipMax );
  int p1 = mcPredict( slot1, comp, x + ( mv1.x >> shift ), y + ( mv1.y >> shift ), mv1.x & mask, mv1.y & mask, alt, true,
                      puW, puH, bd, clipMin, clipMax );
  if( lo >= 0 )
  {
    p0 = mcLicBi( lb, lo, 0, comp, p0, bd, clipMin, clipMax );
    p1 = mcLicBi( lb, lo, 1, comp, p1, bd, clipMin, clipMax );
  }
  const int oob = jb.v[o + MC_OOB];
  bool      o0 = false, o1 = false;
  if( oob != 0 )   // (the PU's luma sample of this sample: chroma's at twice its position)
  {
    const int px = ( x - ( jb.v[o + MC_PU_X] >> cs ) ) << cs, py = ( y - ( jb.v[o + MC_PU_Y] >> cs ) ) << cs;
    o0 = ( oob & 1 ) != 0 && mcOutOfBoundary( jb, o, px, py, jb.v[o + MC_RAW0X], jb.v[o + MC_RAW0Y] );
    o1 = ( oob & 2 ) != 0 && mcOutOfBoundary( jb, o, px, py, jb.v[o + MC_RAW1X], jb.v[o + MC_RAW1Y] );
  }
  if( o0 != o1 )   // one list alone: rounded from the intermediate
  {
    const int shift2 = headRoom, offset2 = ( 1 << ( shift2 - 1 ) ) + IF_INTERNAL_OFFS;
    return clamp( ( ( o0 ? p1 : p0 ) + offset2 ) >> shift2, clipMin, clipMax );
  }
  // addWeightedAvg (weightedAvg's formula; BCW_DEFAULT's weights 4 and 4)
  const int shiftNum = headRoom + BCW_LOG2_WEIGHT_BASE;
  const int offset   = ( 1 << ( shiftNum - 1 ) ) + ( IF_INTERNAL_OFFS << BCW_LOG2_WEIGHT_BASE );
  return clamp( ( p0 * jb.v[o + MC_W0] + p1 * jb.v[o + MC_W1] + offset ) >> shiftNum, clipMin, clipMax );
}

// mcSampleBase's sample, with MC_NLIC the CU's non-local LIC model on it
int mcSample( BufI32 jb, int o, int comp, int x, int y, int puW, int puH, int bd, int clipMin, int clipMax, int lo )
{
  const int v = mcSampleBase( jb, o, comp, x, y, puW, puH, bd, clipMin, clipMax, lo );
  return ( jb.v[o + MC_FLAGS] & MC_NLIC ) == 0 ? v
         : mcLic( BufI32( pc.affine ), jb.v[o + MC_NLIC_AT], 0, comp, v, clipMin, clipMax );
}

// ----- OBMC (mode 3, after the blocks' jobs): one boundary segment of an OBMC CU per job (subBlockOBMC's segments of
// one neighbouring motion, which the host takes from PU::getSameNeigMotion): what does not read the current picture,
// into the segment's data in pc.outPred (OBMC_D_*), for intra_rec's choice and blending
// - the band's prediction with the neighbour's motion (xSubBlockMotionCompensation: bi-prediction with the neighbour's
//   BCW weight, its out-of-boundary samples; the CU's half-sample filter flag) per component
// - per component skipObmcConditionByPixel: the neighbour's motion rounded to integer samples, each of its lists
//   predicted alone over the band, against the CU's prediction there (the blocks' jobs' motion: mcSample) - a
//   difference of 96 << (bit depth - 8) or more skips that component
// - with JVET-Z0061's TM OBMC the one-sample templates beside the segment predicted with the CU's motion and the
//   neighbour's (getBlkOBMCRefTemplate: the 4-tap TM filter, bi-prediction averaged with the BCW weight of the motion's
//   CU)

// an OBMC job (int32, 2 x MC_JOB): an McJob of the neighbour's motion over the band (MC_X, MC_Y, MC_W, MC_H: the band's
// luma area; MC_DST: where its data goes in pc.outPred; MC_PU_X / MC_PU_Y the band's position), then OBMC_J_*
const int OBMC_J_DIR = 32, OBMC_J_FLAGS = 33, OBMC_J_BASE = 34, OBMC_J_THRESHOLD = 37, OBMC_J_INT_MV = 39;
const int OBMC_J_INT_DIR = 43, OBMC_J_TPL = 44, OBMC_J_TPL_MOTION = 9, OBMC_J_LIC = 64, OBMC_J_NLIC = 76;
const int OBMC_J_CLIC = 88, OBMC_J_CNLIC = 100, OBMC_J = 106;
const int OBMC_LIC  = 2;   // OBMC_J_FLAGS: the neighbour's LIC models at OBMC_J_LIC (per list and component)
const int OBMC_NLIC = 4;   // ... its non-local LIC model (JVET-AG0276, secAltLMParaUnit) at OBMC_J_NLIC (per component)
const int OBMC_CLIC = 8;   // the CU's own LIC models at OBMC_J_CLIC: selectOBMCmode predicts the template of the CU's
                           // motion with them (the neighbour's with the neighbour's)
const int OBMC_CNLIC = 16; // ... its own non-local LIC model (altLMParaUnit) at OBMC_J_CNLIC
// a template motion (OBMC_J_TPL: the CU's, then the neighbour's): list 0's vector, list 1's (clipped as
// getBlkOBMCRefTemplate clips them, the template's offset in), the slots, the kind (0: list 0, 1: list 1, 2: both),
// the BCW weights
const int OBMC_T_MV0 = 0, OBMC_T_MV1 = 2, OBMC_T_REF0 = 4, OBMC_T_REF1 = 5, OBMC_T_KIND = 6, OBMC_T_W0 = 7, OBMC_T_W1 = 8;
const int OBMC_TM = 1;   // OBMC_J_FLAGS: the templates
// a segment's data (int16): the skip flags (Y, Cb, Cr), the templates with the CU's and the neighbour's motion (L each),
// the band's luma prediction (W x H), Cb's, Cr's (W / 2 x H / 2)
const int OBMC_D_SKIP = 0, OBMC_D_TPL = 3;

shared int sObmcSkip;

// the 4-tap TM filter's prediction of a template sample at (x, y) of reference slot (luma; uni: rounded and clipped,
// bi: the 14-bit intermediate), the template a block of tw x th samples
int obmcTplPredict( int slot, int x, int y, ivec2 mv, bool bi, int tw, int th, int bd, int clipMin, int clipMax )
{
  return mcPredictTaps( slot, 0, x + ( mv.x >> 4 ), y + ( mv.y >> 4 ), mv.x & 15, mv.y & 15, true, bi, tw, th, bd, clipMin,
                        clipMax );
}

int obmcTpl( BufI32 jb, int t, int x, int y, int tw, int th, int bd, int clipMin, int clipMax, int lic )
{
  const int kind = jb.v[t + OBMC_T_KIND];
  if( kind != 2 )
  {
    const int l = kind;
    const int v = obmcTplPredict( jb.v[t + OBMC_T_REF0 + l], x, y,
                                  ivec2( jb.v[t + OBMC_T_MV0 + 2 * l], jb.v[t + OBMC_T_MV0 + 2 * l + 1] ), false, tw, th, bd,
                                  clipMin, clipMax );
    return lic < 0 ? v : mcLic( jb, lic, l, 0, v, clipMin, clipMax );
  }
  int p0 = obmcTplPredict( jb.v[t + OBMC_T_REF0], x, y, ivec2( jb.v[t + OBMC_T_MV0], jb.v[t + OBMC_T_MV0 + 1] ), true, tw, th,
                           bd, clipMin, clipMax );
  int p1 = obmcTplPredict( jb.v[t + OBMC_T_REF1], x, y, ivec2( jb.v[t + OBMC_T_MV1], jb.v[t + OBMC_T_MV1 + 1] ), true, tw, th,
                           bd, clipMin, clipMax );
  if( lic >= 0 )
  {
    p0 = mcLicBi( jb, lic, 0, 0, p0, bd, clipMin, clipMax );
    p1 = mcLicBi( jb, lic, 1, 0, p1, bd, clipMin, clipMax );
  }
  const int headRoom = max( 2, IF_INTERNAL_PREC - bd ), shiftNum = headRoom + BCW_LOG2_WEIGHT_BASE;
  const int offset   = ( 1 << ( shiftNum - 1 ) ) + ( IF_INTERNAL_OFFS << BCW_LOG2_WEIGHT_BASE );
  return clamp( ( p0 * jb.v[t + OBMC_T_W0] + p1 * jb.v[t + OBMC_T_W1] + offset ) >> shiftNum, clipMin, clipMax );
}

void obmcJob( int o, int lid )
{
  BufI32    jb = BufI32( pc.jobs ), base = BufI32( pc.scratch );
  BufI16    od = BufI16( pc.outPred );
  const int bx = jb.v[o + MC_X], by = jb.v[o + MC_Y], W = jb.v[o + MC_W], H = jb.v[o + MC_H], dst = jb.v[o + MC_DST];
  const int bd = jb.v[o + MC_BD], clipMin = jb.v[o + MC_CLIP_MIN], clipMax = jb.v[o + MC_CLIP_MAX];
  const int dir = jb.v[o + OBMC_J_DIR], L = dir == 0 ? W : H;
  const int lic = ( jb.v[o + OBMC_J_FLAGS] & OBMC_LIC ) != 0 ? o + OBMC_J_LIC : -1;
  const int nlic = ( jb.v[o + OBMC_J_FLAGS] & OBMC_NLIC ) != 0 ? o + OBMC_J_NLIC : -1;   // (on the final prediction)
  const int clic = ( jb.v[o + OBMC_J_FLAGS] & OBMC_CLIC ) != 0 ? o + OBMC_J_CLIC : -1;
  const int cnlic = ( jb.v[o + OBMC_J_FLAGS] & OBMC_CNLIC ) != 0 ? o + OBMC_J_CNLIC : -1;
  const int predOff[3] = int[]( dst + OBMC_D_TPL + 2 * L, dst + OBMC_D_TPL + 2 * L + W * H,
                                dst + OBMC_D_TPL + 2 * L + W * H + ( W >> 1 ) * ( H >> 1 ) );
  for( int comp = 0; comp < 3; comp++ )
  {
    const int cs = comp == 0 ? 0 : 1, cw = W >> cs, ch = H >> cs, cx = bx >> cs, cy = by >> cs;
    const int bj = jb.v[o + OBMC_J_BASE + comp] * MC_JOB;   // (the CU's block job of this component)
    if( lid == 0 )
    {
      sObmcSkip = 0;
    }
    barrier();
    for( int i = lid; i < cw * ch; i += 64 )
    {
      const int x = cx + i % cw, y = cy + i / cw;
      int nbv = mcSample( jb, o, comp, x, y, cw, ch, bd, clipMin, clipMax, lic );
      nbv     = nlic < 0 ? nbv : mcLic( jb, nlic, 0, comp, nbv, clipMin, clipMax );
      od.v[predOff[comp] + i] = int16_t( nbv );
      // skipObmcConditionByPixel: each list of the neighbour's motion at its integer vector, uni-prediction of the band
      const int before = mcSample( base, bj, comp, x, y, base.v[bj + MC_PU_W], base.v[bj + MC_PU_H], bd, clipMin, clipMax, -1 );
      for( int l = 0; l < 2; l++ )
      {
        if( ( jb.v[o + OBMC_J_INT_DIR] & ( 1 << l ) ) != 0 )
        {
          const ivec2 mv = ivec2( jb.v[o + OBMC_J_INT_MV + 2 * l], jb.v[o + OBMC_J_INT_MV + 2 * l + 1] );
          const int   shift = 4 + cs, mask = ( 1 << shift ) - 1;
          int         r = mcPredict( jb.v[o + ( l == 0 ? MC_REF : MC_REF1 )], comp, x + ( mv.x >> shift ), y + ( mv.y >> shift ),
                                     mv.x & mask, mv.y & mask, ( jb.v[o + MC_FLAGS] & MC_ALT_HPEL ) != 0, false, cw, ch, bd,
                                     clipMin, clipMax );
          // (the CPU's model is m_iRefListIdx's, which the band's prediction left: list 1 after bi-prediction, else
          // its one list - for both lists)
          const int lm = ( jb.v[o + MC_FLAGS] & ( MC_BI | MC_L1 ) ) != 0 ? 1 : 0;
          r = lic < 0 ? r : mcLic( jb, lic, lm, comp, r, clipMin, clipMax );
          if( abs( before - r ) >= jb.v[o + OBMC_J_THRESHOLD + ( comp == 0 ? 0 : 1 )] )
          {
            atomicOr( sObmcSkip, 1 );
          }
        }
      }
    }
    barrier();
    if( lid == 0 )
    {
      od.v[dst + OBMC_D_SKIP + comp] = int16_t( sObmcSkip );
    }
    barrier();
  }
  if( ( jb.v[o + OBMC_J_FLAGS] & OBMC_TM ) != 0 )   // the templates: a row above the band or a column left of it
  {
    const int tw = dir == 0 ? W : 1, th = dir == 0 ? 1 : H;
    for( int i = lid; i < 2 * L; i += 64 )
    {
      const int k = i % L, t = o + OBMC_J_TPL + ( i / L ) * OBMC_J_TPL_MOTION;
      const int x = bx + ( dir == 0 ? k : 0 ), y = by + ( dir == 0 ? 0 : k );
      int tv = obmcTpl( jb, t, x, y, tw, th, bd, clipMin, clipMax, i < L ? clic : lic );
      const int nl = i < L ? cnlic : nlic;
      tv     = nl < 0 ? tv : mcLic( jb, nl, 0, 0, tv, clipMin, clipMax );
      od.v[dst + OBMC_D_TPL + i] = int16_t( tv );
    }
  }
}

// ----- the inner sub-block OBMC of sub-block motion (mode 4): one 4 x 4 sub-block per job, its neighbours' motions
// (above, left, below, right: each an McJob, OBMC_I_NB + k * MC_JOB, where it differs - getNeighborMotion -) predicting
// the sub-block (xSubBlockMotionCompensation: bi-prediction with the CU's BCW weight), into its entry (OBMC_I_*)
const int OBMC_I_X = 1, OBMC_I_Y = 2, OBMC_I_DST = 5, OBMC_I_BD = 12, OBMC_I_CLIP_MIN = 13, OBMC_I_CLIP_MAX = 14;
const int OBMC_I_AVAIL = 15, OBMC_I_NB = 32, OBMC_I = OBMC_I_NB + 4 * MC_JOB;

void obmcInnerJob( int o, int lid )
{
  BufI32    jb = BufI32( pc.jobs );
  BufI16    od = BufI16( pc.outPred );
  const int sx = jb.v[o + OBMC_I_X], sy = jb.v[o + OBMC_I_Y], dst = jb.v[o + OBMC_I_DST], av = jb.v[o + OBMC_I_AVAIL];
  const int bd = jb.v[o + OBMC_I_BD], clipMin = jb.v[o + OBMC_I_CLIP_MIN], clipMax = jb.v[o + OBMC_I_CLIP_MAX];
  if( lid == 0 )
  {
    od.v[dst] = int16_t( av );
  }
  for( int i = lid; i < 4 * 24; i += 64 )
  {
    const int k = i / 24, s = i % 24;
    if( ( av & ( 1 << k ) ) == 0 )
    {
      continue;
    }
    int v;
    if( s < 16 )
    {
      v = mcSample( jb, o + OBMC_I_NB + k * MC_JOB, 0, sx + ( s & 3 ), sy + ( s >> 2 ), 4, 4, bd, clipMin, clipMax, -1 );
    }
    else
    {
      const int c = s - 16, comp = 1 + c / 4;
      v = mcSample( jb, o + OBMC_I_NB + k * MC_JOB, comp, ( sx >> 1 ) + ( c & 1 ), ( sy >> 1 ) + ( ( c >> 1 ) & 1 ), 2, 2, bd,
                    clipMin, clipMax, -1 );
    }
    od.v[dst + 1 + i] = int16_t( v );
  }
}

void main()
{
  const int lid = int( gl_LocalInvocationID.x );
  for( int j = int( gl_WorkGroupID.x ); j < pc.numJobs; j += int( gl_NumWorkGroups.x ) )
  {
    if( pc.mode == 1 )
    {
      bdofJob( BufI32( pc.jobs ), j * MC_JOB, lid );
      continue;
    }
    if( pc.mode == 2 )
    {
      dmvrJob( j * MC_JOB );
      continue;
    }
    if( pc.mode == 3 )
    {
      obmcJob( j * OBMC_J, lid );
      continue;
    }
    if( pc.mode == 4 )
    {
      obmcInnerJob( j * OBMC_I, lid );
      continue;
    }
    BufI32    jb   = BufI32( pc.jobs );
    const int o    = j * MC_JOB;
    const int comp = jb.v[o + MC_COMP], bx = jb.v[o + MC_X], by = jb.v[o + MC_Y], W = jb.v[o + MC_W], H = jb.v[o + MC_H];
    const int dst = jb.v[o + MC_DST], bd = jb.v[o + MC_BD];
    for( int i = lid; i < W * H; i += 64 )
    {
      const int v = mcSample( jb, o, comp, bx + i % W, by + i / W, jb.v[o + MC_PU_W], jb.v[o + MC_PU_H], bd,
                              jb.v[o + MC_CLIP_MIN], jb.v[o + MC_CLIP_MAX], -1 );
      BufI16( pc.outPred ).v[dst + i] = int16_t( v );
    }
  }
}
